      <Item class="ModuleScript">
        <Properties>
          <string name="Name">GeneratorVisuals</string>
          <ProtectedString name="Source">-- Generator presentation only. Objective ownership and minigame rules stay server-side.
local Generator={}
local gray=Color3.fromRGB(72,83,87)
local steel=Color3.fromRGB(130,140,139)
local amber=Color3.fromRGB(194,145,56)
function Generator.build(parent,position,World,id)
 local model=Instance.new("Model");model.Name="GeneradorDetallado_"..id;model.Parent=parent
 local base=World.part(model,"Generador "..id,Vector3.new(5,4,3),position+Vector3.new(0,2,0),gray)
 base.Transparency=1
 local function part(name,size,offset,tint,shape,rotation)
  local p=World.part(model,name,size,position+offset,tint or gray,Enum.Material.Metal)
  p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=size.Magnitude&gt;1
  if shape then p.Shape=shape end
  if rotation then p.CFrame=p.CFrame*rotation end
  return p
 end
 part("Bancada",Vector3.new(5,.35,3.2),Vector3.new(0,.35,0),gray)
 for _,x in ipairs({-2.15,2.15}) do
  for _,z in ipairs({-1.25,1.25}) do
   part("Soporte tubular",Vector3.new(3.2,.16,.16),Vector3.new(x,1.9,z),steel,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
   part("Aislador de goma",Vector3.new(.5,.35,.5),Vector3.new(x,.1,z),Color3.fromRGB(27,29,29))
  end
  part("Asa superior",Vector3.new(2.5,.16,.16),Vector3.new(x,3.5,0),steel,Enum.PartType.Cylinder,CFrame.Angles(0,math.pi/2,0))
 end
 part("Motor fundido",Vector3.new(2.9,1.65,1.65),Vector3.new(-.4,1.45,0),gray,Enum.PartType.Cylinder)
 for i=1,6 do part("Aleta de refrigeración",Vector3.new(.08,1.85,1.85),Vector3.new(-1.7+i*.38,1.45,0),steel,Enum.PartType.Cylinder) end
 local rotor=part("Rotor",Vector3.new(.25,1.45,1.45),Vector3.new(1.3,1.45,0),amber,Enum.PartType.Cylinder)
 part("Depósito combustible",Vector3.new(2.8,1,1.2),Vector3.new(-.4,2.9,.2),Color3.fromRGB(115,80,49),Enum.PartType.Cylinder)
 part("Tapón",Vector3.new(.2,.45,.45),Vector3.new(-.4,3.46,.2),steel,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
 local exhaust=part("Escape",Vector3.new(1.6,.24,.24),Vector3.new(1.7,2.8,.6),steel,Enum.PartType.Cylinder,CFrame.Angles(0,0,math.pi/2))
 local smoke=Instance.new("Smoke");smoke.Name="HumoSuave";smoke.Enabled=false;smoke.Opacity=.07;smoke.Size=1.2;smoke.RiseVelocity=2;smoke.Parent=exhaust
 part("Consola",Vector3.new(3.7,1.6,.28),Vector3.new(0,2,-1.55),Color3.fromRGB(35,45,48))
 local screen=part("Panel generador "..id,Vector3.new(2.1,.7,.05),Vector3.new(-.58,2.3,-1.73),Color3.fromRGB(184,65,54))
 screen.Material=Enum.Material.Neon
 local label=World.label(screen,"G"..id.." · SIN ENERGÍA")
 local light=Instance.new("PointLight");light.Color=screen.Color;light.Range=8;light.Brightness=.3;light.Shadows=false;light.Parent=screen
 local switches={}
 for i=1,4 do
  local x=-1.35+(i-1)*.6
  part("Zócalo interruptor",Vector3.new(.38,.36,.1),Vector3.new(x,1.7,-1.76),steel)
  switches[i]=part("Interruptor "..i,Vector3.new(.12,.3,.14),Vector3.new(x,1.7,-1.84),amber)
 end
 local colors={Color3.fromRGB(197,65,58),Color3.fromRGB(65,126,193),Color3.fromRGB(210,176,65)}
 for i=1,3 do
  local a=Instance.new("Attachment");a.Position=Vector3.new(-1.5+i*.55,-.65,-1.75);a.Parent=base
  local b=Instance.new("Attachment");b.Position=Vector3.new(-1.3+i*.55,-1.35,-.9);b.Parent=base
  local cable=Instance.new("Beam");cable.Name="Cable curvo "..i;cable.Attachment0=a;cable.Attachment1=b
  cable.Width0=.065;cable.Width1=.065;cable.CurveSize0=.3;cable.CurveSize1=.25;cable.FaceCamera=true;cable.Segments=6;cable.Color=ColorSequence.new(colors[i]);cable.Parent=base
 end
 local grip=part("Tirador de arranque",Vector3.new(.65,.16,.18),Vector3.new(1.65,1.8,-1.75),Color3.fromRGB(40,43,40))
 model:SetAttribute("Running",false);model:SetAttribute("RepairStage",1)
 game:GetService("CollectionService"):AddTag(model,"ForgottenGenerator")
 return {model=model,base=base,screen=screen,label=label,switches=switches,rotor=rotor,grip=grip,smoke=smoke,light=light}
end
function Generator.progress(view,stage,challenge)
 if view.challenge~=challenge then view.challenge=challenge;view.pulls=0 end
 view.model:SetAttribute("RepairStage",stage)
 view.label.Text=({"CONECTA LOS CABLES","AJUSTA LOS INTERRUPTORES","TIRA DEL ARRANQUE"})[stage]
 if challenge.current then
  for i,p in ipairs(view.switches) do p.CFrame=CFrame.new(p.Position)*CFrame.Angles(challenge.current[i] and -.5 or .5,0,0);p.Color=challenge.current[i] and Color3.fromRGB(82,177,127) or amber end
 end
 if challenge.pulls and challenge.pulls&gt;(view.pulls or 0) then view.model:SetAttribute("PullAt",workspace:GetServerTimeNow());view.pulls=challenge.pulls end
end
function Generator.complete(view)
 view.model:SetAttribute("Running",true);view.smoke.Enabled=true;view.light.Color=Color3.fromRGB(82,177,127)
end
function Generator.animate()
 local Collection=game:GetService("CollectionService");local Run=game:GetService("RunService");local models={}
 local function add(model)
  task.defer(function()
   local rotor=model:WaitForChild("Rotor",10);local grip=model:WaitForChild("Tirador de arranque",10)
   if model.Parent and rotor and grip then models[model]={rotor=rotor,rotorFrame=rotor.CFrame,grip=grip,gripFrame=grip.CFrame} end
  end)
 end
 Collection:GetInstanceAddedSignal("ForgottenGenerator"):Connect(add)
 Collection:GetInstanceRemovedSignal("ForgottenGenerator"):Connect(function(m)models[m]=nil end)
 for _,model in ipairs(Collection:GetTagged("ForgottenGenerator")) do add(model) end
 Run.RenderStepped:Connect(function()
  local now=workspace:GetServerTimeNow()
  for model,data in pairs(models) do
   if model.Parent and data.rotor.Parent then
    if model:GetAttribute("Running") then data.rotor.CFrame=data.rotorFrame*CFrame.Angles(now*8,0,0) end
    local elapsed=now-(model:GetAttribute("PullAt") or -100)
    data.grip.CFrame=data.gripFrame*CFrame.new(0,0,elapsed&gt;=0 and elapsed&lt;.4 and -math.sin(elapsed/.4*math.pi)*.65 or 0)
   end
  end
 end)
end
return Generator
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ImportedAppearance</string>
          <ProtectedString name="Source">-- Optional imported mesh templates. Missing templates keep the existing appearance.
-- Studio installer: tools/InstallReferenceCharacter.luau. No external asset IDs guessed.
local Imported={}
local targets={Head="Head_mesh",Torso="Torso_mesh",LeftArm="LeftArm_mesh",RightArm="RightArm_mesh",LeftLeg="LeftLeg_mesh",RightLeg="RightLeg_mesh"}
function Imported.apply(character,id,anchored)
 local templates=game:GetService("ServerStorage"):FindFirstChild("ReferenceCharacters")
 local template=templates and templates:FindFirstChild(id)
 -- Older "yellowguy" mesh exports were robots. They must never replace the classic avatar.
 if id=="yellowguy" and template and template:GetAttribute("CharacterIdentity")~="yellowguy" then return false end
 if not template or template:GetAttribute("ReferenceFormat")~=1 then return false end
 local h=character:FindFirstChildOfClass("Humanoid")
 if h and h.RigType~=Enum.HumanoidRigType.R6 then return false end
 local bindings={}
 local meshPrefix=template:GetAttribute("ReferenceMeshPrefix") or id
 for name,meshName in pairs(targets) do
  local source=template:FindFirstChild(meshPrefix.."__"..meshName,true) or template:FindFirstChild(meshName,true)
  local target=character:FindFirstChild(name) or character:FindFirstChild(name:gsub("Left","Left "):gsub("Right","Right "))
  if source then
   if not source:IsA("BasePart") or not target or not target:IsA("BasePart") then return false end
   table.insert(bindings,{source=source,target=target})
  else return false end
 end
 local scale=template:GetAttribute("ReferenceScale") or 1
 if typeof(scale)~="number" or scale&lt;=0 or scale&gt;10 then return false end
 local old=character:FindFirstChild("ForgottenAppearance");if old then old:Destroy() end
 local folder=Instance.new("Folder");folder.Name="ForgottenAppearance";folder.Parent=character
 for _,body in ipairs(character:GetChildren()) do
  if body:IsA("BasePart") and body.Name~="HumanoidRootPart" then body.Transparency=1 end
 end
 for _,b in ipairs(bindings) do
  local piece=b.source:Clone()
  local offset=b.source:GetPivot():ToObjectSpace(b.source.CFrame)
  piece.Size=piece.Size*scale
  piece.CFrame=b.target.CFrame*CFrame.new(offset.Position*scale)*offset.Rotation
  piece.Anchored=anchored;piece.CanCollide=false;piece.CanTouch=false;piece.Massless=true;piece.Parent=folder
  if not anchored then local weld=Instance.new("WeldConstraint");weld.Part0=b.target;weld.Part1=piece;weld.Parent=piece end
 end
 return true
end
return Imported
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ItemConfig</string>
          <ProtectedString name="Source">return {slots=2,medkit={name="Medkit",duration=7},energyDrink={name="Energy Drink",duration=6,speedMultiplier=1.35,provisionalSpeedIII=true}}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Lobby</string>
          <ProtectedString name="Source">-- Cabaña original de Forgotten inspirada en las referencias del autor.
-- Geometría detallada y materiales nativos; mapas PBR originales opcionales en assets/textures.
return function(world, roster, remote, variants, createNPCs)
 variants=variants or {}
 local lobby=Instance.new("Model")
 lobby.Name="CabanaDelUltimoRefugio";lobby.Parent=world
 local C={wood=Color3.fromRGB(86,61,44),trim=Color3.fromRGB(44,33,28),floor=Color3.fromRGB(121,88,59),stone=Color3.fromRGB(102,100,91),cream=Color3.fromRGB(194,174,140),green=Color3.fromRGB(48,68,59),gold=Color3.fromRGB(168,124,59)}
 local function part(name,size,pos,color,material,rotation)
  local p=Instance.new("Part")
  p.Name=name;p.Size=size;p.CFrame=CFrame.new(pos)*(rotation or CFrame.new())
  p.Color=color;p.Material=material or Enum.Material.Wood
  p.Anchored=true;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p.Parent=lobby
  if p.Material==Enum.Material.Wood then p.Material=Enum.Material.WoodPlanks end
  if p.Material==Enum.Material.Metal then p.Reflectance=.12 end
  if variants[p.Material] then p.MaterialVariant=variants[p.Material] end
  return p
 end
 local function decor(p) p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;return p end
 local function text(p,words,face)
  local gui=Instance.new("SurfaceGui");gui.Face=face or Enum.NormalId.Front;gui.CanvasSize=Vector2.new(600,300);gui.Parent=p
  local t=Instance.new("TextLabel");t.Size=UDim2.fromScale(1,1);t.BackgroundTransparency=1
  t.Text=words;t.TextColor3=C.cream;t.Font=Enum.Font.Garamond;t.TextScaled=true;t.TextWrapped=true;t.Parent=gui
 end
 local function lamp(pos,pendant)
  if pendant then decor(part("Cadena de farol",Vector3.new(.15,5,.15),pos+Vector3.new(0,3,0),C.trim,Enum.Material.Metal)) end
  local glow=decor(part("Luz ambar",Vector3.new(1.1,1.4,1.1),pos,Color3.fromRGB(255,204,129),Enum.Material.Neon))
  local l=Instance.new("PointLight");l.Color=Color3.fromRGB(255,204,149);l.Brightness=1.2;l.Range=23;l.Shadows=true;l.Parent=glow
  for _,dy in {-0.85,.85} do decor(part("Marco de farol",Vector3.new(1.5,.25,1.5),pos+Vector3.new(0,dy,0),C.trim,Enum.Material.Metal)) end
 end
 local function rail(a,b)
  local length=(b-a).Magnitude
  local center=(a+b)/2
  local orientation=CFrame.lookAt(center,b)
  local top=part("Pasamanos",Vector3.new(.45,.45,length),center+Vector3.new(0,3.5,0),C.trim)
  top.CFrame=CFrame.new(top.Position)*orientation.Rotation
  local n=math.max(1,math.floor(length/2.5))
  for i=0,n do part("Barrote",Vector3.new(.3,3.5,.3),a:Lerp(b,i/n)+Vector3.new(0,1.7,0),C.cream) end
 end
 -- Sala de doble altura y entramado de madera.
 part("Base",Vector3.new(180,2,180),Vector3.new(0,-2,0),Color3.fromRGB(29,43,34),Enum.Material.Grass)
 part("Suelo estructural",Vector3.new(84,1,72),Vector3.new(0,0,0),C.floor)
 for x=-40,40,4 do
  for j=0,5 do
   local z=-30+j*12
   local plank=part("Tablon de roble",Vector3.new(3.94,.12,11.92),Vector3.new(x,.56,z),C.floor:Lerp(C.trim,((x+40)/4+j*3)%7/40),Enum.Material.WoodPlanks)
   for _,dz in {-5.4,5.4} do
    for _,dx in {-1.4,1.4} do decor(part("Clavo enrasado",Vector3.new(.085,.025,.085),Vector3.new(x+dx,.64,z+dz),C.trim,Enum.Material.Metal)) end
   end
  end
 end
 -- Troncos apilados. Fachada con puerta y huecos acristalados.
 for y=1.5,31.5,2 do
  part("Tronco trasero",Vector3.new(84,1.95,1.5),Vector3.new(0,y,36),C.wood,Enum.Material.WoodPlanks)
  for _,x in {-42,42} do part("Tronco lateral",Vector3.new(1.5,1.95,72),Vector3.new(x,y,0),C.wood,Enum.Material.WoodPlanks) end
