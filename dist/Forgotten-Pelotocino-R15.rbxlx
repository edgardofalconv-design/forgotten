 -- NPC distribuidos con espacio para hablar y circular.
 if createNPCs~=false then
 local positions={Vector3.new(7,0,30),Vector3.new(33,0,-16),Vector3.new(-15,0,-10),Vector3.new(-14,0,10),Vector3.new(12,16.5,30),Vector3.new(29,0,24)}
 for i,entry in ipairs(roster) do
  local origin=positions[i]
  local npc=Instance.new("Model");npc.Name=entry.name;npc.Parent=lobby
  local function body(name,size,offset,color)
   local p=part(name,size,origin+offset,color,Enum.Material.SmoothPlastic);p.Parent=npc;return p
  end
  body("Torso",Vector3.new(2.2,2.4,1.2),Vector3.new(0,3.5,0),entry.color)
  local head=body("Head",Vector3.new(1.5,1.5,1.5),Vector3.new(0,5.5,0),C.cream)
  for _,side in {-1,1} do
   body(side&lt;0 and "LeftLeg" or "RightLeg",Vector3.new(.9,2,1),Vector3.new(side*.6,1.3,0),C.trim)
   body(side&lt;0 and "LeftArm" or "RightArm",Vector3.new(.7,2.3,1),Vector3.new(side*1.5,3.5,0),entry.color)
   local eye=body("Ojo",Vector3.new(.12,.16,.1),Vector3.new(side*.3,5.6,-.8),C.trim);eye.CanCollide=false
  end
  local pp=Instance.new("ProximityPrompt");pp.ActionText="Escuchar historia";pp.ObjectText=entry.name;pp.MaxActivationDistance=8;pp.Parent=head
  pp.Triggered:Connect(function(p) remote:FireClient(p,"message",entry.name..(entry.confirmedLore and "\n" or " [historia provisional]\n")..entry.lore) end)
  local sign=decor(part("Modelo provisional",Vector3.new(5,1,.1),origin+Vector3.new(0,7.5,0),C.trim))
  text(sign,entry.name.." · PROVISIONAL")
 end
 local cosmetics=require(script.Parent.Appearance)
 for _,npc in ipairs(lobby:GetChildren()) do
  for _,entry in ipairs(roster) do
   if npc.Name==entry.name then
    for _,child in ipairs(npc:GetChildren()) do if child.Name=="Ojo" then child:Destroy() end end
    cosmetics.apply(npc,entry.id,true)
   end
  end
 end
 end
 local spawn=Instance.new("SpawnLocation")
 spawn.Name="Refugio";spawn.Position=Vector3.new(0,1,-25);spawn.Size=Vector3.new(6,1,6)
 spawn.Neutral=true;spawn.Anchored=true;spawn.Transparency=1;spawn.CanCollide=false;spawn.Parent=lobby
 return lobby
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">MapCatalog</string>
          <ProtectedString name="Source">return {
 {id="disaster_island",name="Disaster Island",theme="island",description="Costa, muelles, faro, radio y cuatro sectores exteriores."},
 {id="pizza_place",name="Abandoned Pizza Place",theme="pizza",description="Cocinas, hornos, cumpleaños, reparto y rutas de servicio."},
 {id="forgotten_heights",name="Forgotten Heights",theme="heights",description="Ocho edificios, nuevas cubiertas, oficinas y rutas perimetrales."},
 {id="research_facility",name="Zombie Research Facility",theme="lab",description="Laboratorios, aislamiento, banco de muestras y turbinas."},
 {id="cursed_manor",name="Cursed Manor",theme="manor",description="Bibliotecas, invernadero, sala de música y cocheras."},
 {id="forgotten_robloxia",name="Forgotten Robloxia",theme="town",description="Barrio, lavandería, taller, terminal y almacén vecinal."},
 {id="junkbot_factory",name="Junkbot Factory",theme="factory",description="Montaje, mantenimiento, bobinas y control industrial."},
 {id="corrupted_arcade",name="Corrupted Arcade",theme="arcade",description="Arcades, sala LAN, premios, servidores y reparaciones."},
 {id="ballers_arena",name="Baller's Arena",theme="arena",description="Cancha, gimnasio, enfermería, tienda y entrenamiento."},
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">MaterialPack</string>
          <ProtectedString name="Source">-- Mapas originales en assets/textures. Subir las imágenes a Roblox y rellenar IDs.
-- Con campos vacíos el juego utiliza los materiales texturizados nativos.
local pack={
 {name="ForgottenOak",base=Enum.Material.WoodPlanks,prefix="oak",color="",normal="",roughness="",studs=6},
 {name="ForgottenStone",base=Enum.Material.Cobblestone,prefix="limestone",color="",normal="",roughness="",studs=5},
 {name="ForgottenWoven",base=Enum.Material.Fabric,prefix="woven",color="",normal="",roughness="",studs=2},
 {name="ForgottenBrass",base=Enum.Material.Metal,prefix="aged_brass",color="",normal="",roughness="",studs=3},
}
return function()
 local service=game:GetService("MaterialService")
 local enabled={}
 for _,entry in ipairs(pack) do
  if entry.color:match("^rbxassetid://%d+$") and entry.normal:match("^rbxassetid://%d+$") and entry.roughness:match("^rbxassetid://%d+$") then
   local variant=service:FindFirstChild(entry.name)
   if not variant then variant=Instance.new("MaterialVariant");variant.Name=entry.name;variant.Parent=service end
   variant.BaseMaterial=entry.base;variant.ColorMap=entry.color
   variant.NormalMap=entry.normal;variant.RoughnessMap=entry.roughness
   variant.StudsPerTile=entry.studs;enabled[entry.base]=entry.name
  end
 end
 return enabled
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Music</string>
          <ProtectedString name="Source">-- Usa únicamente IDs de audio publicados con permiso para esta experiencia.
-- Cadenas vacías: música pendiente, sin intentar cargar recursos ficticios.
return {
 lmsDuration = 90,
 lobby = {title="Everything Is Fine",soundId=""},
 exit = {title="Escape the Forgotten",soundId=""},
 baconLMS = {title="LMS Pelotocino contra Tubers93",soundId="",duration=90},
 sfx={skill="",hit="",footstep="",objective="",item="",ui="",results="",reward=""},
 guestChase={title="Persecución de Guest 666",layers={
  {distance=100,soundId="",title="Presencia"},{distance=65,soundId="",title="Amenaza"},
  {distance=35,soundId="",title="Peligro"},{distance=18,soundId="",title="Persecución"}}},
 lastHope = {title="Last Hope 2.1",soundId="",duration=90,bpm=165},
 brokenFriendship = {title="Broken Friendship",soundId="",duration=90,bpm=160},
 shadowReaper = {
  title="Shadow Reaper",bpm=165,duration=168,
  -- Cuatro clips independientes y en bucle, NO posiciones de un único audio.
  layers={
   {distance=100,soundId="",title="Presencia"},
   {distance=65,soundId="",title="Amenaza"},
   {distance=35,soundId="",title="Peligro"},
   {distance=18,soundId="",title="Full Chase"},
  },
 },
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">NativeRoundCharacter</string>
          <ProtectedString name="Source">-- Preserve complete R6/R15 rigs and restore the player's own lobby avatar.
local Storage = game:GetService("ServerStorage")
local Native = {}
local saved = {}
local expected = setmetatable({}, {__mode = "k"})
local restored = setmetatable({}, {__mode = "k"})

function Native.consumeSwap(player, character)
 if expected[character] ~= player then return false end
 expected[character] = nil
 return true
end

function Native.isRestoredAvatar(character)
 return character ~= nil and restored[character] == true
end

function Native.equip(player, model, id, displayName, speed)
 local original = player.Character
 local oldHumanoid = original and original:FindFirstChildOfClass("Humanoid")
 local humanoid = model and model:FindFirstChildOfClass("Humanoid")
 local root = model and model:FindFirstChild("HumanoidRootPart")
 if saved[player] or not oldHumanoid or oldHumanoid.Health &lt;= 0 or not humanoid or not root then
  if model then model:Destroy() end
  return false
 end
 if humanoid.RigType ~= Enum.HumanoidRigType.R15 and humanoid.RigType ~= Enum.HumanoidRigType.R6 then model:Destroy(); return false end
 -- Round rigs use BasicAnimation, independently of the player's avatar animation pack.
 for _, part in ipairs(model:GetDescendants()) do
  if part:IsA("BasePart") then part.Anchored = false end
 end
 humanoid.DisplayName = displayName or id
 humanoid.MaxHealth = 100
 humanoid.Health = 100
 humanoid.WalkSpeed = speed or 16
 model.Name = player.Name
 model:PivotTo(original:GetPivot())
 saved[player] = {original = original, round = model, parent = original.Parent}
 expected[model] = player
 original.Parent = Storage
 model.Parent = workspace
 player.Character = model
 player:SetAttribute("CharacterId", id)
 return true
end

function Native.restore(player)
 local record = saved[player]
 if not record then return false end
 saved[player] = nil
 if player.Character == record.round and record.original.Parent then
  local h = record.original:FindFirstChildOfClass("Humanoid")
  if h then h.Health = h.MaxHealth;h:SetAttribute("SpeedEffect",nil) end
  restored[record.original] = true
  expected[record.original] = player
  record.original.Parent = record.parent or workspace
  player.Character = record.original
  record.round:Destroy()
 else
  record.original:Destroy()
  if player.Character ~= record.round then record.round:Destroy() end
 end
 player:SetAttribute("CharacterId", nil)
 return true
end

function Native.discard(player)
 local record = saved[player]
 if not record then return end
 saved[player] = nil
 expected[record.original] = nil
 expected[record.round] = nil
 if player.Character ~= record.original then record.original:Destroy() end
 if player.Character ~= record.round then record.round:Destroy() end
end

return Native
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
