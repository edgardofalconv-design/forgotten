      <Item class="ModuleScript">
        <Properties>
          <string name="Name">FutureRoster</string>
          <ProtectedString name="Source">-- Preserved for a future update; not registered in selection or role assignment.
return {
 {id="baller",name="Baller",role="Superviviente",color=Color3.fromRGB(220,65,55),skill="Impacto: frena al asesino cercano",cooldown=16,lore="Conserva una pelota como recuerdo del último día normal. Ahora la usa para ganar tiempo."},
