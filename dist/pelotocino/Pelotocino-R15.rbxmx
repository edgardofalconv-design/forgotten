      <Item class="ModuleScript" referent="RBX_P_72">
        <Properties>
          <string name="Name">PelotocinoMotion</string>
          <ProtectedString name="Source">-- Original R15 motion. Positive arm X reaches forward (-Z); no copied clips.
local Motion={durations={pan=.72,baconThrow=1.15,detector=1.6}}
local function p(x,y,z,tx,ty,tz)return {x or 0,y or 0,z or 0,tx or 0,ty or 0,tz or 0}end
local function smooth(t)t=math.clamp(t,0,1);return t*t*(3-2*t)end
local clips={
 pan={
 {0,{RightShoulder=p(.1),RightElbow=p(.12)}},
 {.12,{RightShoulder=p(.25,-.8,.65),RightElbow=p(.65),Waist=p(0,-.32),LeftShoulder=p(.4,0,-.25)}},
 {.22,{RightShoulder=p(1.45,.2,-.1),RightElbow=p(.12),RightWrist=p(0,0,.12),Waist=p(-.08,.25)}},
 {.37,{RightShoulder=p(1.2,.65,-.5),RightElbow=p(.25),Waist=p(-.08,.4)}},
 {.72,{RightShoulder=p(.1),RightElbow=p(.12)}}},
 baconThrow={
 {0,{LeftShoulder=p(.1),RightShoulder=p(.1)}},
 {.12,{LeftShoulder=p(2.55,0,.55),LeftElbow=p(.75),Neck=p(.12,-.1),RightShoulder=p(.2,-.4,.45)}},
 {.24,{LeftShoulder=p(1.55,0,.40),LeftElbow=p(.25),LeftWrist=p(0,0,-.3),RightShoulder=p(.3,-.75,.65),RightElbow=p(.7),Waist=p(0,-.3)}},
 {.36,{LeftShoulder=p(1.2,.1,.35),LeftElbow=p(.12),RightShoulder=p(.75,-.55,.35),RightElbow=p(.45),Waist=p(-.05,-.15)}},
 {.45,{LeftShoulder=p(.8,0,-.7),LeftElbow=p(.4),RightShoulder=p(1.5,.18,-.12),RightElbow=p(.08),Waist=p(-.08,.28)}},
 {.62,{LeftShoulder=p(.4,0,-.3),RightShoulder=p(1.4,.7,-.45),RightElbow=p(.18),Waist=p(-.05,.38)}},
 {1.15,{LeftShoulder=p(.05),RightShoulder=p(.05),LeftElbow=p(.12),RightElbow=p(.12),Waist=p()}}},
 detector={
 {0,{LeftShoulder=p(.1)}},
 {.23,{LeftShoulder=p(.3,0,-.12),LeftElbow=p(.6),Neck=p(.12)}},
 {.5,{LeftShoulder=p(.85,0,-.15),LeftElbow=p(.85),LeftWrist=p(.1,0,.2),Neck=p(.25),RightShoulder=p(.7,0,.3),RightElbow=p(.9)}},
 {.8,{LeftShoulder=p(.85,0,-.15),LeftElbow=p(.85),Neck=p(.18),RightShoulder=p(.65,0,.3),RightElbow=p(.8)}},
 {1.15,{LeftShoulder=p(.85,0,-.15),LeftElbow=p(.85),Neck=p(.16,.14)}},
 {1.6,{LeftShoulder=p(.1),LeftElbow=p(.12),Neck=p()}}}}
local function keyframes(frames,t)
 local a,b=frames[1],frames[#frames]
 for i=2,#frames do if t&lt;=frames[i][1] then a,b=frames[i-1],frames[i];break end end
 local f=smooth((t-a[1])/math.max(.001,b[1]-a[1]));local result={}
 for _,frame in ipairs({a,b})do for key in pairs(frame[2])do
  if not result[key]then local x,y=a[2][key] or p(),b[2][key] or p();local out={}
   for i=1,6 do out[i]=x[i]+(y[i]-x[i])*f end;result[key]=out
  end
 end end
 return result
end
function Motion.sample(state,phase,speed,action,elapsed,context)
 context=context or {};local run=state=="run" or state=="sprint";local moving=run or state=="walk"
 local a=moving and (run and .80 or .48) or 0;local wave=math.sin(phase);local stride=wave*a
 local pose={RootJoint=p(run and -.14 or 0,0,moving and wave*.025 or math.sin(phase*.3)*.012,0,moving and math.abs(math.sin(phase))*.045 or math.sin(phase*.65)*.018),
 Waist=p(run and -.07 or 0,moving and wave*.055 or math.sin(phase*.2)*.025),Neck=p(run and .09 or math.sin(phase*.4)*.015,0),
 LeftShoulder=p(-stride,0,-.035),RightShoulder=p(stride,0,.035),LeftElbow=p(run and .85 or .18),RightElbow=p(run and .85 or .18),LeftWrist=p(),RightWrist=p(),
 LeftHip=p(stride),RightHip=p(-stride),LeftKnee=p(-math.max(0,-wave)*(run and .95 or .35)),RightKnee=p(-math.max(0,wave)*(run and .95 or .35)),LeftAnkle=p(-stride*.25),RightAnkle=p(stride*.25)}
 if not moving then pose.LeftShoulder[1]=math.sin(phase*.65)*.025;pose.RightShoulder[1]=-pose.LeftShoulder[1] end
 if state=="jump"then pose.LeftHip=p(.3);pose.RightHip=p(-.25);pose.LeftShoulder=p(.65,0,-.25);pose.RightShoulder=p(.65,0,.25);pose.LeftKnee=p(-.6);pose.RightKnee=p(-.3)
 elseif state=="fall"then pose.LeftShoulder=p(.2,0,-.7);pose.RightShoulder=p(.2,0,.7);pose.LeftKnee=p(-.3);pose.RightKnee=p(-.3)
 elseif state=="hit"then pose.RootJoint=p(.17,0,.08);pose.Waist=p(.15);pose.Neck=p(-.18);pose.LeftShoulder=p(.4,0,-.2);pose.RightShoulder=p(.35,0,.2)
 elseif state=="stun"then pose.RootJoint=p(-.24,0,math.sin(phase)*.04);pose.Neck=p(.23)
 elseif state=="land"then local f=1-smooth((context.stateTime or 0)/.28);pose.RootJoint=p(-.12*f,0,0,0,-.12*f);pose.LeftKnee=p(-.35*f);pose.RightKnee=p(-.35*f)
 elseif state=="death"then local f=smooth((context.stateTime or 0)/.9);pose.RootJoint=p(.1*f,0,-1.3*f,0,-.6*f);return pose
 elseif state=="repairGenerator"or state=="medkit"then pose.LeftShoulder=p(.75,0,-.25);pose.RightShoulder=p(.8+math.sin(phase*1.5)*.12,0,.2);pose.LeftElbow=p(.7);pose.RightElbow=p(.55);pose.Neck=p(.18)
 elseif state=="drink"then pose.RightShoulder=p(1.3);pose.RightElbow=p(1.2);pose.Neck=p(-.12) end
 local frames=clips[action];local duration=Motion.durations[action]
 if state~="hit"and state~="stun"and frames and elapsed&gt;=0 and elapsed&lt;duration then
  local weight=math.min(smooth(elapsed/.06),smooth((duration-elapsed)/.08))
  for key,value in pairs(keyframes(frames,elapsed))do
   local base=pose[key] or p();for i=1,6 do value[i]=base[i]+(value[i]-base[i])*weight end;pose[key]=value
  end
 elseif action=="luckyBacon"and elapsed&gt;=0 and elapsed&lt;.9 then pose.LeftShoulder=p(1.5);pose.LeftElbow=p(.8) end
 return pose
end
-- Render/equipment timing uses exactly the server's unchanged .45 s release.
function Motion.equipment(action,t)
 local throwing=action=="baconThrow"and t&gt;=0 and t&lt;1.15
 return {pan=(action=="pan"and t&gt;=0 and t&lt;.72)or throwing,
  tracker=action=="detector"and t&gt;=0 and t&lt;1.6,
  tuftRemoved=throwing and t&gt;=.12 and t&lt;1.02,tuftInHand=throwing and t&gt;=.12 and t&lt;.36,
  tuftTossed=throwing and t&gt;=.36 and t&lt;.45}
end
return Motion
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_P_73">
        <Properties>
          <string name="Name">PelotocinoRenderer</string>
          <ProtectedString name="Source">-- Shared appearance for the playable rig, lobby NPC and preview. Actual MeshParts.
-- No visual Part/Wedge fallback: unavailable mesh APIs produce an explicit notice.
local Assets=game:GetService("AssetService")
local RS=game:GetService("ReplicatedStorage")
local Data=require(script.Parent.PelotocinoMeshData)
local Surface=require(script.Parent.PelotocinoSurface)
local Motion=require(script.Parent.PelotocinoMotion)
local Renderer={};local cache={};local inFlight={};local states=setmetatable({},{__mode="k"});local reveal
local function vec(v)return Vector3.new(v[1],v[2],v[3])end
local function bounds(spec)
 local lo,hi=Vector3.new(math.huge,math.huge,math.huge),Vector3.new(-math.huge,-math.huge,-math.huge)
 for _,v in ipairs(spec.vertices)do local p=vec(v);lo=Vector3.new(math.min(lo.X,p.X),math.min(lo.Y,p.Y),math.min(lo.Z,p.Z));hi=Vector3.new(math.max(hi.X,p.X),math.max(hi.Y,p.Y),math.max(hi.Z,p.Z)) end
 return (lo+hi)/2,Vector3.new(math.max(.002,hi.X-lo.X),math.max(.002,hi.Y-lo.Y),math.max(.002,hi.Z-lo.Z))
end
local function template(index)
 if cache[index]then return cache[index]end
 while inFlight[index]do task.wait()end
 if cache[index]then return cache[index]end
 inFlight[index]=true
 local spec=Data.meshes[index];local center,size=bounds(spec);local editable
 local ok,result=pcall(function()
  local imported=RS:FindFirstChild("PelotocinoImportedMeshes")
  local source=imported and imported:FindFirstChild(spec.name,true)
  local part
  if source and source:IsA("MeshPart")then part=source:Clone();part.Size=size
  else
   editable=Assets:CreateEditableMesh();assert(editable,"No hay memoria para la malla")
   local vertices,normals,colors,uvs={},{},{},{}
   for i,v in ipairs(spec.vertices)do
    vertices[i]=editable:AddVertex(vec(v)-center)
    uvs[i]=editable:AddUV(Vector2.new(.5+v[1]*.32,.5+v[2]*.32))
    normals[i]=editable:AddNormal(vec(spec.normals[i]))
    local c=spec.colors[i];colors[i]=editable:AddColor(Color3.fromRGB(c[1],c[2],c[3]),1)
   end
   for _,face in ipairs(spec.faces)do
    local a,b,c=face[1]+1,face[2]+1,face[3]+1
    local f=editable:AddTriangle(vertices[a],vertices[b],vertices[c]);editable:SetFaceNormals(f,{normals[a],normals[b],normals[c]});editable:SetFaceColors(f,{colors[a],colors[b],colors[c]});editable:SetFaceUVs(f,{uvs[a],uvs[b],uvs[c]})
   end
   part=Assets:CreateMeshPartAsync(Content.fromObject(editable),{CollisionFidelity=Enum.CollisionFidelity.Box})
   part.Size=size;part.Color=Color3.new(1,1,1);part.Material=Enum.Material[spec.material]
   if spec.material=="Fabric"then Surface.apply(part,spec.group=="backpack")end
   if spec.group=="hair"or spec.group=="tuft"then Surface.applyHair(part)end
  end
  part.Name=spec.name;part.Anchored=false;part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.DoubleSided=true
  return {part=part,center=center,editable=editable}
 end)
 inFlight[index]=nil
 if not ok then if editable then editable:Destroy()end;error(result)end
 cache[index]=result;return result
end
local function notice(model,message)
 local head=model:FindFirstChild("Head");if not head then return end
 local gui=Instance.new("BillboardGui");gui.Name="PelotocinoMeshNotice";gui.Size=UDim2.fromOffset(260,74);gui.StudsOffset=Vector3.new(0,2,0);gui.AlwaysOnTop=true;gui.Parent=head
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundColor3=Color3.fromRGB(23,28,35);text.BackgroundTransparency=.15;text.TextColor3=Color3.fromRGB(255,210,150);text.TextSize=13;text.TextWrapped=true;text.Text=message;text.Parent=gui
end
function Renderer.apply(model)
 if not model:GetAttribute("PelotocinoR15")or states[model]then return end
 local old=model:FindFirstChild("PelotocinoMeshAppearance");if old then old:Destroy()end
 local state={parts={},loading=true};states[model]=state
 local folder=Instance.new("Folder");folder.Name="PelotocinoMeshAppearance";folder.Parent=model;state.folder=folder
 local ok,problem=pcall(function()
  for index,spec in ipairs(Data.meshes)do
   local source=template(index);if not model.Parent then return end
   local anchor=model:FindFirstChild(spec.anchor);assert(anchor,"Falta hueso R15: "..spec.anchor)
   local part=source.part:Clone();part.CFrame=anchor.CFrame*CFrame.new(source.center);part.Parent=folder
   local motor=Instance.new("Motor6D");motor.Name="MeshMount_"..index;motor.Part0=anchor;motor.Part1=part;motor.C0=CFrame.new(source.center);motor.Parent=part
   table.insert(state.parts,{part=part,motor=motor,center=source.center,spec=spec})
  end
 end)
 state.loading=false
 if not ok then
  folder:Destroy();state.failed=true
  model:SetAttribute("PelotocinoVisualReady",false)
  notice(model,"PELOTOCINO · MALLAS NO DISPONIBLES\nActiva Mesh &amp; Image APIs o instala el FBX incluido.")
  warn("Pelotocino R15: no se reemplaza por cubos. "..tostring(problem));return
 end
 if not model.Parent then return end
 local labelHost=model.LeftHand
 local oldReadout=labelHost:FindFirstChild("TrackerReadout");if oldReadout then oldReadout:Destroy()end
 local oldNotice=model.Head:FindFirstChild("PelotocinoMeshNotice");if oldNotice then oldNotice:Destroy()end
 local gui=Instance.new("BillboardGui");gui.Name="TrackerReadout";gui.Size=UDim2.fromOffset(110,28);gui.StudsOffset=Vector3.new(0,.4,0);gui.AlwaysOnTop=false;gui.Enabled=false;gui.Parent=labelHost
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundColor3=Color3.fromRGB(8,21,14);text.BackgroundTransparency=.12;text.TextColor3=Color3.fromRGB(136,231,157);text.TextSize=11;text.Text="SIN SEÑAL";text.Parent=gui
 state.readout=gui;state.readoutText=text;model:SetAttribute("PelotocinoVisualReady",true)
 -- Viewport clones also start with equipment stowed, before their first animation tick.
 Renderer.update(model,"",100)
end
function Renderer.setReveal(data)
 reveal={models=data.models or {},untilTime=os.clock()+math.min(data.duration or 6,10)}
end
local function mount(item,anchor,frame)
 item.motor.Part0=anchor;item.motor.C0=frame*CFrame.new(item.center)
end
function Renderer.update(model,action,elapsed)
 local state=states[model];if not state or state.loading or state.failed then return end
 local pose=Motion.equipment(action,elapsed)
 for _,item in ipairs(state.parts)do
  local spec=item.spec
  if spec.group=="pan"then
   mount(item,pose.pan and model.RightHand or model.UpperTorso,pose.pan and CFrame.new(0,-.08,0)or CFrame.new(.65,-.25,.93)*CFrame.Angles(0,.2,-.22))
  elseif spec.group=="tracker"then
   mount(item,pose.tracker and model.LeftHand or model.UpperTorso,pose.tracker and CFrame.new(0,-.10,-.16)*CFrame.Angles(.1,0,0)or CFrame.new(-.69,-.28,.36))
  elseif spec.group=="tuft"then
   item.part.Transparency=pose.tuftRemoved and 1 or 0
   if pose.tuftInHand then
    item.part.Transparency=0;mount(item,model.LeftHand,CFrame.new(0,-.08,-.16)*CFrame.Angles(0,0,.2)*CFrame.new(.15,-.4,.2))
   elseif pose.tuftTossed then
    item.part.Transparency=0
    local f=math.clamp((elapsed-.36)/.09,0,1)
    local from=model.LeftHand.CFrame*CFrame.new(0,-.08,-.16)
    local to=model.RightHand.CFrame*CFrame.new(0,-.82,-.15)
    mount(item,model.HumanoidRootPart,model.HumanoidRootPart.CFrame:ToObjectSpace(from:Lerp(to,f))*CFrame.new(.15,-.4,.2))
   else mount(item,model.Head,CFrame.new())end
  end
 end
 if state.readout then
  state.readout.Enabled=pose.tracker
  local detected=(model:GetAttribute("TrackerUntil")or 0)&gt;workspace:GetServerTimeNow()and(model:GetAttribute("TrackerCount")or 0)&gt;0
  local text=detected and "● SEÑAL DETECTADA"or "SIN SEÑAL"
  local player=game:GetService("Players").LocalPlayer
  if player and player.Character==model and reveal and os.clock()&lt;reveal.untilTime then
   local root=model.HumanoidRootPart;local nearest,distance
   for _,target in ipairs(reveal.models)do local r=target and target:FindFirstChild("HumanoidRootPart")
    if r and target.Parent then local d=(r.Position-root.Position).Magnitude;if not distance or d&lt;distance then nearest,distance=r,d end end
   end
   if nearest and distance&lt;=100 then
    local d=root.CFrame:VectorToObjectSpace(nearest.Position-root.Position)
    text=(math.abs(d.X)&gt;math.abs(d.Z)and(d.X&gt;0 and "→ DERECHA"or"← IZQUIERDA")or(d.Z&lt;0 and "↑ DELANTE"or"↓ DETRÁS")).." · SEÑAL"
   end
  end
  for _,item in ipairs(state.parts)do if item.spec.group=="tracker"and item.spec.material=="Neon"then
   local intensity=detected and (.85+.15*math.sin(os.clock()*9))or .3;item.part.Color=Color3.new(intensity,intensity,intensity)
  end end
  state.readoutText.Text=text
  state.readoutText.TextColor3=detected and Color3.fromRGB(135,255,151)or Color3.fromRGB(160,174,159)
 end
end
function Renderer.projectile(parent)
 local model=Instance.new("Model");model.Name="BaconTuftProjectile"
 for index,spec in ipairs(Data.meshes)do if spec.group=="tuft"then
  local source=template(index);local part=source.part:Clone();part.Anchored=true;part.CFrame=CFrame.new();part.Parent=model;model.PrimaryPart=part;break
 end end
 model.Parent=parent;return model
end
function Renderer.start()
 local collection=game:GetService("CollectionService")
 local function add(model)if model:GetAttribute("PelotocinoR15")then task.defer(function()Renderer.apply(model)end)end end
 collection:GetInstanceAddedSignal("ForgottenAnimated"):Connect(add)
 for _,m in ipairs(collection:GetTagged("ForgottenAnimated"))do add(m)end
end
return Renderer
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_P_74">
        <Properties>
          <string name="Name">PelotocinoSurface</string>
          <ProtectedString name="Source">-- Small authored weave/leather maps, generated locally. No external texture IDs.
local Assets=game:GetService("AssetService")
local Surface={};local cache={};local retained={}
local function sample(x,y,leather)
 local noise=math.sin(x*12.9898+y*78.233)*43758.5453;noise=noise-math.floor(noise)
 if leather then return math.floor(219+noise*29)end
 return math.floor(218+noise*12+((x+y)%4&lt;2 and 20 or 0))
end
function Surface.apply(part,leather)
 local key=leather and "leather"or"weave"
 if cache[key]==false then return end
 if not cache[key]then
  local ok,result=pcall(function()
   local size=128
   local image=Assets:CreateEditableImage({Size=Vector2.new(size,size)});assert(image,"Imagen no disponible")
   local pixels=buffer.create(size*size*4)
   for y=0,size-1 do for x=0,size-1 do
    local i=(y*size+x)*4;local c=sample(x,y,leather)
    buffer.writeu8(pixels,i,c);buffer.writeu8(pixels,i+1,c);buffer.writeu8(pixels,i+2,c);buffer.writeu8(pixels,i+3,255)
   end end
   image:WritePixelsBuffer(Vector2.new(0,0),Vector2.new(size,size),pixels)
   local appearance=Assets:CreateSurfaceAppearanceAsync({ColorMap=Content.fromObject(image)})
   table.insert(retained,image);return appearance
  end)
  cache[key]=ok and result or false
 end
 if cache[key]then cache[key]:Clone().Parent=part end
end
function Surface.applyHair(part)
 if cache.hair==false then return end
 if not cache.hair then
  local ok,result=pcall(function()
   local image=Assets:CreateEditableImage({Size=Vector2.new(8,8)});assert(image)
   local pixels=buffer.create(8*8*4)
   for i=0,63 do buffer.writeu8(pixels,i*4,166);buffer.writeu8(pixels,i*4+1,166);buffer.writeu8(pixels,i*4+2,166);buffer.writeu8(pixels,i*4+3,255)end
   image:WritePixelsBuffer(Vector2.new(0,0),Vector2.new(8,8),pixels)
   local surface=Assets:CreateSurfaceAppearanceAsync({RoughnessMap=Content.fromObject(image)})
   table.insert(retained,image);return surface
  end)
  cache.hair=ok and result or false
 end
 if cache.hair then cache.hair:Clone().Parent=part end
end
return Surface
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_P_75">
        <Properties>
          <string name="Name">PelotocinoRig</string>
          <ProtectedString name="Source">-- R15 skeleton and shared authored appearance contract. The visible body is MeshParts.
-- Native Roblox APIs are used when Studio is available; no external IDs are guessed.
local Players=game:GetService("Players")
local Data=require(script.Parent.PelotocinoMeshData)
local Rig={}
local nativeTemplate
local attempted=false
local function vec(v)return Vector3.new(v[1],v[2],v[3])end
function Rig.create()
 local model
 if not attempted then
  attempted=true
  local ok,result=pcall(function()
   local description=Instance.new("HumanoidDescription")
   description.WidthScale=.75;description.DepthScale=.85;description.HeightScale=.95
   return Players:CreateHumanoidModelFromDescriptionAsync(description,Enum.HumanoidRigType.R15)
  end)
  if ok and result then nativeTemplate=result;nativeTemplate.Parent=nil end
 end
 if nativeTemplate then model=nativeTemplate:Clone() else model=Instance.new("Model") end
 model.Name="pelotocino"
 -- Normalize native joint positions to the authored R15 dimensions. Invisible
 -- physics bodies do not draw the visible character or a cube fallback.
 for _,node in ipairs(model:GetDescendants())do
  if node:IsA("Motor6D") or node:IsA("Accessory") or node:IsA("Script") or node:IsA("LocalScript") or node:IsA("Decal") or node:IsA("SpecialMesh") then node:Destroy() end
 end
 for name,position in pairs(Data.anchors)do
  local part=model:FindFirstChild(name)
  if not part then part=Instance.new("Part");part.Name=name;part.Parent=model end
  part.Size=name=="HumanoidRootPart" and Vector3.new(1.4,2,.75) or name=="Head" and Vector3.new(1.3,1.18,1.06)
   or name=="UpperTorso" and Vector3.new(1.25,1.10,.68) or name=="LowerTorso" and Vector3.new(1.1,.55,.64)
   or name:find("Foot") and Vector3.new(.65,.44,.98) or name:find("Hand") and Vector3.new(.45,.45,.40)
   or name:find("Arm") and Vector3.new(.5,.7,.5) or Vector3.new(.60,.9,.65)
  part.CFrame=CFrame.new(vec(position));part.Transparency=1;part.CanCollide=name=="UpperTorso" or name=="LowerTorso"
  part.CanTouch=name=="HumanoidRootPart";part.CanQuery=true;part.Anchored=false;part.CastShadow=false;part.Massless=name~="HumanoidRootPart"
  for _,a in ipairs(part:GetChildren())do if a:IsA("Attachment") then a:Destroy() end end
 end
 local h=model:FindFirstChildOfClass("Humanoid") or Instance.new("Humanoid")
 h.Name="Humanoid";h.RigType=Enum.HumanoidRigType.R15;h.AutomaticScalingEnabled=false
 h.HipHeight=Data.hipHeight;h.MaxHealth=100;h.Health=100;h.WalkSpeed=16;h.BreakJointsOnDeath=false;h.Parent=model
 for _,joint in ipairs(Data.joints)do
  local name,p0,p1,point=joint[1],model[joint[2]],model[joint[3]],vec(joint[4])
  local a=Instance.new("Attachment");a.Name=name.."RigAttachment";a.Position=point-p0.Position;a.Parent=p0
  local b=Instance.new("Attachment");b.Name=a.Name;b.Position=point-p1.Position;b.Parent=p1
  local motor=Instance.new("Motor6D");motor.Name=name;motor.Part0=p0;motor.Part1=p1
  motor.C0=CFrame.new(a.Position);motor.C1=CFrame.new(b.Position);motor.Parent=p0
 end
 for name,partName in pairs({RightGripAttachment="RightHand",LeftGripAttachment="LeftHand",HairAttachment="Head",BodyBackAttachment="UpperTorso"})do
  local a=Instance.new("Attachment");a.Name=name;a.Parent=model[partName]
 end
 local release=Instance.new("Attachment");release.Name="BaconRelease";release.Position=Vector3.new(0,-.82,-.15);release.Parent=model.RightHand
 if not h:FindFirstChildOfClass("Animator")then Instance.new("Animator").Parent=h end
 model.PrimaryPart=model.HumanoidRootPart
 model:SetAttribute("CharacterIdentity","pelotocino");model:SetAttribute("PelotocinoR15",true)
 model:SetAttribute("NativeAvatarRig",nativeTemplate~=nil);model:SetAttribute("Placeholder",false)
 model:SetAttribute("ModelStatus","Pelotocino R15 · mallas propias · prueba de Studio pendiente")
 return model
end
return Rig
</ProtectedString>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="RBX_P_76">
      <Properties>
        <string name="Name">PelotocinoAnimate</string>
        <token name="RunContext">2</token>
        <ProtectedString name="Source">-- Client RunContext Script: works for an inserted NPC without other FORGOTTEN scripts.
local model=script.Parent
local package=model:WaitForChild("PelotocinoPackage")
local Motion=require(package.PelotocinoMotion)
local Renderer=require(package.PelotocinoRenderer)
Renderer.apply(model)
local joints={}
for _,part in ipairs(model:GetDescendants())do if part:IsA("Motor6D")then joints[part.Name=="Root"and"RootJoint"or part.Name]=part end end
local phase=0;local connection
connection=game:GetService("RunService").PreSimulation:Connect(function(dt)
 if not model.Parent then connection:Disconnect();return end
 local now=workspace:GetServerTimeNow();local root=model:FindFirstChild("HumanoidRootPart");local h=model:FindFirstChildOfClass("Humanoid")
 if not root or not h then return end
 local velocity=root.AssemblyLinearVelocity;local speed=Vector3.new(velocity.X,0,velocity.Z).Magnitude
 local state=h.Health&lt;=0 and"death"or h.FloorMaterial==Enum.Material.Air and not root.Anchored and"fall"or speed&gt;18 and"run"or speed&gt;.7 and"walk"or"idle"
 if (model:GetAttribute("DemoUntil")or 0)&gt;now then state=model:GetAttribute("DemoState")or state end
 phase=phase+dt*(state=="run"and 9 or state=="walk"and 6 or 2)
 local action=model:GetAttribute("Action")or"";local elapsed=now-(model:GetAttribute("ActionAt")or -100)
 local pose=Motion.sample(state,phase,speed,action,elapsed,{stateTime=0})
 for name,joint in pairs(joints)do local v=pose[name]
  if v then
   local target=CFrame.new(v[4],v[5],v[6])*CFrame.Angles(v[1],v[2],v[3])
   joint.Transform=(Motion.durations[action] and elapsed&gt;=0 and elapsed&lt;Motion.durations[action])and target or joint.Transform:Lerp(target,1-math.exp(-dt*19))
  end
 end
 Renderer.update(model,action,elapsed)
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_P_77">
      <Properties>
        <string name="Name">PelotocinoPreview</string>
        <token name="RunContext">1</token>
        <ProtectedString name="Source">-- Preview-only prompt. Combat remains authoritative in the full FORGOTTEN test place.
local model=script.Parent;local root=model:WaitForChild("HumanoidRootPart")
if not model:GetAttribute("NPC")then return end
local prompt=Instance.new("ProximityPrompt");prompt.Name="PreviewAnimation";prompt.ActionText="Ver animación";prompt.ObjectText="Pelotocino R15 · vista previa";prompt.HoldDuration=.2;prompt.MaxActivationDistance=10;prompt.Parent=root
local states={"idle","walk","run","pan","baconThrow","detector","hit"};local index=0;local cooldown=0
prompt.Triggered:Connect(function(player)
 local now=workspace:GetServerTimeNow();local r=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 if now&lt;cooldown or not r or(r.Position-root.Position).Magnitude&gt;12 then return end
 cooldown=now+1.7;index=index%#states+1;local key=states[index]
 local action=key=="pan"or key=="baconThrow"or key=="detector"
 model:SetAttribute("Action",action and key or"");model:SetAttribute("ActionAt",now)
 model:SetAttribute("DemoState",action and"idle"or key);model:SetAttribute("DemoUntil",now+1.7)
 prompt.ActionText="Animación: "..key
end)
</ProtectedString>
      </Properties>
    </Item>
    <Item class="Folder" referent="RBX_P_78">
      <Properties>
        <string name="Name">AnimSaves</string>
      </Properties>
      <Item class="KeyframeSequence" referent="RBX_P_79">
        <Properties>
          <string name="Name">idle</string>
          <bool name="Loop">true</bool>
          <token name="Priority">0</token>
        </Properties>
        <Item class="Keyframe" referent="RBX_P_80">
          <Properties>
            <string name="Name">Keyframe</string>
            <float name="Time">0.0</float>
          </Properties>
          <Item class="Pose" referent="RBX_P_81">
            <Properties>
              <string name="Name">HumanoidRootPart</string>
              <float name="Weight">0</float>
            </Properties>
            <Item class="Pose" referent="RBX_P_82">
              <Properties>
                <string name="Name">LowerTorso</string>
                <CoordinateFrame name="CFrame">
                  <X>0</X>
                  <Y>0.0</Y>
                  <Z>0</Z>
