      <Item class="ModuleScript">
        <Properties>
          <string name="Name">RoundRules</string>
          <ProtectedString name="Source">-- Engine-independent, authoritative rules. No remotes or geometry here.
local Rules = {}
Rules.__index = Rules
Rules.Duration = 240
Rules.LMSDuration = 90
Rules.GeneratorCount = 4
Rules.PuzzleCount = 4
Rules.RequiredGenerators = 2
Rules.RequiredCapsules = 3

function Rules.new(practice)
 return setmetatable({remaining=Rules.Duration, mode=practice and "Practica" or "Normal",
  generators={}, puzzles={}, collected={}, deposited={}, generatorCount=0, puzzleCount=0,
  capsuleCount=0, gateOpen=false, expired=false, lmsStarted=false}, Rules)
end

function Rules:refreshGate()
 if self.mode == "LMS" then
  self.gateOpen = self.remaining &lt;= 0
 elseif self.remaining &lt;= 60 and self.generatorCount &gt;= Rules.RequiredGenerators
  and self.capsuleCount &gt;= Rules.RequiredCapsules then
  self.gateOpen = true
 end
end

local function validId(id, count)
 return type(id)=="number" and id%1==0 and id&gt;=1 and id&lt;=count
end

function Rules:completeGenerator(id)
 if self.expired or not validId(id,4) or self.generators[id] then return false end
 self.generators[id]=true
 self.generatorCount=self.generatorCount+1
 if self.mode~="LMS" then self.remaining=math.max(0,self.remaining-10) end
 self:refreshGate()
 return true
end

function Rules:completePuzzle(id)
 if self.expired or not validId(id,4) or self.puzzles[id] then return false end
 self.puzzles[id]=true
 self.puzzleCount=self.puzzleCount+1
 if self.mode~="LMS" then self.remaining=math.max(0,self.remaining-5) end
 self:refreshGate()
 return true
end

function Rules:collectCapsule(id,carrier)
 if self.expired or self.mode=="LMS" or not self.puzzles[id] or self.collected[id] or self.deposited[id] or carrier==nil then return false end
 self.collected[id]=carrier
 return true
end

function Rules:depositCapsules(carrier)
 local deposited={}
 if self.expired or self.mode=="LMS" then return deposited end
 for id,owner in pairs(self.collected) do
  if owner==carrier and not self.deposited[id] then
   self.deposited[id]=true;self.capsuleCount=self.capsuleCount+1;table.insert(deposited,id)
  end
 end
 self:refreshGate()
 return deposited
end

function Rules:dropCapsules(carrier)
 local dropped={}
 for id,owner in pairs(self.collected) do
  if owner==carrier and not self.deposited[id] then self.collected[id]=nil;table.insert(dropped,id) end
 end
 return dropped
end

function Rules:carried(carrier)
 local count=0
 for id,owner in pairs(self.collected) do if owner==carrier and not self.deposited[id] then count=count+1 end end
 return count
end

function Rules:updateSurvivors(alive)
 -- Practice is an explicit Studio-only mode; it does not simulate an opponent.
 if self.mode=="Practica" or self.lmsStarted or alive~=1 then return false end
 self.lmsStarted=true
 self.mode="LMS"
 self.remaining=Rules.LMSDuration -- exactly 1:30, even if the previous clock was lower
 self.expired=false
 self:refreshGate()
 return true
end

function Rules:tick(dt)
 if self.expired then return end
 self.remaining=math.max(0,self.remaining-math.max(0,dt))
 self:refreshGate()
 -- LMS waits at 0:00 for a physical escape or elimination, never an automatic win.
 if self.mode~="LMS" and self.remaining&lt;=0 then self.expired=true end
end

function Rules:canEscape(isActiveSurvivor, physicallyAcross)
 return isActiveSurvivor and physicallyAcross and self.gateOpen and not self.expired
end

return Rules
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <ProtectedString name="Source">local items={}
local names={pelotocino="Pelotocino",yellowguy="Yellow Guy",junkbot="Junkbot",deathspeaker="Korblox Deathspeaker",guest666="Guest 666",tubers93="Tubers93"}
local order={"pelotocino","yellowguy","junkbot","deathspeaker","guest666","tubers93"}
for _,id in ipairs(order) do
 table.insert(items,{id="character:"..id,name=names[id],kind="character",character=id,price=0,included=true})
 table.insert(items,{id=id..":base",name="Principal · "..names[id],kind="skin",character=id,tier=0,price=0,included=true})
 for tier=1,4 do table.insert(items,{id=id..":m"..tier,name="Milestone "..tier.." · "..names[id],kind="skin",character=id,tier=tier,mastery=true,provisional=true}) end
end
for _,item in ipairs({
 {id="cosmetic:scarf",name="Bufanda del refugio",kind="cosmetic",price=50,style="scarf",featured=true},
 {id="cosmetic:lantern",name="Linterna del explorador",kind="cosmetic",price=80,style="lantern",featured=true},
 {id="cosmetic:badge",name="Insignia del campamento",kind="cosmetic",price=35,style="badge"},
 {id="cosmetic:radio",name="Radio de recuerdo",kind="cosmetic",price=65,style="radio"}
}) do table.insert(items,item) end
return items
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Stamina</string>
          <ProtectedString name="Source">local Stamina = {}
Stamina.Maximum=100
Stamina.Drain=20
Stamina.Regen=16
Stamina.Restart=25

function Stamina.new()
 return {value=100, requested=false, exhausted=false, running=false}
end

function Stamina.step(state,dt,moving,infinite)
 if infinite then state.value=100;state.exhausted=false;state.running=state.requested and moving;return state.value,state.running end
 dt=math.max(0,math.min(dt,0.5))
 state.running=state.requested and moving and not state.exhausted and state.value&gt;0
 if state.running then state.value=math.max(0,state.value-Stamina.Drain*dt)
 else state.value=math.min(Stamina.Maximum,state.value+Stamina.Regen*dt) end
 if state.value&lt;=0 then state.exhausted=true;state.running=false
 elseif state.value&gt;=Stamina.Restart then state.exhausted=false end
 return state.value,state.running
end

return Stamina
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">VisualGeometry</string>
          <ProtectedString name="Source">-- Portable authored mesh surfaces: native spheres/cylinders and triangular wedges.
-- This fallback needs no uploaded MeshIds, HTTP or EditableMesh permission.
local Geometry={}
local function vec(t)return Vector3.new(t[1],t[2],t[3])end
local function finish(part,parent,anchor,name,color,material,localFrame,visibility)
 part.Name=name;part.Color=Color3.fromRGB(color[1],color[2],color[3]);part.Material=Enum.Material[material or "SmoothPlastic"]
 part.CFrame=anchor.CFrame*localFrame;part.Anchored=false;part.Massless=true
 part.CanCollide=false;part.CanTouch=false;part.CanQuery=false
 part.CastShadow=part.Size.X*part.Size.Y*part.Size.Z&gt;.12
 part.TopSurface=Enum.SurfaceType.Smooth;part.BottomSurface=Enum.SurfaceType.Smooth
 if visibility then part:SetAttribute("VisibilityAction",visibility);part.Transparency=1 end
 part.Parent=parent
 local weld=Instance.new("WeldConstraint");weld.Part0=anchor;weld.Part1=part;weld.Parent=part
 return part
end
local function triangle(a,b,c,parent,anchor,spec)
 local ab,ac,bc=b-a,c-a,c-b
 if ab:Dot(ab)&gt;ac:Dot(ac) and ab:Dot(ab)&gt;bc:Dot(bc) then c,a=a,c
 elseif ac:Dot(ac)&gt;bc:Dot(bc) and ac:Dot(ac)&gt;ab:Dot(ab) then a,b=b,a end
 ab,ac,bc=b-a,c-a,c-b
 local normal=ab:Cross(ac)
 if normal.Magnitude&lt;.00001 or bc.Magnitude&lt;.00001 then return end
 local right=normal.Unit;local back=bc.Unit;local up=bc:Cross(right).Unit
 local height=math.abs(ab:Dot(up))
 local function wedge(length,position,r,u,z)
  if length&lt;.0001 or height&lt;.0001 then return end
  local part=Instance.new("WedgePart");part.Size=Vector3.new(.012,height,length)
  finish(part,parent,anchor,spec.name,spec.color,spec.material,CFrame.fromMatrix(position,r,u,z),spec.visibility)
 end
 wedge(math.abs(ab:Dot(back)),(a+b)/2,right,up,back)
 wedge(math.abs(ac:Dot(back)),(a+c)/2,-right,up,-back)
end
function Geometry.build(parent,anchor,spec)
 local folder=Instance.new("Folder");folder.Name=spec.name;folder.Parent=parent
 if spec.kind=="RoundedBlock" then
  local size=vec(spec.size);local r=math.min(spec.radius or .08,size.X/3,size.Y/3,size.Z/3)
  local center=vec(spec.position)
  local function piece(shape,dimensions,position,rotation)
   local part=Instance.new("Part");part.Size=dimensions;part.Shape=shape
   finish(part,folder,anchor,spec.name,spec.color,spec.material,CFrame.new(center+position)*(rotation or CFrame.new()),spec.visibility)
  end
  piece(Enum.PartType.Block,Vector3.new(size.X-2*r,size.Y-2*r,size.Z),Vector3.new())
  piece(Enum.PartType.Block,Vector3.new(size.X-2*r,size.Y,size.Z-2*r),Vector3.new())
  piece(Enum.PartType.Block,Vector3.new(size.X,size.Y-2*r,size.Z-2*r),Vector3.new())
  local x,y,z=size.X/2-r,size.Y/2-r,size.Z/2-r
  for _,a in ipairs({-1,1}) do for _,b in ipairs({-1,1}) do
   piece(Enum.PartType.Cylinder,Vector3.new(size.X-2*r,2*r,2*r),Vector3.new(0,a*y,b*z))
   piece(Enum.PartType.Cylinder,Vector3.new(size.Y-2*r,2*r,2*r),Vector3.new(a*x,0,b*z),CFrame.Angles(0,0,math.pi/2))
   piece(Enum.PartType.Cylinder,Vector3.new(size.Z-2*r,2*r,2*r),Vector3.new(a*x,b*y,0),CFrame.Angles(0,math.pi/2,0))
   for _,c in ipairs({-1,1}) do piece(Enum.PartType.Ball,Vector3.new(2*r,2*r,2*r),Vector3.new(a*x,b*y,c*z)) end
  end end
 elseif spec.kind=="Mesh" then
  for _,face in ipairs(spec.faces) do triangle(vec(spec.vertices[face[1]+1]),vec(spec.vertices[face[2]+1]),vec(spec.vertices[face[3]+1]),folder,anchor,spec) end
 else
  local part=Instance.new(spec.kind=="Wedge" and "WedgePart" or "Part")
  local cf
  if spec.kind=="Segment" then
   local a,b=vec(spec.start),vec(spec["end"]);local delta=b-a
   part.Shape=Enum.PartType.Cylinder;part.Size=Vector3.new(delta.Magnitude,spec.radius*2,spec.radius*2)
   cf=CFrame.lookAt((a+b)/2,b)*CFrame.Angles(0,math.pi/2,0)
  else
   local size=vec(spec.size);part.Size=size
   if spec.kind=="Sphere" then part.Shape=Enum.PartType.Ball
   elseif spec.kind=="Cylinder" then part.Shape=Enum.PartType.Cylinder;part.Size=Vector3.new(size.Y,size.X,size.Z) end
   local angles=spec.rotation or {0,0,0}
   cf=CFrame.new(vec(spec.position))*CFrame.Angles(math.rad(angles[1]),math.rad(angles[2]),math.rad(angles[3]))
  end
  finish(part,folder,anchor,spec.name,spec.color,spec.material,cf,spec.visibility)
  if spec.label then
   local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(512,256);gui.Parent=part
   local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Font=Enum.Font.GothamBold
   text.Text=spec.label;text.TextColor3=Color3.fromRGB(229,229,220);text.TextScaled=true;text.Parent=gui
  end
 end
 return folder
end
return Geometry
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script">
      <Properties>
        <string name="Name">Game</string>
        <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local roster=require(RS.Shared.Roster)
local Rules=require(RS.Shared.RoundRules)
local Assignment=require(RS.Shared.RoleAssignment)
local Stamina=require(RS.Shared.Stamina)
local Factory=require(RS.Shared.CharacterFactory)
local Catalog=require(RS.Shared.CatalogCharacter)
local AvatarCatalog=require(RS.Shared.AvatarCatalog)
local Native=require(RS.Shared.NativeRoundCharacter)
local World=require(script.World)
local Objectives=require(script.Objectives)
local Abilities=require(script.Abilities)
local RoundItems=require(script.RoundItems)
local Profiles=require(script.ProfileService)
local Cosmetics=require(RS.Shared.Cosmetics)
local EconomyConfig=require(RS.Shared.EconomyConfig)
local MapCatalog=require(RS.Shared.MapCatalog)
local mapById={};for _,map in ipairs(MapCatalog) do mapById[map.id]=map end
local byId={}
for _,entry in ipairs(roster) do byId[entry.id]=entry end
local remote=RS:FindFirstChild("GameEvent") or Instance.new("RemoteEvent")
remote.Name="GameEvent";remote.Parent=RS
local world=World.build(roster,remote)
local phase,remaining,roundId="Lobby",15,0
local selected,participants,lastKiller,born,limits={},{},{},{},{}
local rules,objectives,items,abilities
local profiles
local mapVotes,selectionTouched={},{}
local resultsData
local killerUserId,musicKey,result=0,"",""
local practiceRequested=false
local practice=false
local function send(player,kind,data)
 if player.Parent==Players then remote:FireClient(player,kind,data) end
end
profiles=Profiles.new(send)
local function body(player)
 local character=player.Character
 return character and character:FindFirstChild("HumanoidRootPart"),character and character:FindFirstChildOfClass("Humanoid")
end
local function entryFor(player)
 return participants[player] and participants[player].entry or byId[selected[player] or "pelotocino"]
end
local function playing(player)
 local record=participants[player]
 local root,h=body(player)
 return phase=="Ronda" and player.Parent==Players and record and record.status=="Jugando" and root and h and h.Health&gt;0
end
local function snapshot()
 local scoreboard={}
 for player,record in pairs(participants) do if player.Parent==Players then
  table.insert(scoreboard,{userId=player.UserId,name=player.DisplayName,character=record.entry.id,status=record.status,score=record.objectives*100+math.floor(record.damage),role=record.entry.role})
 end end
 table.sort(scoreboard,function(a,b)return a.userId&lt;b.userId end)
 return {phase=phase,remaining=math.ceil(rules and phase=="Ronda" and rules.remaining or remaining),
  mode=rules and rules.mode or "Normal",roundId=roundId,generators=rules and rules.generatorCount or 0,
  capsules=rules and rules.capsuleCount or 0,puzzles=rules and rules.puzzleCount or 0,
  gateOpen=rules and rules.gateOpen or false,killerUserId=killerUserId,musicKey=musicKey,result=result,
  mapId=world.mapId,mapName=world.mapName,results=resultsData,scoreboard=scoreboard,
  canPractice=RunService:IsStudio() and #Players:GetPlayers()==1 and phase=="Lobby"}
end
local function broadcast() remote:FireAllClients("state",snapshot()) end
local function changed()
 if rules then world.setGate(rules.gateOpen,rules.mode) end
 broadcast()
end
local function canInteract(player,part)
 if not playing(player) or entryFor(player).role~="Superviviente" then return false end
 if (participants[player].holdUntil or 0)&gt;os.clock() then return false end
 local root=body(player)
 if (root.Position-part.Position).Magnitude&gt;12 then return false end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={player.Character}
 local hit=workspace:Raycast(root.Position,part.Position-root.Position,params)
 return not hit or hit.Instance==part
end
local function inExit(player)
 local root=body(player)
 if not root then return false end
 local localPos=world.exit.CFrame:PointToObjectSpace(root.Position)
 return math.abs(localPos.X)&lt;=world.exit.Size.X/2 and math.abs(localPos.Y)&lt;=world.exit.Size.Y/2+1
  and math.abs(localPos.Z)&lt;=world.exit.Size.Z/2 and root.Position.Z&gt;world.gate.Position.Z+2
end
local function returnToLobby(player)
 Native.restore(player)
 player:SetAttribute("InRound",false);player:SetAttribute("CharacterId",nil)
 player:SetAttribute("Energy",100);player:SetAttribute("SkillCooldown",0)
 local root,h=body(player)
 if root and h and h.Health&gt;0 then Factory.place(player.Character,world.lobbyPosition) end
end
local function tryEscape(player)
 if not rules or not playing(player) then return end
 local record=participants[player]
 if rules:canEscape(record.entry.role=="Superviviente",inExit(player)) then
  record.status="Escapó";record.energy.requested=false
  if objectives then objectives:drop(player) end
  if not practice then profiles:reward(player,profiles.owner..":"..roundId..":escape:"..player.UserId,"escape",record.entry.id) end
  send(player,"message","¡Escapaste atravesando la salida! Espera la siguiente ronda en el campamento.")
  returnToLobby(player)
  player:SetAttribute("RoundStatus","Escapó")
  changed()
 end
end
local exitConnection
local function connectExit()
 if exitConnection then exitConnection:Disconnect() end
 exitConnection=world.exit.Touched:Connect(function(hit)
  local model=hit:FindFirstAncestorOfClass("Model")
  local player=model and Players:GetPlayerFromCharacter(model)
  if player then tryEscape(player) end
 end)
end
connectExit()
local function aliveCounts()
 local survivors,killers,escaped=0,0,0
 local last
 for player,record in pairs(participants) do
  if record.status=="Escapó" then escaped=escaped+1 end
  if playing(player) then
   if record.entry.role=="Asesino" then killers=killers+1 else survivors=survivors+1;last=player end
  end
 end
 return survivors,killers,escaped,last
end
local function updateLMS()
 if not rules then return end
 local survivors,_,_,last=aliveCounts()
 if rules:updateSurvivors(survivors) then
  local killer=Players:GetPlayerByUserId(killerUserId)
  musicKey="lastHope"
  if killer and last then
   if entryFor(killer).id=="guest666" and entryFor(last).id=="deathspeaker" then musicKey="brokenFriendship"
   elseif entryFor(killer).id=="tubers93" and entryFor(last).id=="pelotocino" then musicKey="baconLMS" end
  end
  if objectives then objectives:disableForLMS() end
  remote:FireAllClients("message","ÚLTIMO SUPERVIVIENTE · 1:30. La salida abre a 0:00; debes atravesarla.")
  changed()
 end
end
local function visible(attacker,target)
 local a=body(attacker);local b=body(target)
 if not a or not b then return false end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={attacker.Character}
 local hit=workspace:Raycast(a.Position,b.Position-a.Position,params)
 return not hit or hit.Instance:IsDescendantOf(target.Character)
end
local context={records=function()return participants end,playing=playing,body=body,visible=visible,
 canInteract=canInteract,send=send,rules=function()return rules end,world=world,
 effect=function(data)remote:FireAllClients("effect",data)end}
abilities=Abilities.new(context)
local function useSkill(player,slot,aim) abilities:cast(player,slot or 1,aim) end
local function attack(player,aim)
 if playing(player) and entryFor(player).role=="Asesino" then abilities:cast(player,1,aim) end
end
remote.OnServerEvent:Connect(function(player,action,value,extra)
 if type(action)~="string" then return end
 -- Server-side rate limit, including puzzle input and character selection.
 local now=os.clock()
 local limit=limits[player] or {at=now,tokens=20}
 limit.tokens=math.min(20,limit.tokens+(now-limit.at)*10);limit.at=now;limits[player]=limit
 if action=="sprint" and value==false then
  if participants[player] then participants[player].energy.requested=false end
  return
 end
 if limit.tokens&lt;1 then return end
 limit.tokens=limit.tokens-1
 if action=="ready" then send(player,"selected",selected[player] or "pelotocino");send(player,"state",snapshot());profiles:publish(player)
 elseif action=="select" then
  if phase~="Lobby" or type(value)~="string" or not byId[value] then return end
  selected[player]=value;selectionTouched[player]=true;profiles:select(player,value);player:SetAttribute("SelectedCharacterId",value);send(player,"selected",value)
 elseif action=="map" then
  if phase=="Lobby" and type(value)=="string" and mapById[value] then mapVotes[player]=value;send(player,"message","Mapa elegido: "..mapById[value].name) end
 elseif action=="buy" then
  if phase=="Lobby" and type(value)=="string" then local _,message=profiles:purchase(player,value);send(player,"message",message) end
 elseif action=="equip" then
  if phase=="Lobby" and type(value)=="string" and type(extra)=="string" then local _,message=profiles:equip(player,value,extra);send(player,"message",message) end
 elseif action=="profile" then profiles:publish(player)
 elseif action=="item" then if items then items:use(player,value) end
 elseif action=="practice" then
  if RunService:IsStudio() and phase=="Lobby" and #Players:GetPlayers()==1 then practiceRequested=true;remaining=3 end
 elseif action=="sprint" then
  if playing(player) and type(value)=="boolean" then participants[player].energy.requested=value end
 elseif action=="skill" then useSkill(player,value,extra)
 elseif action=="attack" then attack(player,value)
 elseif action=="struggle" then abilities:struggle(player,value)
 elseif action=="challenge" then if objectives then objectives:answer(player,value,extra) end
 elseif action=="challengeCancel" then if objectives then objectives:cancel(player) end end
end)
local function addPlayer(player)
 selected[player]="pelotocino"
 player:SetAttribute("SelectedCharacterId","pelotocino");player:SetAttribute("Energy",100)
 player:SetAttribute("InRound",false);player:SetAttribute("RoundStatus","Lobby")
 player.RespawnLocation=world.spawn
 local function spawned(character)
  if Native.consumeSwap(player,character) then return end
  Native.discard(player)
  born[player]=os.clock()
  local record=participants[player]
  if record and record.status=="Jugando" then record.status="Eliminado";record.energy.requested=false end
  player:SetAttribute("CharacterId",nil);player:SetAttribute("InRound",false)
  player:SetAttribute("RoundStatus",phase=="Ronda" and "Espectador" or "Lobby")
  if objectives then objectives:drop(player) end
 end
 player.CharacterAdded:Connect(spawned)
 if player.Character then spawned(player.Character) end
 task.spawn(function()
  profiles:load(player,function(data)
   if phase=="Lobby" and not selectionTouched[player] and byId[data.lastCharacter] then
    selected[player]=data.lastCharacter;player:SetAttribute("SelectedCharacterId",data.lastCharacter);send(player,"selected",data.lastCharacter)
   end
  end)
 end)
end
Players.PlayerAdded:Connect(addPlayer)
for _,player in ipairs(Players:GetPlayers()) do addPlayer(player) end
Players.PlayerRemoving:Connect(function(player)
 if objectives then objectives:drop(player) end
 task.spawn(function()profiles:close(player)end)
 mapVotes[player]=nil;selectionTouched[player]=nil
 if participants[player] then participants[player].status="Abandonó" end
 Native.discard(player);selected[player]=nil;born[player]=nil;limits[player]=nil;lastKiller[player.UserId]=nil
end)
local previews=RS:FindFirstChild("CharacterPreviews") or Instance.new("Folder");previews.Name="CharacterPreviews";previews.Parent=RS
local function refreshPreview(entry)
 local old=previews:FindFirstChild(entry.id);if old then old:Destroy() end
 local model=Factory.create(entry);model.Name=entry.id;model.HumanoidRootPart.Anchored=true;model.Parent=previews
end
for _,entry in ipairs(roster) do refreshPreview(entry) end
local catalogNPCUpdated=false
local function preloadCatalog()
 if Catalog.load() and not catalogNPCUpdated then
  for index,entry in ipairs(roster) do if entry.id=="junkbot" then world.refreshNPC(index);refreshPreview(entry) end end
  catalogNPCUpdated=true
 end
end
task.spawn(preloadCatalog)
local function preloadAvatars()
 if AvatarCatalog.load() then
  for index,entry in ipairs(roster) do
   if entry.id~="junkbot" then world.refreshNPC(index);refreshPreview(entry) end
  end
 end
end
task.spawn(preloadAvatars)
local function candidates()
 local list={}
 for _,player in ipairs(Players:GetPlayers()) do
  local root,h=body(player)
  local ready=player:HasAppearanceLoaded() or Native.isRestoredAvatar(player.Character) or os.clock()-(born[player] or os.clock())&gt;8
  if root and h and h.Health&gt;0 and ready then
   table.insert(list,{key=player.UserId,choice=selected[player],lastKiller=lastKiller[player.UserId] or 0})
  end
 end
 return list
end
local function chooseMap(list)
 local choice=MapCatalog[(roundId%#MapCatalog)+1].id;local votes={};local best=0
 for _,candidate in ipairs(list) do
  local player=Players:GetPlayerByUserId(candidate.key);local id=player and mapVotes[player]
  if id then votes[id]=(votes[id] or 0)+1 end
 end
 for _,map in ipairs(MapCatalog) do if (votes[map.id] or 0)&gt;best then best=votes[map.id];choice=map.id end end
 return choice
end
local function beginRound(list,isPractice)
 world.loadMap(chooseMap(list));connectExit()
 roundId=roundId+1
 local plan,killer=Assignment.assign(list,roster)
 if isPractice then
  local chosen=byId[list[1].choice]
  plan={{key=list[1].key,id=chosen.role=="Superviviente" and chosen.id or "pelotocino"}};killer=0
 end
 if not plan then return false end
 participants={};rules=Rules.new(isPractice);practice=isPractice;killerUserId=killer;musicKey="";result="";resultsData=nil
 abilities.zones={};abilities.pending={};abilities.scheduled={}
 phase="Ronda"
 local survivorIndex=0
 for _,assignment in ipairs(plan) do
  local player=Players:GetPlayerByUserId(assignment.key)
  if player then
   local entry=byId[assignment.id]
   local model=Factory.create(entry)
   local data=profiles:get(player)
   local equipment=data and data.equipped[entry.id] or {skin=entry.id..":base",cosmetic=""}
   Cosmetics.apply(model,entry.id,equipment)
   local status=model:GetAttribute("ModelStatus")
   local display=entry.name..(model:GetAttribute("Placeholder") and " [provisional]" or "")
   if Native.equip(player,model,entry.id,display,entry.role=="Asesino" and 18 or 16) then
    local record={entry=entry,status="Jugando",energy=Stamina.new(),cooldowns={},items={},played=0,objectives=0,damage=0,eliminations=0,equipment=equipment}
    participants[player]=record
    local _,h=body(player)
    record.death=h.Died:Connect(function()
     if participants[player]==record and record.status=="Jugando" then
      record.status="Eliminado";record.energy.requested=false;player:SetAttribute("InRound",false);player:SetAttribute("RoundStatus","Eliminado")
      if objectives then objectives:drop(player) end
      local attacker=record.lastAttacker and participants[record.lastAttacker]
      if attacker and attacker.entry.role=="Asesino" then attacker.eliminations=attacker.eliminations+1 end
     end
    end)
    player:SetAttribute("InRound",true);player:SetAttribute("RoundStatus","Jugando");player:SetAttribute("ModelStatus",status)
    if entry.role=="Asesino" then
     lastKiller[player.UserId]=roundId
     Factory.place(model,world.center+world.killerSpawn)
    else
     survivorIndex=survivorIndex+1
     Factory.place(model,world.center+world.survivorSpawn+Vector3.new(((survivorIndex-1)%12)*7,0,math.floor((survivorIndex-1)/12)*5))
    end
    send(player,"message",(isPractice and "PRÁCTICA INDIVIDUAL: sin asesino ni LMS.\n" or "").."Juegas como "..entry.name.." · "..tostring(status)..(entry.id~=selected[player] and "\nAsignación automática para equilibrar los equipos; tu elección se conserva." or ""))
   end
  end
 end
 objectives=Objectives.new(world,rules,{canInteract=canInteract,send=send,changed=changed,reward=function(player,kind,event)
  local r=participants[player]
  if r then
   r.objectives=r.objectives+1
   send(player,"sfx","objective")
   if not practice then profiles:reward(player,profiles.owner..":"..roundId..":"..event..":"..player.UserId,kind,r.entry.id) end
  end
 end})
 items=RoundItems.new(world,context)
 updateLMS();changed()
 return true
end
local function finishRound(message,ending)
 local survivors,killers,escaped=aliveCounts()
 local killerVictory=not practice and killers&gt;0 and escaped==0 and (ending=="timeout" or ending=="noSurvivors")
 local rows={};local mvp,mvpScore=nil,-1
 for player,record in pairs(participants) do
  local score=record.objectives*100+math.floor(record.damage)+(record.status=="Escapó" and 300 or 0)+record.eliminations*150
  if player.Parent==Players then
   local row={userId=player.UserId,name=player.DisplayName,character=record.entry.id,status=record.status,score=score,equipment=record.equipment,role=record.entry.role}
   table.insert(rows,row)
   if score&gt;mvpScore then mvp=player;mvpScore=score end
   if not practice and record.played&gt;=EconomyConfig.participationSeconds then profiles:reward(player,profiles.owner..":"..roundId..":participation:"..player.UserId,"participation",record.entry.id) end
   if killerVictory and record.entry.role=="Asesino" and playing(player) then
    profiles:reward(player,profiles.owner..":"..roundId..":killerWin:"..player.UserId,"killerWin",record.entry.id)
    row.victory=true
   end
   if record.status=="Jugando" then
    record.status=row.victory and "Victoria" or ending=="killerInactive" and "Interrumpida" or record.entry.role=="Superviviente" and "No escapó" or "Fin de ronda"
    row.status=record.status
   end
  end
 end
 if mvp and not practice and mvpScore&gt;0 then profiles:reward(mvp,profiles.owner..":"..roundId..":mvp:"..mvp.UserId,"mvp",participants[mvp].entry.id) end
 table.sort(rows,function(a,b)if a.score==b.score then return a.userId&lt;b.userId end;return a.score&gt;b.score end)
 resultsData={rows=rows,mvp=mvp and mvp.UserId or 0,message=message,practice=practice,map=world.mapName,roundId=roundId}
 phase="Fin";remaining=8;musicKey="";result=message
 if objectives then objectives:destroy();objectives=nil end
 if items then items:destroy();items=nil end
 for player,record in pairs(participants) do
  if record.death then record.death:Disconnect() end
  if player.Parent==Players then returnToLobby(player);player:SetAttribute("RoundStatus",record.status);player:SetAttribute("CarriedCapsules",0) end
 end
 world.setGate(false,"Normal");broadcast();remote:FireAllClients("results",resultsData)
 for t=8,1,-1 do remaining=t;broadcast();task.wait(1) end
 participants={};rules=nil;phase="Lobby";remaining=15;killerUserId=0;practice=false;practiceRequested=false
end
game:BindToClose(function()
 for player in pairs(profiles.records) do task.spawn(function()profiles:close(player)end) end
 local untilTime=os.clock()+25
 while next(profiles.records) and os.clock()&lt;untilTime do task.wait(.1) end
end)
while true do
 local list=candidates()
 if #list&lt;2 and not (practiceRequested and #list==1 and #Players:GetPlayers()==1 and RunService:IsStudio()) then
  remaining=15;broadcast();task.wait(1)
 else
  if practiceRequested and #list==1 and remaining&gt;3 then remaining=3 end
  local start=os.clock()
  broadcast();task.wait(1);remaining=remaining-(os.clock()-start)
  if remaining&lt;=0 then
   list=candidates()
   local solo=practiceRequested and #list==1 and #Players:GetPlayers()==1 and RunService:IsStudio()
   if (#list&gt;=2 or solo) and beginRound(list,solo) then
    local previous=os.clock();local nextBroadcast=0
    local outcome,ending
    while phase=="Ronda" do
     local now=os.clock();local dt=now-previous;previous=now
     for player,record in pairs(participants) do
      if playing(player) then
       local root,h=body(player)
       local horizontal=Vector3.new(root.AssemblyLinearVelocity.X,0,root.AssemblyLinearVelocity.Z).Magnitude
       record.played=record.played+dt
       local value,running=Stamina.step(record.energy,dt,horizontal&gt;.5 or h.MoveDirection.Magnitude&gt;.1,(record.drinkUntil or 0)&gt;now)
       player:SetAttribute("Energy",math.floor(value))
       local base=running and (record.entry.role=="Asesino" and 25 or 24) or (record.entry.role=="Asesino" and 18 or 16)
       h.WalkSpeed=abilities:speed(player,base)
       tryEscape(player)
      end
     end
     abilities:tick();if items then items:tick() end;if objectives then objectives:tick() end
     local survivors,killers,escaped=aliveCounts()
     if survivors==0 then outcome="Fin de partida · "..escaped.." superviviente(s) escaparon.";ending="noSurvivors";break end
     if not practice and killers==0 then outcome="Partida interrumpida: el asesino ya no está activo.";ending="killerInactive";break end
     updateLMS()
     rules:tick(dt);world.setGate(rules.gateOpen,rules.mode)
     if rules.expired then outcome="Tiempo agotado · "..escaped.." superviviente(s) escaparon.";ending="timeout";break end
     if now&gt;=nextBroadcast then broadcast();for player in pairs(participants) do if playing(player) then send(player,"combat",abilities:hud(player)) end end;nextBroadcast=now+.25 end
     task.wait(.1)
    end
    finishRound(outcome or "Partida finalizada.",ending)
   else remaining=15;practiceRequested=false end
  end
 end
 if phase=="Lobby" and not Catalog.ready() then task.spawn(preloadCatalog) end
 if phase=="Lobby" then task.spawn(preloadAvatars) end
end
</ProtectedString>
      </Properties>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Abilities</string>
          <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.AbilityConfig)
local Factory=require(RS.Shared.CharacterFactory)
local Timing=require(RS.Shared.AbilityTiming)
local Abilities={};Abilities.__index=Abilities
function Abilities.new(context)return setmetatable({c=context,zones={},pending={},scheduled={}},Abilities)end
function Abilities:later(player,delay,callback)
 table.insert(self.scheduled,{player=player,record=self.c.records()[player],at=os.clock()+delay,callback=callback})
end
function Abilities:hold(attacker,target,kind,duration,escape)
 if not self.c.playing(target) then return end
 local r=self.c.records()[target];local now=os.clock()
 r.holdUntil=now+duration
 target.Character:SetAttribute("Action",kind);target.Character:SetAttribute("ActionAt",workspace:GetServerTimeNow())
 if escape then
  self.serial=(self.serial or 0)+1
  r.escape={token=tostring(self.serial)..":"..tostring(now),untilTime=now+duration,taps=0,last=-100}
  self.c.send(target,"escape",{token=r.escape.token,duration=duration,required=3,taps=0})
 end
end
function Abilities:struggle(player,token)
 if not self.c.playing(player) then return end
 local r=self.c.records()[player];local escape=r.escape;local now=os.clock()
 if not escape or type(token)~="string" or escape.token~=token or now&gt;escape.untilTime or now-escape.last&lt;.12 then return end
 escape.last=now;escape.taps=escape.taps+1
 if escape.taps&gt;=3 then
  r.escape=nil;r.holdUntil=0
  player.Character:SetAttribute("Action","escape");player.Character:SetAttribute("ActionAt",workspace:GetServerTimeNow())
  self.c.send(player,"escapeClose")
 else self.c.send(player,"escape",{token=token,duration=escape.untilTime-now,required=3,taps=escape.taps}) end
end
function Abilities:enemies(player,range,requireSight)
 local result={};local root=self.c.body(player);if not root then return result end
 local role=self.c.records()[player].entry.role
 for other,r in pairs(self.c.records()) do
  local target=self.c.body(other)
  if other~=player and self.c.playing(other) and r.entry.role~=role and (target.Position-root.Position).Magnitude&lt;=range and (not requireSight or self.c.visible(player,other)) then table.insert(result,other) end
 end
 table.sort(result,function(a,b)return (self.c.body(a).Position-root.Position).Magnitude&lt;(self.c.body(b).Position-root.Position).Magnitude end)
 return result
end
function Abilities:damage(player,target,amount)
 if not self.c.playing(player) or not self.c.playing(target) then return false end
 local records=self.c.records();local source=records[player];local victim=records[target]
 if source.entry.role==victim.entry.role or (victim.invulnerableUntil or 0)&gt;os.clock() then return false end
 local targetRoot,h=self.c.body(target)
 local character=target.Character
 if (victim.shieldUntil or 0)&gt;os.clock() then amount=amount*(1-(victim.shield or 0)) end
 local before=h.Health;victim.lastAttacker=player;victim.lastDamage=os.clock()
 h:TakeDamage(math.max(0,amount));source.damage=(source.damage or 0)+math.min(before,amount)
 self.c.effect({kind="hit",position=targetRoot.Position,color="red",duration=.3})
 if character then character:SetAttribute("DamageAt",workspace:GetServerTimeNow()) end
 return true
end
function Abilities:slow(player,speed,duration)
 local r=self.c.records()[player];if r then
  r.slowSpeed=speed;r.slowUntil=os.clock()+duration
  if player.Character then player.Character:SetAttribute("StunnedUntil",workspace:GetServerTimeNow()+duration) end
 end
end
function Abilities:direction(player,aim)
 local root=self.c.body(player)
 if typeof(aim)=="Vector3" and aim.X==aim.X and aim.Y==aim.Y and aim.Z==aim.Z and aim.Magnitude&gt;.1 and aim.Magnitude&lt;2 then return aim.Unit end
 return root.CFrame.LookVector
end
function Abilities:ray(player,direction,range)
 local root=self.c.body(player)
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances={player.Character}
 local hit=workspace:Raycast(root.Position,direction*range,params)
 local point=hit and hit.Position or root.Position+direction*range
 local model=hit and hit.Instance:FindFirstAncestorOfClass("Model")
 return model and game:GetService("Players"):GetPlayerFromCharacter(model),point
end
function Abilities:teleport(player,point,look)
 local center=self.c.world.center
 local limit=self.c.world.playableHalf or 116
 if math.abs(point.X-center.X)&gt;limit or math.abs(point.Z-center.Z)&gt;limit then return false end
 local ignore={}
 for other in pairs(self.c.records()) do if other.Character then table.insert(ignore,other.Character) end end
 local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Exclude;params.FilterDescendantsInstances=ignore
 local root=self.c.body(player)
 if workspace:Raycast(root.Position,point-root.Position,params) then return false end
 local floor=workspace:Raycast(point+Vector3.new(0,6,0),Vector3.new(0,-24,0),params)
 if not floor then return false end
 local humanoid=player.Character:FindFirstChildOfClass("Humanoid")
 local height=humanoid.RigType==Enum.HumanoidRigType.R6 and 3.4 or humanoid.HipHeight+root.Size.Y/2+.4
 local position=floor.Position+Vector3.new(0,height,0)
 local overlap=OverlapParams.new();overlap.FilterType=Enum.RaycastFilterType.Exclude;overlap.FilterDescendantsInstances=ignore
 for _,part in ipairs(workspace:GetPartBoundsInBox(CFrame.new(position),Vector3.new(2.5,4.5,2.5),overlap)) do if part.CanCollide then return false end end
 Factory.place(player.Character,floor.Position)
 if look then player.Character:PivotTo(CFrame.lookAt(root.Position,Vector3.new(look.X,root.Position.Y,look.Z))) end
 return true
end
function Abilities:cast(player,slot,aim)
 if not self.c.playing(player) or type(slot)~="number" or slot%1~=0 then return end
 local record=self.c.records()[player];local list=Config[record.entry.id];local ability=list and list[slot]
 if not ability or record.itemUse or record.channel or (record.holdUntil or 0)&gt;os.clock() then return end
 record.cooldowns=record.cooldowns or {}
 local now=os.clock()
 if (record.cooldowns[ability.id] or 0)&gt;now then return end
 if record.energy.value&lt;ability.cost then self.c.send(player,"message","No tienes suficiente energía.");return end
 local root,h=self.c.body(player);local direction=self:direction(player,aim)
 local enemies=self:enemies(player,ability.range,true)
 local target=enemies[1];local kind=ability.kind
 if (kind=="pull" or kind=="behind") and not target then return end
 if kind=="lastFighter" and self.c.rules().mode~="LMS" and h.Health&gt;35 then self.c.send(player,"message","Last Fighter se activa en LMS o con 35 de vida o menos.");return end
 if (kind=="heal" or kind=="repair") and h.Health&gt;=h.MaxHealth then return end
 if kind=="behind" then
  local otherRoot=self.c.body(target)
  if not self:teleport(player,otherRoot.Position-otherRoot.CFrame.LookVector*6,otherRoot.Position) then self.c.send(player,"message","No hay un lugar libre detrás del objetivo.");return end
 elseif kind=="step" then
  local flat=Vector3.new(direction.X,0,direction.Z)
  if flat.Magnitude&lt;.05 or not self:teleport(player,root.Position+flat.Unit*ability.range,root.Position+direction*40) then return end
  record.invulnerableUntil=now+ability.duration
 end
 record.cooldowns[ability.id]=now+ability.cooldown;record.energy.value=math.max(0,record.energy.value-ability.cost)
 record.abilitiesUsed=(record.abilitiesUsed or 0)+1
 local punching=ability.id=="cane" and (record.caneAwayUntil or 0)&gt;now
 player.Character:SetAttribute("Action",punching and "punch" or ability.id);player.Character:SetAttribute("ActionAt",workspace:GetServerTimeNow())
 self.c.effect({kind=ability.id=="sixthHour" and "transformation" or kind,ability=punching and "punch" or ability.id,model=player.Character,position=root.Position,color=record.entry.role=="Asesino" and "red" or "blue",duration=.45,radius=kind=="areaDamage" and ability.range or 3})
 local function perform()
 if not self.c.playing(player) or self.c.records()[player]~=record then return end
 now=os.clock();root,h=self.c.body(player)
 enemies=self:enemies(player,punching and 6 or ability.range,true);target=enemies[1]
 if kind=="melee" then if target then self:damage(player,target,ability.amount) end
 elseif kind=="behind" and target then
  self:hold(player,target,"grabbed",.55,false)
  local grabbed=target
  self:later(player,.5,function()
   if self.c.playing(grabbed) and self.c.visible(player,grabbed) then
    local victim=self.c.body(grabbed);local source=self.c.body(player)
    if (victim.Position-source.Position).Magnitude&lt;=10 then victim.AssemblyLinearVelocity=source.CFrame.LookVector*18+Vector3.new(0,9,0) end
   end
  end)
 elseif kind=="stun" then if target then self:slow(target,ability.amount,ability.duration) end
 elseif kind=="pull" and target then
  self:damage(player,target,ability.amount);self:slow(target,6,ability.duration)
  local targetRoot=self.c.body(target);local delta=root.Position-targetRoot.Position
  if delta.Magnitude&gt;.1 then targetRoot.AssemblyLinearVelocity=delta.Unit*30+Vector3.new(0,8,0) end
  self.c.effect({kind="beam",position=root.Position,finish=targetRoot.Position,color="red",duration=.35})
 elseif kind=="speed" then record.boostSpeed=ability.amount;record.boostUntil=now+ability.duration
 elseif kind=="heal" then h.Health=math.min(h.MaxHealth,h.Health+ability.amount)
 elseif kind=="repair" then record.channel={kind="repair",untilTime=now+ability.duration,position=root.Position,started=now,amount=ability.amount}
 elseif kind=="shield" then record.shield=ability.amount;record.shieldUntil=now+ability.duration
 elseif kind=="lastFighter" then
  h.Health=math.min(h.MaxHealth,h.Health+ability.amount);record.energy.value=math.max(record.energy.value,50);record.boostSpeed=26;record.boostUntil=now+ability.duration
 elseif kind=="teamShield" or kind=="teamHeal" then
  for other,r in pairs(self.c.records()) do
   local rRoot,otherH=self.c.body(other)
   if self.c.playing(other) and r.entry.role==record.entry.role and (rRoot.Position-root.Position).Magnitude&lt;=ability.range and (other==player or self.c.visible(player,other)) then
    if kind=="teamShield" then r.shield=ability.amount;r.shieldUntil=now+ability.duration
    else otherH.Health=math.min(otherH.MaxHealth,otherH.Health+ability.amount);r.linkUntil=now+ability.duration end
    self.c.effect({kind="beam",position=root.Position,finish=rRoot.Position,color="blue",duration=.4})
   end
  end
 elseif kind=="reveal" then
  local models={}
  for _,other in ipairs(self:enemies(player,ability.range,false)) do table.insert(models,other.Character) end
  self.c.send(player,"reveal",{models=models,duration=ability.duration})
 elseif kind=="bacon" or kind=="caneThrow" then
  local other,point=self:ray(player,direction,ability.range)
  local flight=math.clamp((point-root.Position).Magnitude/45,.12,.8)
  self.c.effect({kind="projectile",projectile=kind=="bacon" and "bacon" or "cane",model=player.Character,position=root.Position,finish=point,duration=flight,color="blue"})
  if kind=="caneThrow" then
   record.caneAwayUntil=now+flight*2+.2
   player.Character:SetAttribute("CaneAwayUntil",workspace:GetServerTimeNow()+flight*2+.2)
   self:later(player,flight,function()
    local hand=self.c.body(player)
    self.c.effect({kind="projectile",projectile="cane",model=player.Character,position=point,finish=hand.Position,duration=flight,returning=true,color="blue"})
   end)
   self:later(player,flight*2+.2,function()
    player.Character:SetAttribute("CaneAwayUntil",0)
    local actionAt=player.Character:GetAttribute("ActionAt") or 0
    if workspace:GetServerTimeNow()-actionAt&gt;.55 then player.Character:SetAttribute("Action","caneRecover");player.Character:SetAttribute("ActionAt",workspace:GetServerTimeNow()) end
   end)
  end
  self:later(player,flight,function()
   self.c.effect({kind="burst",position=point,color="blue",radius=1.4,duration=.25})
   if other and self.c.playing(other) and (self.c.body(other).Position-point).Magnitude&lt;=5 then
    local otherRecord=self.c.records()[other]
    if kind=="bacon" and otherRecord.entry.role==record.entry.role then
     local _,otherH=self.c.body(other);otherH.Health=math.min(otherH.MaxHealth,otherH.Health+ability.amount)
    elseif otherRecord.entry.role~=record.entry.role then self:slow(other,kind=="caneThrow" and ability.amount or 8,ability.duration) end
   end
  end)
 elseif kind=="ray" or kind=="blast" then
  local other,point=self:ray(player,direction,ability.range)
  self.c.effect({kind="beam",ability=ability.id,model=player.Character,position=root.Position,finish=point,color=kind=="blast" and "red" or "blue",duration=.35})
  if kind=="blast" then
   self.c.effect({kind="burst",position=point,color="red",radius=12,duration=.6})
   for _,enemy in ipairs(self:enemies(player,ability.range+12,true)) do
    local r=self.c.body(enemy);if (r.Position-point).Magnitude&lt;=12 then self:damage(player,enemy,ability.amount) end
   end
  elseif other and self.c.playing(other) then
   local otherRecord=self.c.records()[other]
   if otherRecord.entry.role~=record.entry.role then
    self:damage(player,other,ability.amount)
    self:slow(other,8,ability.duration)
   end
  end
 elseif kind=="areaSlow" or kind=="areaDamage" then
  for _,other in ipairs(enemies) do if kind=="areaSlow" then self:slow(other,ability.amount,ability.duration) else self:damage(player,other,ability.amount) end end
 elseif kind=="slam" or kind=="pounce" then
  root.AssemblyLinearVelocity=root.CFrame.LookVector*(kind=="pounce" and 34 or 12)+Vector3.new(0,22,0)
  table.insert(self.pending,{player=player,at=now+.5,range=ability.range,amount=ability.amount,slow=kind=="slam",pounce=kind=="pounce"})
 elseif kind=="fire" then
  local _,point=self:ray(player,direction,18)
  table.insert(self.zones,{player=player,position=point,expires=now+ability.duration,next=now,radius=ability.range,damage=ability.amount})
  self.c.effect({kind="fire",position=point,color="red",radius=ability.range,duration=ability.duration})
 end
 end
 local windup=Timing[ability.id] or 0
 if windup&gt;0 then self:later(player,windup,perform) else perform() end
end
function Abilities:tick()
 local now=os.clock()
 for i=#self.scheduled,1,-1 do
  local item=self.scheduled[i]
  if now&gt;=item.at then
   table.remove(self.scheduled,i)
   if self.c.playing(item.player) and self.c.records()[item.player]==item.record then item.callback() end
  end
 end
 for i=#self.pending,1,-1 do
  local impact=self.pending[i]
  if now&gt;=impact.at then
   if self.c.playing(impact.player) then
    for _,other in ipairs(self:enemies(impact.player,impact.range,true)) do
     self:damage(impact.player,other,impact.amount)
     if impact.slow then self:slow(other,6,2) end
     if impact.pounce and self.c.playing(other) then self:hold(impact.player,other,"pinned",1.6,true) end
    end
    self.c.effect({kind="burst",position=self.c.body(impact.player).Position,color="blue",radius=impact.range,duration=.6})
   end
   table.remove(self.pending,i)
  end
 end
 for i=#self.zones,1,-1 do
  local zone=self.zones[i]
  if now&gt;=zone.expires or not self.c.playing(zone.player) then table.remove(self.zones,i)
  elseif now&gt;=zone.next then
   zone.next=now+1
   for _,other in ipairs(self:enemies(zone.player,60,true)) do if (self.c.body(other).Position-zone.position).Magnitude&lt;=zone.radius then self:damage(zone.player,other,zone.damage) end end
  end
 end
 for player,record in pairs(self.c.records()) do
  if self.c.playing(player) then
   local root,h=self.c.body(player)
   if record.escape and now&gt;=record.escape.untilTime then record.escape=nil;self.c.send(player,"escapeClose") end
   if record.channel then
    local channel=record.channel
    if (record.lastDamage or 0)&gt;channel.started or (root.Position-channel.position).Magnitude&gt;3 then record.channel=nil
    elseif now&gt;=channel.untilTime then h.Health=math.min(h.MaxHealth,h.Health+channel.amount);record.channel=nil end
    if not record.channel and player.Character and player.Character:GetAttribute("Action")=="selfRepair" then player.Character:SetAttribute("Action","") end
   end
  end
 end
end
function Abilities:speed(player,base)
 local r=self.c.records()[player];local now=os.clock()
 if (r.holdUntil or 0)&gt;now then return 0 end
 if r.itemUse or r.channel then return 8 end
 if (r.boostUntil or 0)&gt;now then base=math.max(base,r.boostSpeed) end
 if (r.drinkUntil or 0)&gt;now then base=base*require(RS.Shared.ItemConfig).energyDrink.speedMultiplier end
 if (r.slowUntil or 0)&gt;now then base=math.min(base,r.slowSpeed) end
 return base
end
function Abilities:hud(player)
 local r=self.c.records()[player];if not r then return nil end
 local now=os.clock();local cooldowns={};local statuses={}
 for i,a in ipairs(Config[r.entry.id]) do cooldowns[i]=math.max(0,math.ceil((r.cooldowns and r.cooldowns[a.id] or 0)-now)) end
 for key,label in pairs({shieldUntil="ESCUDO",boostUntil="VELOCIDAD",slowUntil="RALENTIZADO",drinkUntil="ENERGÍA INFINITA · SPEED III",linkUntil="VINCULADO",invulnerableUntil="FANTASMA"}) do if (r[key] or 0)&gt;now then table.insert(statuses,label) end end
 if r.itemUse then table.insert(statuses,"MEDKIT · "..math.max(0,math.ceil(r.itemUse.untilTime-now)).." s") end
 if r.channel then table.insert(statuses,"REPARANDO") end
 if r.escape then table.insert(statuses,"PULSA E · ESCAPAR") end
 return {character=r.entry.id,cooldowns=cooldowns,statuses=statuses,items=r.items or {},carried=self.c.rules():carried(player.UserId)}
end
return Abilities
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Camp</string>
          <ProtectedString name="Source">local Camp={}
function Camp.extend(world,remote,World)
 local camp=Instance.new("Model");camp.Name="ClubHouseYCampamentoV4";camp.Parent=world
 local wood=Color3.fromRGB(91,67,47);local stone=Color3.fromRGB(95,101,95);local amber=Color3.fromRGB(230,173,89)
 local function p(name,size,x,y,z,tint,material,decor)
  local part=World.part(camp,name,size,Vector3.new(x,y,z),tint or wood,material or Enum.Material.WoodPlanks)
  if decor then part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false end
  return part
 end
 p("Camino al club",Vector3.new(9,.12,48),0,-.85,-62,stone,Enum.Material.Ground,true)
 for _,side in ipairs({-1,1}) do
  p("Camino a cabañas",Vector3.new(60,.12,7),side*34,-.84,-68,stone,Enum.Material.Ground,true)
  for i=1,5 do
   local lantern=p("Farol de camino",Vector3.new(.6,1,.6),side*6,1,-38-i*7,amber,Enum.Material.Neon,true)
   local light=Instance.new("PointLight");light.Color=amber;light.Range=12;light.Brightness=.65;light.Parent=lantern
  end
 end
 p("Plataforma club house",Vector3.new(39,1,20),0,0,-79)
 p("Techo club house",Vector3.new(42,.8,23),0,11,-79,wood:Lerp(stone,.4))
 for _,x in ipairs({-19,19}) do p("Pilar del club",Vector3.new(1,11,1),x,5.5,-70);p("Pilar del club",Vector3.new(1,11,1),x,5.5,-88) end
 p("Pared trasera del club",Vector3.new(39,10,1),0,5,-88)
 local sign=p("Club House",Vector3.new(16,2,.25),0,9,-69,stone,nil,true);World.label(sign,"CLUB HOUSE · EL ÚLTIMO REFUGIO")
 local counters={{"TIENDA","shop",-12},{"PERSONAJES","characters",0},{"INVENTARIO","inventory",12}}
 for _,data in ipairs(counters) do
  local counter=p(data[1],Vector3.new(9,3,4),data[3],2,-82,wood)
  local panel=p("Rótulo "..data[1],Vector3.new(8,2,.2),data[3],5,-84,stone,nil,true);World.label(panel,data[1])
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Abrir";prompt.ObjectText=data[1];prompt.MaxActivationDistance=10;prompt.Parent=counter
  prompt.Triggered:Connect(function(player)remote:FireClient(player,"openPanel",data[2])end)
 end
 -- Quiet gathering spot on the east side; no objectives or combat triggers in the camp.
 for i=1,12 do
  local a=i/12*math.pi*2
  p("Piedra de fogata",Vector3.new(1.2,.5,1.2),24+math.cos(a)*3,.3,-53+math.sin(a)*3,stone,Enum.Material.Slate)
 end
 local log=p("Leña",Vector3.new(5,.7,1),24,.4,-53,wood,Enum.Material.Wood)
 local flame=Instance.new("Fire");flame.Size=3;flame.Heat=3;flame.Color=amber;flame.SecondaryColor=Color3.fromRGB(185,77,37);flame.Parent=log
 local light=Instance.new("PointLight");light.Color=amber;light.Brightness=1.3;light.Range=30;light.Shadows=true;light.Parent=log
 for _,offset in ipairs({-8,8}) do p("Banco junto a la fogata",Vector3.new(9,1.2,2),24,1,-53+offset,wood) end
 for i=1,16 do
  local x=-80+(i%8)*20;local z=i&lt;=8 and 73 or -87
  if math.abs(x)&gt;25 then
   p("Hierba del sendero",Vector3.new(2,.9,2),x,-.4,z,Color3.fromRGB(57,74,49),Enum.Material.Grass,true)
   p("Roca erosionada",Vector3.new(3.5,2.3,3),x+3,.2,z-3,stone,Enum.Material.Slate)
  end
 end
 -- Inhabited-looking refuge details; paths and existing interactions remain clear.
 for _,x in ipairs({-64,64}) do
  local board=p("Tablón de expediciones",Vector3.new(7,4,.22),x-7,5,-45.7,stone,nil,true)
  World.label(board,"EXPEDICIONES\nNADIE REGRESA IGUAL")
  p("Alfombra gastada",Vector3.new(8,.04,6),x,.54,-58,Color3.fromRGB(72,79,63),Enum.Material.Fabric,true)
  p("Suministros cerrados",Vector3.new(3,2,2.4),x+7,1.5,-49,stone,Enum.Material.Metal)
  for i=1,3 do p("Tabla reforzada",Vector3.new(.14,2.1,2.45),x+6+i*.45,1.5,-49,wood,Enum.Material.Wood,true) end
 end
 for _,side in ipairs({-1,1}) do
  for i=1,9 do p("Pasarela de madera",Vector3.new(8,.12,1.7),side*34,-.76,-76+i*1.8,wood:Lerp(stone,i%3*.1),Enum.Material.WoodPlanks,true) end
 end
 for i=1,5 do
  local angle=i/5*math.pi*2
  local rock=p("Piedra lisa de fogata",Vector3.new(2,.7,1.4),24+math.cos(angle)*4.5,.25,-53+math.sin(angle)*4.5,stone,Enum.Material.Slate,true)
  rock.Shape=Enum.PartType.Ball
 end
 return camp
end
return Camp
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">MapExpansion</string>
          <ProtectedString name="Source">-- V4 districts extend the existing layouts. Four doors and unobstructed cross
-- aisles in each district provide alternative chase routes around cover.
local Expansion={}
local districts={
 island={"PUESTO DE RADIO","CASA DEL GUARDACOSTAS","TALLER DE BARCAS","DEPÓSITO DEL FARO"},
 pizza={"HORNO INDUSTRIAL","SALÓN DE CUMPLEAÑOS","CÁMARA FRIGORÍFICA","MUELLE DE REPARTO"},
 heights={"CENTRAL DE ASCENSORES","OFICINAS ABANDONADAS","CENTRO DE DATOS","ESTUDIO DE RADIO"},
 lab={"AISLAMIENTO","BANCO DE MUESTRAS","SALA DE TURBINAS","ARCHIVO CLÍNICO"},
 manor={"INVERNADERO","BIBLIOTECA PRIVADA","SALA DE MÚSICA","COCHERAS"},
 town={"LAVANDERÍA","TALLER DEL BARRIO","TERMINAL DE AUTOBÚS","ALMACÉN VECINAL"},
 factory={"MANTENIMIENTO","ALMACÉN DE BOBINAS","CONTROL INDUSTRIAL","NAVE DE REPUESTOS"},
 arcade={"SALA LAN","BÓVEDA DE PREMIOS","SERVIDORES","TALLER DE REPARACIÓN"},
 arena={"GIMNASIO","ENFERMERÍA","TIENDA DEL ESTADIO","SALA DE ENTRENAMIENTO"}}

function Expansion.extend(model,definition,helpers,palette)
 local p,sign,building=helpers.part,helpers.sign,helpers.building
 local wall=Color3.fromRGB(palette.wall[1],palette.wall[2],palette.wall[3])
 local accent=Color3.fromRGB(palette.accent[1],palette.accent[2],palette.accent[3])
 local dark=wall:Lerp(Color3.fromRGB(26,31,35),.55)
 local positions={Vector3.new(-138,0,-138),Vector3.new(138,0,-138),Vector3.new(-138,0,138),Vector3.new(138,0,138)}
 local points={}
 local function details(x,z,index)
  local theme=definition.theme
  -- Side partitions leave the center and every doorway free.
  for _,side in ipairs({-1,1}) do
   p("Tabique con paso lateral",Vector3.new(15,7,.65),x+side*20,3.5,z+5,wall)
   p("Moldura de distrito",Vector3.new(25,.2,.25),x+side*18,1,z+31,accent,Enum.Material.Metal,true)
   local cx=x+side*21
   if theme=="lab" or theme=="factory" then
    for _,dz in ipairs({-19,22}) do
     local tank=p(theme=="lab" and "Contenedor de aislamiento" or "Bobina de mantenimiento",Vector3.new(6,4,4),cx,3,z+dz,accent,Enum.Material.Metal)
     tank.Shape=Enum.PartType.Cylinder;tank.CFrame=tank.CFrame*CFrame.Angles(0,0,math.pi/2)
     p("Zócalo de máquina",Vector3.new(7,.6,6),cx,.3,z+dz,dark,Enum.Material.Metal)
     p("Panel de diagnóstico",Vector3.new(2,1,.12),cx,4,z+dz-3,accent,Enum.Material.Neon,true)
    end
   elseif theme=="pizza" then
    p("Horno de ladrillo",Vector3.new(9,6,7),cx,3,z-21,wall,Enum.Material.Brick)
    p("Boca del horno",Vector3.new(6,3,.15),cx,2.7,z-24.6,dark,Enum.Material.Metal,true)
    helpers.tableAt(cx,z+21)
    for n=1,3 do p("Bandeja de cocina",Vector3.new(2,.08,2),cx-3+n*1.5,3.08,z+21,accent,Enum.Material.Metal,true) end
   elseif theme=="arcade" or theme=="heights" then
    for _,dz in ipairs({-21,21}) do
     p("Bastidor electrónico",Vector3.new(5,8,3),cx,4,z+dz,dark,Enum.Material.Metal)
     for slot=1,4 do
      p("Equipo y rejilla",Vector3.new(4.4,1.25,.2),cx,slot*1.6,z+dz-1.6,wall,Enum.Material.Metal,true)
      p("Indicador de equipo",Vector3.new(.16,.16,.1),cx+1.6,slot*1.6,z+dz-1.75,accent,Enum.Material.Neon,true)
     end
    end
   elseif theme=="manor" then
    for _,dz in ipairs({-22,23}) do
     p("Librería antigua",Vector3.new(10,8,2),cx,4,z+dz,dark,Enum.Material.WoodPlanks)
     for shelf=1,3 do
      p("Balda de madera",Vector3.new(10,.16,2.5),cx,shelf*2,z+dz-.2,accent,Enum.Material.WoodPlanks,true)
      for book=1,5 do p("Libro olvidado",Vector3.new(.8,1.3,1.2),cx-4+book*1.4,shelf*2+.7,z+dz-.7,wall:Lerp(accent,book/7),Enum.Material.Fabric,true) end
     end
    end
   elseif theme=="arena" then
    for _,dz in ipairs({-21,22}) do
     p("Banco de entrenamiento",Vector3.new(11,2.2,3),cx,1.1,z+dz,dark,Enum.Material.Fabric)
     p("Bastidor de taquillas",Vector3.new(10,7,2),cx,3.5,z+dz+4,wall,Enum.Material.Metal)
     for door=1,3 do p("Puerta de taquilla",Vector3.new(2.9,6,.12),cx-6+door*3,3.5,z+dz+2.9,accent,Enum.Material.Metal,true) end
    end
   else
    helpers.tableAt(cx,z-21)
    helpers.crate(cx-3,z+21,"Suministros del distrito");helpers.crate(cx+4,z+25,"Cobertura de almacén")
    p("Tablón de anuncios",Vector3.new(8,5,.25),cx,7,z+31,accent,Enum.Material.WoodPlanks,true)
   end
  end
  local ceiling=p("Luminaria de distrito",Vector3.new(2,.2,2),x,11.5,z,accent,Enum.Material.Neon,true)
  local light=Instance.new("PointLight");light.Color=accent;light.Brightness=.7;light.Range=35;light.Shadows=false;light.Parent=ceiling
  sign("SECTOR "..index.." · DOBLE RUTA",x,9,z+31,20)
  if definition.theme=="heights" then
   for _,side in ipairs({-1,1}) do
    local top=helpers.stairs(x+side*35,z-25,13.6)
    p("Paso a cubierta exterior",Vector3.new(14,.5,8),x+side*30,13.6,top,wall,Enum.Material.Metal)
   end
  end
 end
 for index,position in ipairs(positions) do
  local x,z=position.X,position.Z
  building(x,z,districts[definition.theme][index],true)
  details(x,z,index)
  table.insert(points,{name=districts[definition.theme][index],position=position})
 end
 -- Ring roads connect the old center, four new districts and outer escape routes.
 for _,side in ipairs({-1,1}) do
  p("Ruta perimetral horizontal",Vector3.new(374,.06,10),0,.045,side*100,dark,Enum.Material.Concrete,true)
  p("Ruta perimetral vertical",Vector3.new(10,.06,374),side*100,.045,0,dark,Enum.Material.Concrete,true)
  p("Paseo exterior horizontal",Vector3.new(374,.06,10),0,.045,side*180,dark,Enum.Material.Concrete,true)
  p("Paseo exterior vertical",Vector3.new(10,.06,374),side*180,.045,0,dark,Enum.Material.Concrete,true)
  for _,offset in ipairs({-60,60}) do
   helpers.crate(side*158,offset,"Cobertura de ruta exterior")
   helpers.crate(offset,side*158,"Cobertura de ruta exterior")
   helpers.lamp(side*100,offset)
  end
 end
 -- Vegetation remains outside objective approaches, with no decorative collision.
 if definition.theme=="island" or definition.theme=="manor" or definition.theme=="town" then
  for _,x in ipairs({-159,-126,126,159}) do for _,z in ipairs({-55,55}) do
   local trunk=p("Tronco exterior",Vector3.new(12,1.1,1.1),x,6,z,wall,Enum.Material.Wood)
   trunk.Shape=Enum.PartType.Cylinder;trunk.CFrame=trunk.CFrame*CFrame.Angles(0,0,math.pi/2)
   for layer=1,3 do
    local crown=p("Vegetación exterior",Vector3.new(10-layer,6,10-layer),x,10+layer*2,z,Color3.fromRGB(36,65+layer*4,45),Enum.Material.Grass,true)
    crown.Shape=Enum.PartType.Ball
   end
  end end
 end
 return {points=points,generatorPositions={positions[1],Vector3.new(62,0,-60),Vector3.new(-62,0,60),positions[4]},
  puzzlePositions={Vector3.new(-18,0,-78),positions[2],Vector3.new(18,0,78),positions[3]}}
end
return Expansion
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Maps</string>
          <ProtectedString name="Source">-- Nine authored procedural layouts. Only the active map is instantiated.
local Maps={}
local palettes={
 island={ground={139,126,88},wall={105,80,55},accent={116,176,183},material="Sand"},
 pizza={ground={89,78,69},wall={123,58,47},accent={211,161,72},material="Concrete"},
 heights={ground={63,69,76},wall={100,111,122},accent={131,180,201},material="Concrete"},
 lab={ground={73,86,89},wall={115,135,133},accent={95,196,160},material="Metal"},
 manor={ground={73,66,57},wall={68,49,63},accent={176,126,75},material="WoodPlanks"},
 town={ground={57,90,62},wall={122,75,64},accent={212,174,78},material="Grass"},
 factory={ground={65,68,62},wall={88,86,69},accent={174,153,65},material="Concrete"},
 arcade={ground={42,40,56},wall={55,42,72},accent={152,95,192},material="SmoothPlastic"},
 arena={ground={98,77,59},wall={87,93,108},accent={201,111,54},material="WoodPlanks"}}
local function color(v)return Color3.fromRGB(v[1],v[2],v[3])end
function Maps.build(parent,definition,World)
 local model=Instance.new("Model");model.Name="Mapa_"..definition.id;model.Parent=parent
 local center=Vector3.new(0,0,600)
 local palette=palettes[definition.theme]
 local ground,wall,accent=color(palette.ground),color(palette.wall),color(palette.accent)
 local generators={Vector3.new(-62,0,-60),Vector3.new(62,0,-60),Vector3.new(-62,0,60),Vector3.new(62,0,60)}
 local puzzles={Vector3.new(-18,0,-78),Vector3.new(94,0,0),Vector3.new(18,0,78),Vector3.new(-94,0,0)}
 local function p(name,size,x,y,z,tint,material,decor)
  local part=World.part(model,name,size,center+Vector3.new(x,y,z),tint or wall,material or Enum.Material.Concrete)
  part.CastShadow=not decor
  if decor then part.CanCollide=false;part.CanTouch=false;part.CanQuery=false end
  return part
 end
 local function sign(text,x,y,z,width)
  local panel=p("Cartel "..text,Vector3.new(width or 12,3,.25),x,y,z,wall,Enum.Material.Metal,true)
  World.label(panel,text);return panel
 end
 local function clear(x,z)
  for _,positions in ipairs({generators,puzzles}) do
   for _,v in ipairs(positions) do if (Vector3.new(x,0,z)-v).Magnitude&lt;9 then return false end end
  end
  return true
 end
 local function crate(x,z,kind)
  if not clear(x,z) then return end
  local part=p(kind or "Caja de cobertura",Vector3.new(5,4,5),x,2,z,wall:Lerp(accent,.15),Enum.Material.WoodPlanks)
  p("Herraje",Vector3.new(5.1,.15,5.1),x,3.5,z,accent,Enum.Material.Metal,true)
  return part
 end
 local function tableAt(x,z)
  if not clear(x,z) then return end
  p("Mesa",Vector3.new(7,.4,4),x,2.8,z,accent,Enum.Material.WoodPlanks)
  for _,dx in ipairs({-2.8,2.8}) do p("Pata",Vector3.new(.4,2.7,.4),x+dx,1.35,z,wall,Enum.Material.Metal) end
  for _,dz in ipairs({-3.5,3.5}) do p("Asiento",Vector3.new(4,1.8,1.4),x,.9,z+dz,wall,Enum.Material.WoodPlanks) end
 end
 local function lamp(x,z,tint)
  p("Poste",Vector3.new(.5,10,.5),x,5,z,wall,Enum.Material.Metal)
  local bulb=p("Luz ambiental",Vector3.new(1.4,.4,1.4),x,10.1,z,tint or accent,Enum.Material.Neon,true)
  local light=Instance.new("PointLight");light.Color=tint or accent;light.Brightness=.65;light.Range=24;light.Shadows=false;light.Parent=bulb
 end
 local function building(x,z,title,roof)
  p("Suelo "..title,Vector3.new(64,.3,64),x,.15,z,ground:Lerp(accent,.1),Enum.Material[palette.material])
  -- Four open doors, creating loops instead of dead ends.
  for _,side in ipairs({-1,1}) do
   for _,offset in ipairs({-19,19}) do
    p("Pared "..title,Vector3.new(26,12,1),x+offset,6,z+side*32,wall)
    p("Pared "..title,Vector3.new(1,12,26),x+side*32,6,z+offset,wall)
   end
   p("Dintel",Vector3.new(12,3,1),x,10.5,z+side*32,wall)
   p("Dintel",Vector3.new(1,3,12),x+side*32,10.5,z,wall)
  end
  if roof then p("Techo "..title,Vector3.new(65,.7,65),x,12.6,z,wall:Lerp(Color3.fromRGB(15,19,24),.4)) end
  sign(title,x,10,z-32.6,16)
  for _,dx in ipairs({-20,20}) do
   p("Ventanal",Vector3.new(9,3,.12),x+dx,7,z-32.6,accent,Enum.Material.Glass,true).Transparency=.35
  end
 end
 local function stairs(x,z,height)
  local count=math.ceil(height/.55)
  for i=1,count do p("Escalón",Vector3.new(7,i*height/count,1.6),x,i*height/count/2,z+(i-1)*1.6,accent,Enum.Material.Metal) end
  return z+(count-1)*1.6
 end
 p("Suelo estructural",Vector3.new(404,2,404),0,-1,0,ground,Enum.Material[palette.material])
 for _,x in ipairs({-191,191}) do p("Límite lateral",Vector3.new(2,30,384),x,15,0,wall) end
 p("Límite norte",Vector3.new(384,30,2),0,15,-191,wall)
 for _,x in ipairs({-102,102}) do p("Límite sur",Vector3.new(178,30,2),x,15,191,wall) end
 p("Camino transversal",Vector3.new(378,.07,13),0,.04,0,ground:Lerp(Color3.fromRGB(167,159,141),.3),Enum.Material.Concrete,true)
 p("Camino central",Vector3.new(13,.07,378),0,.05,0,ground:Lerp(Color3.fromRGB(167,159,141),.3),Enum.Material.Concrete,true)
 local titles={island={"REFUGIO DEL FARO","ALMACÉN DEL MUELLE","ESTACIÓN COSTERA","RADIO DE EMERGENCIA"},pizza={"COMEDOR","COCINA","ESCENARIO","ALMACÉN"},heights={"TORRE NORTE","OFICINAS","ARCHIVO","TORRE SUR"},lab={"CULTIVOS","CUARENTENA","REACTOR","OBSERVACIÓN"},manor={"BIBLIOTECA","COMEDOR","SALÓN","GALERÍA"},town={"CASA ROJA","CASA AZUL","TALLER","CENTRO VECINAL"},factory={"MONTAJE","FUNDICIÓN","REPUESTOS","EMBALAJE"},arcade={"RETRO ZONE","PIXEL HALL","GLITCH ROOM","BACKSTAGE"},arena={"VESTUARIO A","VESTUARIO B","TÚNEL OESTE","TÚNEL ESTE"}}
 for i,position in ipairs(generators) do
  local x,z=position.X,position.Z
  building(x,z,titles[definition.theme][i],definition.theme~="heights" and definition.theme~="island" and definition.theme~="arena")
  if definition.theme=="pizza" or definition.theme=="manor" then
   for _,dx in ipairs({-18,18}) do for _,dz in ipairs({-18,18}) do tableAt(x+dx,z+dz) end end
   if definition.theme=="pizza" then
    p("Mostrador",Vector3.new(16,4,4),x-16,2,z+25,accent)
    for n=1,4 do p("Caja de pizza",Vector3.new(3,.35,3),x-24+n*4,4.3,z+25,Color3.fromRGB(187,154,109),Enum.Material.Wood,true) end
   else
    for n=1,5 do
     p("Estantería",Vector3.new(7,8,2),x-25+(n-1)*12,4,z+27,wall,Enum.Material.WoodPlanks)
     for shelf=1,3 do p("Libros",Vector3.new(6,1.5,1.2),x-25+(n-1)*12,shelf*2,z+25.5,accent:Lerp(ground,n/8),Enum.Material.Wood,true) end
    end
   end
  elseif definition.theme=="lab" then
   for _,dx in ipairs({-20,20}) do for _,dz in ipairs({-20,20}) do
    local tank=p("Cámara de muestras",Vector3.new(5,8,5),x+dx,4,z+dz,accent,Enum.Material.Glass)
    tank.Shape=Enum.PartType.Cylinder;tank.Transparency=.45
    p("Muestra suspendida",Vector3.new(1.5,4,1.5),x+dx,4,z+dz,Color3.fromRGB(93,138,96),Enum.Material.Neon,true)
   end end
   tableAt(x-20,z);tableAt(x+20,z)
  elseif definition.theme=="factory" then
   for _,dx in ipairs({-19,19}) do
    p("Cinta transportadora",Vector3.new(8,2,32),x+dx,1,z,Color3.fromRGB(35,40,38),Enum.Material.Metal)
    for n=-3,3 do p("Rodillo",Vector3.new(8.2,.35,.6),x+dx,2.2,z+n*4,accent,Enum.Material.Metal,true) end
    p("Prensa",Vector3.new(10,6,7),x+dx,3,z+21,wall,Enum.Material.Metal)
   end
  elseif definition.theme=="arcade" then
   for _,dx in ipairs({-22,22}) do for dz=-22,22,11 do
    p("Máquina arcade",Vector3.new(4,6,4),x+dx,3,z+dz,wall,Enum.Material.Metal)
    p("Pantalla corrupta",Vector3.new(3,2,.16),x+dx,4,z+dz-2.12,accent:Lerp(Color3.fromRGB(80,211,176),i/5),Enum.Material.Neon,true)
   end end
   for dx=-24,24,8 do for dz=-24,24,8 do p("Baldosa",Vector3.new(7.9,.05,7.9),x+dx,.32,z+dz,(dx+dz)%16==0 and wall or ground,Enum.Material.SmoothPlastic,true) end end
  elseif definition.theme=="heights" then
   p("Azotea accesible",Vector3.new(66,1,66),x,13,z,wall)
   for _,dx in ipairs({-20,20}) do p("Ventilación",Vector3.new(9,3,7),x+dx,15,z+16,accent,Enum.Material.Metal) end
   for _,dx in ipairs({-20,20}) do crate(x+dx,z+15);tableAt(x+dx,z-15) end
  elseif definition.theme=="arena" then
   for n=1,4 do p("Grada",Vector3.new(25,n*.7,3),x,n*.35,z-25+n*3,accent,Enum.Material.WoodPlanks) end
   for _,dx in ipairs({-20,20}) do crate(x+dx,z+18,"Taquillas") end
  else
   for _,dx in ipairs({-21,21}) do for _,dz in ipairs({-20,20}) do crate(x+dx,z+dz) end end
   tableAt(x-20,z)
  end
 end
 if definition.theme=="heights" then
  local top=stairs(-105,-106,13.6)
  p("Acceso a azotea",Vector3.new(45,.5,8),-83,13.6,top,accent,Enum.Material.Metal)
  p("Puente entre torres",Vector3.new(66,.5,8),0,13.6,-60,accent,Enum.Material.Metal)
 elseif definition.theme=="manor" then
  local top=stairs(-25,10,8)
  p("Balcón del vestíbulo",Vector3.new(49,.5,16),0,8,top,wall,Enum.Material.WoodPlanks)
  sign("EL RETRATO OLVIDADO",0,12,top+7,18)
 elseif definition.theme=="island" then
  p("Litoral",Vector3.new(260,.1,15),0,.08,-112,Color3.fromRGB(41,91,110),Enum.Material.Glass,true).Transparency=.35
  for n=1,16 do p("Tablón del muelle",Vector3.new(12,.2,2.8),20,.3,-122+n*2.8,wall,Enum.Material.WoodPlanks) end
  local top=stairs(102,-106,10)
  p("Torre de observación",Vector3.new(16,.6,16),102,10,top,wall,Enum.Material.WoodPlanks)
  for _,x in ipairs({96,108}) do p("Soporte de torre",Vector3.new(1,10,1),x,5,top+5,wall,Enum.Material.Wood) end
 elseif definition.theme=="arena" then
  p("Cancha",Vector3.new(22,.1,96),0,.1,0,Color3.fromRGB(165,117,72),Enum.Material.WoodPlanks,true)
  for _,z in ipairs({-47,47}) do
   p("Poste de aro",Vector3.new(.6,9,.6),0,4.5,z,accent,Enum.Material.Metal)
   p("Tablero",Vector3.new(7,4,.4),0,8,z,Color3.fromRGB(202,211,206))
   p("Aro",Vector3.new(3,.2,2),0,6.5,z-1.2,accent,Enum.Material.Neon,true)
  end
 elseif definition.theme=="town" then
  for _,x in ipairs({-13,13}) do for z=-65,65,26 do
   p("Árbol del parque",Vector3.new(1.5,8,1.5),x,4,z,wall,Enum.Material.Wood)
   p("Copa redondeada",Vector3.new(7,9,7),x,11,z,Color3.fromRGB(45,88,59),Enum.Material.Grass,true).Shape=Enum.PartType.Ball
  end end
 end
 for _,x in ipairs({-108,108}) do for _,z in ipairs({-90,0,90}) do lamp(x,z) end end
 local expansion=require(script.Parent.MapExpansion).extend(model,definition,{part=p,sign=sign,building=building,crate=crate,tableAt=tableAt,lamp=lamp,stairs=stairs},palette)
 generators=expansion.generatorPositions;puzzles=expansion.puzzlePositions
 sign(definition.name:upper(),0,12,-186,34)
 local gate=p("Puerta de salida",Vector3.new(26,12,1.2),0,6,191,Color3.fromRGB(112,44,39))
 local gateText=World.label(gate,"SALIDA CERRADA")
 local exit=p("Umbral fisico de escape",Vector3.new(24,10,6),0,5,197,Color3.fromRGB(62,189,121),Enum.Material.Neon,true)
 exit.Transparency=.8;exit.CanTouch=true
 local function setGate(open,mode)
  gate.CanCollide=not open;gate.Transparency=open and .88 or 0
  gateText.Text=open and "SALIDA ABIERTA · ATRAVIÉSALA" or mode=="LMS" and "LMS · ABRE A 0:00" or "SALIDA\n2 GENERADORES + 3 CÁPSULAS DEPOSITADAS\nRELOJ ≤ 1:00"
 end
 setGate(false,"Normal")
 return {arena=model,center=center,gate=gate,exit=exit,setGate=setGate,mapId=definition.id,mapName=definition.name,
  generatorPositions=generators,puzzlePositions=puzzles,depotPosition=Vector3.new(0,0,172),playableHalf=186,pointsOfInterest=expansion.points,
  survivorSpawn=Vector3.new(-90,0,-108),killerSpawn=Vector3.new(100,0,100),
  itemSpawns={Vector3.new(-104,0,-48),Vector3.new(104,0,48),Vector3.new(20,0,-100),Vector3.new(-20,0,100),Vector3.new(-12,0,24),Vector3.new(24,0,-24)}}
end
return Maps
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Objectives</string>
          <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local World=require(script.Parent.World)
local Challenge=require(RS.Shared.ChallengeRules)
local Generator=require(RS.Shared.GeneratorVisuals)
local Objectives={};Objectives.__index=Objectives
local tones={Color3.fromRGB(221,79,70),Color3.fromRGB(74,139,226),Color3.fromRGB(235,195,70),Color3.fromRGB(91,189,124)}
function Objectives.new(world,rules,callbacks)
 local self=setmetatable({rules=rules,callbacks=callbacks,sessions={},connections={},prompts={},stations={},generators={},serial=0,destroyed=false},Objectives)
 self.folder=Instance.new("Folder");self.folder.Name="ObjetivosDeRonda";self.folder.Parent=world.arena
 local function connect(event,fn)table.insert(self.connections,event:Connect(fn))end
 local function prompt(part,action,title,fn)
  local p=Instance.new("ProximityPrompt");p.ActionText=action;p.ObjectText=title;p.MaxActivationDistance=10;p.RequiresLineOfSight=true;p.Parent=part
  table.insert(self.prompts,p)
  connect(p.Triggered,function(player)
   if not self.destroyed and rules.mode~="LMS" and p.Enabled and callbacks.canInteract(player,part) then fn(player,p) end
  end)
  return p
 end
 local function decor(name,size,pos,tint,parent)
  local part=World.part(parent or self.folder,name,size,pos,tint,Enum.Material.Neon)
  part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.CastShadow=false;return part
 end
 for i,pos in ipairs(world.generatorPositions) do
  local view=Generator.build(self.folder,world.center+pos,World,i)
  view.prompt=prompt(view.base,"Reparar generador","Generador "..i,function(player)self:open(player,"generator",i)end)
  self.generators[i]=view
 end
 local kinds={"memory","piano","reflex","maze"}
 local titles={"MEMORIA","PIANO","REFLEJOS","LABERINTO"}
 for i,pos in ipairs(world.puzzlePositions) do
  local base=World.part(self.folder,"Estacion de puzle "..i,Vector3.new(4,3,3),world.center+pos+Vector3.new(0,1.5,0),Color3.fromRGB(57,68,86))
  local marquee=decor("Cabecera de estación",Vector3.new(3.7,.65,.12),base.Position+Vector3.new(0,1.03,-1.59),Color3.fromRGB(33,45,50),base)
  marquee.Material=Enum.Material.Metal
  local stationLabel=World.label(marquee,titles[i])
  if i==1 then
   for pad=1,4 do decor("Pulsador de memoria",Vector3.new(.62,.62,.12),base.Position+Vector3.new((pad-2.5)*.8,-.1,-1.58),tones[pad],base) end
  elseif i==2 then
   for key=1,7 do
    local white=decor("Tecla de piano",Vector3.new(.43,1.1,.14),base.Position+Vector3.new((key-4)*.47,-.2,-1.58),Color3.fromRGB(218,219,207),base);white.Material=Enum.Material.SmoothPlastic
    if key%3~=0 then local black=decor("Tecla sostenida",Vector3.new(.22,.6,.1),base.Position+Vector3.new((key-3.6)*.47,.05,-1.7),Color3.fromRGB(24,29,32),base);black.Material=Enum.Material.SmoothPlastic end
   end
  elseif i==3 then
   for lamp=1,3 do
    local bulb=decor("Señal de reflejos",Vector3.new(.72,.72,.14),base.Position+Vector3.new((lamp-2),-.15,-1.6),tones[({1,3,4})[lamp]],base);bulb.Shape=Enum.PartType.Ball
   end
  else
   for row=1,4 do for column=1,6 do
    local tile=decor("Circuito del laberinto",Vector3.new(.44,.3,.08),base.Position+Vector3.new((column-3.5)*.49,.5-row*.34,-1.56),(row+column)%3==0 and tones[2] or Color3.fromRGB(37,56,66),base)
    tile.Material=(row+column)%3==0 and Enum.Material.Neon or Enum.Material.Metal
   end end
  end
  local capsule=decor("Capsula "..i,Vector3.new(1,1.7,1),base.Position+Vector3.new(0,2.5,0),tones[2])
  capsule.Size=Vector3.new(1.7,1,1);capsule.Shape=Enum.PartType.Cylinder;capsule.CFrame=capsule.CFrame*CFrame.Angles(0,0,math.pi/2)
  local capsuleParts={capsule}
  for _,offset in ipairs({-.9,.9}) do
   local cap=decor("Anillo de cápsula",Vector3.new(.18,1.1,1.1),capsule.Position+Vector3.new(0,offset,0),Color3.fromRGB(126,143,148),capsule)
   cap.Shape=Enum.PartType.Cylinder;cap.CFrame=cap.CFrame*CFrame.Angles(0,0,math.pi/2);cap.Material=Enum.Material.Metal;table.insert(capsuleParts,cap)
  end
  local function showCapsule(transparency)for _,piece in ipairs(capsuleParts) do piece.Transparency=transparency end end
  showCapsule(.8)
  local pickup=prompt(capsule,"Llevar al depósito","Cápsula de energía",function(player,p)
   if rules:collectCapsule(i,player.UserId) then
    p.Enabled=false;showCapsule(1);player:SetAttribute("CarriedCapsules",rules:carried(player.UserId));callbacks.changed()
    callbacks.send(player,"message","Cápsula recogida. Llévala al depósito junto a la salida.")
   end
  end)
  pickup.Enabled=false
  local solve=prompt(base,"Abrir puzle",titles[i],function(player)self:open(player,"puzzle",i)end)
  self.stations[i]={base=base,capsule=capsule,pickup=pickup,solve=solve,kind=kinds[i],label=stationLabel,showCapsule=showCapsule,capsuleParts=capsuleParts}
 end
 local depot=World.part(self.folder,"Deposito de capsulas",Vector3.new(7,4,4),world.center+world.depotPosition+Vector3.new(0,2,0),tones[4])
 World.label(depot,"DEPÓSITO DE ENERGÍA\nENTREGA LAS CÁPSULAS AQUÍ")
 prompt(depot,"Depositar cápsulas","Depósito de energía",function(player)
  local deposited=rules:depositCapsules(player.UserId)
  player:SetAttribute("CarriedCapsules",rules:carried(player.UserId))
  callbacks.send(player,"message",#deposited&gt;0 and (#deposited.." cápsula(s) depositadas.") or "No llevas cápsulas.")
  callbacks.changed()
 end)
 return self
end
function Objectives:publish(player,s)
 if s.family=="generator" then
  Generator.progress(self.generators[s.id],s.stage,s.challenge)
  if player.Character then player.Character:SetAttribute("RepairStage",s.stage);player.Character:SetAttribute("RepairPullAt",self.generators[s.id].model:GetAttribute("PullAt") or 0) end
 end
 self.callbacks.send(player,"challenge",{token=s.token,family=s.family,id=s.id,stage=s.stage,challenge=s.challenge,serverNow=workspace:GetServerTimeNow()})
end
function Objectives:open(player,family,id)
 local source=family=="generator" and self.generators[id] or self.stations[id]
 if not source or self.rules.mode=="LMS" or (family=="generator" and self.rules.generators[id]) or (family=="puzzle" and self.rules.puzzles[id]) then return end
 self:cancel(player)
 self.serial=self.serial+1
 local kind=family=="generator" and "wires" or source.kind
 local s={family=family,id=id,base=source.base,stage=1,token=tostring(self.serial)..":"..tostring(workspace:GetServerTimeNow())}
 s.challenge=Challenge.new(kind,workspace:GetServerTimeNow(),math.random)
 self.sessions[player]=s;self:publish(player,s)
end
function Objectives:answer(player,token,value)
 local s=self.sessions[player]
 if self.destroyed or not s or token~=s.token then return end
 if self.rules.mode=="LMS" or not self.callbacks.canInteract(player,s.base)
  or (s.family=="generator" and self.rules.generators[s.id]) or (s.family=="puzzle" and self.rules.puzzles[s.id]) then self:cancel(player);return end
 local result=Challenge.input(s.challenge,value,workspace:GetServerTimeNow())
 if result=="ignored" then return end
 if result=="expired" or result=="wrong" then self:cancel(player);self.callbacks.send(player,"message","Intento fallido. Vuelve a abrir la estación.");return end
 if result=="complete" then
  if s.family=="generator" and s.stage&lt;3 then
   s.stage=s.stage+1;s.challenge=Challenge.new(s.stage==2 and "switches" or "rope",workspace:GetServerTimeNow(),math.random);self:publish(player,s);return
  end
  if s.family=="generator" then Generator.progress(self.generators[s.id],s.stage,s.challenge) end
  self:cancel(player)
  if s.family=="generator" then
   if self.rules:completeGenerator(s.id) then
    local gen=self.generators[s.id];gen.prompt.Enabled=false;gen.screen.Color=tones[4];gen.label.Text="G"..s.id.." · ACTIVO"
    Generator.complete(gen)
    if self.callbacks.reward then self.callbacks.reward(player,"generator","generator:"..s.id) end
    self.callbacks.changed()
   end
  elseif self.rules:completePuzzle(s.id) then
   local station=self.stations[s.id];station.solve.Enabled=false;station.pickup.Enabled=true;station.showCapsule(0);station.label.Text="RESUELTO · RECOGE LA CÁPSULA"
   if self.callbacks.reward then self.callbacks.reward(player,"puzzle","puzzle:"..s.id) end
   self.callbacks.send(player,"message","Puzle resuelto. Recoge la cápsula y llévala al depósito.");self.callbacks.changed()
  end
 else self:publish(player,s) end
end
function Objectives:tick()
 if os.clock()&lt;(self.nextCheck or 0) then return end
 self.nextCheck=os.clock()+1
 for player,s in pairs(self.sessions) do
  if workspace:GetServerTimeNow()&gt;s.challenge.deadline or not self.callbacks.canInteract(player,s.base) then self:cancel(player) end
 end
end
function Objectives:drop(player)
 self:cancel(player)
 for _,id in ipairs(self.rules:dropCapsules(player.UserId)) do
  local station=self.stations[id];station.showCapsule(0);station.pickup.Enabled=self.rules.mode~="LMS"
 end
 player:SetAttribute("CarriedCapsules",0)
end
function Objectives:cancel(player)
 if self.sessions[player] then
  if player.Character then player.Character:SetAttribute("RepairStage",0) end
  self.sessions[player]=nil;self.callbacks.send(player,"challengeClose")
 end
end
function Objectives:disableForLMS()
 for player in pairs(self.sessions) do self:cancel(player) end
 for _,prompt in ipairs(self.prompts) do prompt.Enabled=false end
end
function Objectives:destroy()
 self.destroyed=true
 for player in pairs(self.sessions) do self:cancel(player) end
 for _,connection in ipairs(self.connections) do connection:Disconnect() end
 self.folder:Destroy()
end
return Objectives
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ProfileService</string>
          <ProtectedString name="Source">local DataStore=game:GetService("DataStoreService")
local HttpService=game:GetService("HttpService")
local RS=game:GetService("ReplicatedStorage")
local Data=require(RS.Shared.ProfileData)
local Profiles={}
Profiles.__index=Profiles
function Profiles.new(send)
 local self=setmetatable({records={},send=send,owner=game.JobId~="" and game.JobId or HttpService:GenerateGUID(false)},Profiles)
 local ok,store=pcall(function()return DataStore:GetDataStore(game:GetService("RunService"):IsStudio() and "FORGOTTEN_Profiles_v2_Studio" or "FORGOTTEN_Profiles_v2")end)
 if ok then self.store=store end
 task.spawn(function()
  while true do
   task.wait(45)
   for player,record in pairs(self.records) do if record.mode=="persistent" and not record.closing then task.spawn(function()self:save(player,false)end) end end
  end
 end)
 return self
end
function Profiles:publish(player)
 local r=self.records[player]
 if r and r.data then self.send(player,"profile",Data.public(r.data,r.mode)) end
end
function Profiles:load(player,onReady)
 local record={mode="loading",revision=0};self.records[player]=record
 local loaded,reason
 for attempt=1,3 do
  if not self.store then break end
  local ok,result=pcall(function()
   return self.store:UpdateAsync("user_"..player.UserId,function(old)
    local now=os.time()
    if old and type(old)~="table" then reason="Perfil incompatible";return nil end
    if old and old.session and old.session.owner~=self.owner and old.session.expires&gt;now then reason="Otra sesión está guardando tu progreso";return nil end
    local data,errorText=Data.normalize(old and old.data)
    if old and old.data==nil then reason="Perfil incompatible";return nil end
    if not data then reason=errorText;return nil end
    return {version=2,data=data,session={owner=self.owner,expires=now+180},updatedAt=now}
   end)
  end)
  if ok and result and result.session and result.session.owner==self.owner then loaded=result;break end
  if ok and reason then break end
  reason="Guardado no disponible"
  if attempt&lt;3 then task.wait(attempt*.5) end
 end
 if loaded then record.mode="persistent";record.data=loaded.data;record.expires=loaded.session.expires
 else
  record.mode=reason=="Otra sesión está guardando tu progreso" and "locked" or "session"
  record.data=Data.new()
  if record.mode=="locked" then record.data.coins=0 end
 end
 if record.closing or not player.Parent then self:close(player);return end
 self:publish(player)
 if record.mode~="persistent" then self.send(player,"message",record.mode=="locked" and "El progreso está abierto en otra sesión. La tienda queda bloqueada." or "Modo de sesión: las monedas y compras de esta prueba no se guardarán. El progreso existente no se sobrescribe.") end
 if onReady then onReady(record.data) end
end
function Profiles:get(player)
 local r=self.records[player]
 return r and r.data
end
function Profiles:mutable(player)
 local r=self.records[player]
 if not r or not r.data or r.closing or r.mode=="locked" or r.mode=="loading" then return nil end
 if r.mode=="persistent" and os.time()&gt;=r.expires then r.mode="locked";self:publish(player);return nil end
 return r
end
function Profiles:purchase(player,id)
 local r=self:mutable(player);if not r then return false,"La tienda espera a que tu progreso esté disponible." end
 local ok,message=Data.purchase(r.data,id)
 if ok then r.revision=r.revision+1;self:publish(player) end
 return ok,message
end
function Profiles:equip(player,character,id)
 local r=self:mutable(player);if not r then return false,"El inventario no está disponible." end
 local ok,message=Data.equip(r.data,character,id)
 if ok then r.revision=r.revision+1;self:publish(player) end
 return ok,message
end
function Profiles:select(player,id)
 local r=self:mutable(player)
 if r and Data.select(r.data,id) then r.revision=r.revision+1 end
end
function Profiles:reward(player,receipt,kind,character)
 local r=self:mutable(player);if not r then return false end
 local ok,coins,unlocked=Data.reward(r.data,receipt,kind,character)
 if ok then
  r.revision=r.revision+1;self:publish(player)
  self.send(player,"reward",{coins=coins,reason=kind,unlocked=unlocked})
 end
 return ok
end
function Profiles:save(player,release)
 local r=self.records[player]
 if not r or r.mode~="persistent" or not self.store or r.saving then return false end
 r.saving=true
 local snapshot=Data.normalize(r.data)
 local ok,result=pcall(function()
  return self.store:UpdateAsync("user_"..player.UserId,function(old)
   if not old or not old.session or old.session.owner~=self.owner or old.session.expires&lt;=os.time() then return nil end
   local session
   if not release then session={owner=self.owner,expires=os.time()+180} end
   return {version=2,data=snapshot,session=session,updatedAt=os.time()}
  end)
 end)
 r.saving=false
 if ok and result then
  if not release then r.expires=result.session.expires end
  return true
 end
 if ok then r.mode="locked";self:publish(player) else warn("No se pudo guardar el perfil de "..player.UserId.."; se mantiene pendiente.") end
 return false
end
function Profiles:close(player)
 local r=self.records[player];if not r then return end
 r.closing=true
 if r.mode=="loading" then return end
 local deadline=os.clock()+12
 while r.saving and os.clock()&lt;deadline do task.wait(.1) end
 if r.mode=="persistent" then
  for attempt=1,3 do if self:save(player,true) then break end;task.wait(.5) end
 end
 self.records[player]=nil
end
return Profiles
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">RoundItems</string>
          <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Config=require(RS.Shared.ItemConfig)
local World=require(script.Parent.World)
local Items={};Items.__index=Items
function Items.new(world,context)
 local self=setmetatable({c=context,connections={}},Items)
 self.folder=Instance.new("Folder");self.folder.Name="ObjetosDePartida";self.folder.Parent=world.arena
 for i,pos in ipairs(world.itemSpawns) do
  local kind=i%2==1 and "medkit" or "energyDrink"
  local color=kind=="medkit" and Color3.fromRGB(176,57,53) or Color3.fromRGB(73,166,116)
  local part=World.part(self.folder,Config[kind].name,kind=="medkit" and Vector3.new(2.2,1.4,1.6) or Vector3.new(.9,1.7,.9),world.center+pos+Vector3.new(0,1.2,0),color,Enum.Material.Metal)
  part.CanCollide=false;part.CanTouch=false
  local function detail(name,size,offset,tint,shape)
   local piece=World.part(part,name,size,part.Position+offset,tint,Enum.Material.Metal)
   piece.CanCollide=false;piece.CanTouch=false;piece.CanQuery=false;piece.CastShadow=false
   if shape then piece.Shape=shape;piece.CFrame=piece.CFrame*CFrame.Angles(0,0,math.pi/2) end
   return piece
  end
  local white=Color3.fromRGB(225,226,214);local dark=Color3.fromRGB(49,56,59)
  if kind=="energyDrink" then
   part.Size=Vector3.new(1.7,.9,.9);part.Shape=Enum.PartType.Cylinder;part.CFrame=part.CFrame*CFrame.Angles(0,0,math.pi/2)
   for _,y in ipairs({-.84,.84}) do detail("Borde de lata",Vector3.new(.06,.94,.94),Vector3.new(0,y,0),white,Enum.PartType.Cylinder) end
   detail("Anilla",Vector3.new(.15,.035,.28),Vector3.new(0,.89,0),dark)
   local label=detail("Etiqueta de bebida",Vector3.new(.66,.85,.025),Vector3.new(0,0,-.46),dark)
   World.label(label,"ENERGY")
  else
   detail("Cruz vertical",Vector3.new(.25,.75,.03),Vector3.new(0,0,-.82),white)
   detail("Cruz horizontal",Vector3.new(.75,.25,.03),Vector3.new(0,0,-.82),white)
   for _,x in ipairs({-.8,.8}) do detail("Correa del botiquín",Vector3.new(.13,1.44,1.64),Vector3.new(x,0,0),dark) end
   for _,x in ipairs({-.4,.4}) do detail("Soporte de asa",Vector3.new(.12,.35,.12),Vector3.new(x,.85,0),dark) end
   detail("Asa del botiquín",Vector3.new(.9,.12,.16),Vector3.new(0,1.03,0),dark)
  end
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Recoger";prompt.ObjectText=Config[kind].name;prompt.MaxActivationDistance=9;prompt.Parent=part
  local claimed=false
  table.insert(self.connections,prompt.Triggered:Connect(function(player)
   if claimed or not context.canInteract(player,part) then return end
   local record=context.records()[player];record.items=record.items or {}
   if #record.items&gt;=Config.slots then context.send(player,"message","Tus dos ranuras están ocupadas.");return end
   for _,item in ipairs(record.items) do if item==kind then context.send(player,"message","Solo puedes llevar una unidad de cada objeto.");return end end
   claimed=true;table.insert(record.items,kind);part:Destroy();context.send(player,"message",Config[kind].name.." recogido.")
   context.send(player,"sfx","item")
  end))
 end
 return self
end
function Items:use(player,slot)
 if not self.c.playing(player) or type(slot)~="number" or slot%1~=0 or slot&lt;1 or slot&gt;2 then return end
 local r=self.c.records()[player]
 if r.entry.role~="Superviviente" or r.itemUse or r.channel then return end
 local kind=r.items and r.items[slot]
 if not Config[kind] then return end
 local root,h=self.c.body(player);local now=os.clock()
 if kind=="medkit" then
  if h.Health&gt;=h.MaxHealth then return end
  r.itemUse={kind=kind,slot=slot,started=now,untilTime=now+7,position=root.Position}
  player.Character:SetAttribute("ItemAction","medkit");player.Character:SetAttribute("ItemActionUntil",workspace:GetServerTimeNow()+7)
  self.c.send(player,"message","Usando Medkit: permanece quieto durante 7 segundos.")
 else
  table.remove(r.items,slot);r.drinkUntil=now+6;r.energy.value=100;r.energy.exhausted=false
  player.Character:SetAttribute("ItemAction","drink");player.Character:SetAttribute("ItemActionUntil",workspace:GetServerTimeNow()+1.1)
  self.c.send(player,"message","Energy Drink · 6 segundos de energía infinita y Speed III.")
  self.c.send(player,"sfx","item")
 end
end
function Items:tick()
 local now=os.clock()
 for player,r in pairs(self.c.records()) do
  if r.itemUse then
   if not self.c.playing(player) then r.itemUse=nil
   else
    local root,h=self.c.body(player);local use=r.itemUse
    if (root.Position-use.position).Magnitude&gt;3 or (r.lastDamage or 0)&gt;use.started then r.itemUse=nil;player.Character:SetAttribute("ItemActionUntil",0);self.c.send(player,"message","Medkit interrumpido; conservas el objeto.")
    elseif now&gt;=use.untilTime then
     if r.items[use.slot]=="medkit" then table.remove(r.items,use.slot);h.Health=h.MaxHealth;self.c.send(player,"sfx","item") end
     r.itemUse=nil
    end
   end
  end
 end
end
function Items:destroy()
 for _,connection in ipairs(self.connections) do connection:Disconnect() end
 self.folder:Destroy()
end
return Items
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">World</string>
          <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local Lighting=game:GetService("Lighting")
local Factory=require(RS.Shared.CharacterFactory)
local World={}

function World.part(parent,name,size,position,color,material)
 local p=Instance.new("Part");p.Name=name;p.Size=size;p.Position=position
 p.Color=color;p.Material=material or Enum.Material.Metal;p.Anchored=true
 if World.variants and World.variants[p.Material] then p.MaterialVariant=World.variants[p.Material] end
 p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=parent
 return p
end

function World.label(part,message)
 local surface=Instance.new("SurfaceGui");surface.Face=Enum.NormalId.Front;surface.CanvasSize=Vector2.new(600,260);surface.Parent=part
 local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1
 text.TextColor3=Color3.fromRGB(242,229,193);text.TextScaled=true;text.TextWrapped=true;text.Text=message;text.Parent=surface
 return text
end

function World.build(roster,remote)
 local preview=workspace:FindFirstChild("LobbyPreview");if preview then preview:Destroy() end
 local old=workspace:FindFirstChild("Forgotten");if old then old:Destroy() end
 local world=Instance.new("Folder");world.Name="Forgotten";world.Parent=workspace
 Lighting.ClockTime=0.5;Lighting.Brightness=2.1
 Lighting.Ambient=Color3.fromRGB(38,43,53);Lighting.OutdoorAmbient=Color3.fromRGB(57,72,97)
 Lighting.GlobalShadows=true;Lighting.ShadowSoftness=.35;Lighting.ExposureCompensation=.18
 Lighting.EnvironmentDiffuseScale=.58;Lighting.EnvironmentSpecularScale=.65
 Lighting.FogColor=Color3.fromRGB(27,35,46);Lighting.FogEnd=420
 local grade=Lighting:FindFirstChild("ForgottenGrade") or Instance.new("ColorCorrectionEffect")
 grade.Name="ForgottenGrade";grade.Contrast=.12;grade.Saturation=-.12;grade.TintColor=Color3.fromRGB(255,241,222);grade.Parent=Lighting
 local bloom=Lighting:FindFirstChild("FarolesSuaves") or Instance.new("BloomEffect")
 bloom.Name="FarolesSuaves";bloom.Intensity=.18;bloom.Size=20;bloom.Threshold=1.5;bloom.Parent=Lighting
 local atmosphere=Lighting:FindFirstChild("ForgottenAtmosphere") or Instance.new("Atmosphere")
 atmosphere.Name="ForgottenAtmosphere";atmosphere.Density=.24;atmosphere.Offset=.15;atmosphere.Haze=1.2;atmosphere.Color=Color3.fromRGB(168,181,194);atmosphere.Parent=Lighting
 local variants=require(RS.Shared.MaterialPack)()
 World.variants=variants
 local lobby=require(RS.Shared.Lobby)(world,roster,remote,variants,false)
 local camp=Instance.new("Model");camp.Name="CampamentoSoloLobby";camp.Parent=world
 local wood=Color3.fromRGB(81,55,40)
 local stone=Color3.fromRGB(80,88,86)
 for _,x in ipairs({-64,64}) do
  World.part(camp,"Suelo de cabaña abandonada",Vector3.new(23,1,21),Vector3.new(x,0,-55),wood,Enum.Material.WoodPlanks)
  World.part(camp,"Techo de chapa",Vector3.new(25,1,24),Vector3.new(x,12,-55),stone)
  for _,dx in ipairs({-11,11}) do World.part(camp,"Pared lateral",Vector3.new(1,12,21),Vector3.new(x+dx,6,-55),wood,Enum.Material.WoodPlanks) end
  World.part(camp,"Pared trasera",Vector3.new(23,12,1),Vector3.new(x,6,-45),wood,Enum.Material.WoodPlanks)
  for _,dx in ipairs({-8,8}) do World.part(camp,"Fachada rota",Vector3.new(7,10,1),Vector3.new(x+dx,5,-65),wood,Enum.Material.WoodPlanks) end
  local sign=World.part(camp,"Aviso",Vector3.new(7,2,.3),Vector3.new(x,10,-65.7),stone)
  World.label(sign,"CABAÑA ABANDONADA")
  World.part(camp,"Litera",Vector3.new(6,2,3),Vector3.new(x-6,1.6,-51),wood,Enum.Material.WoodPlanks)
 end
 for i=1,32 do
  local a=i/32*math.pi*2
  local pos=Vector3.new(math.cos(a)*84,0,math.sin(a)*84)
  local height=14+(i%4)*1.2
  local trunk=World.part(camp,"Tronco del campamento",Vector3.new(height,2.1,2.1),pos+Vector3.new(0,height/2,0),wood,Enum.Material.Wood)
  trunk.Shape=Enum.PartType.Cylinder;trunk.CFrame=trunk.CFrame*CFrame.Angles(0,0,math.pi/2)
  for tier=1,3 do
   local width=13-tier*2
   local leaves=World.part(camp,"Copa escalonada",Vector3.new(width,7,width),pos+Vector3.new(0,height-3+tier*3.4,0),Color3.fromRGB(22+i%3*3,46+i%5*3,34+i%4*2),Enum.Material.Grass)
   leaves.Shape=Enum.PartType.Ball;leaves.CanCollide=false;leaves.CanTouch=false;leaves.CanQuery=false;leaves.CastShadow=tier==1
  end
  if i%2==0 then
   local rock=World.part(camp,"Piedra musgosa",Vector3.new(3.2,1.3,2.1),pos*.88+Vector3.new(0,.2,0),Color3.fromRGB(67,75,65),Enum.Material.Slate)
   rock.Shape=Enum.PartType.Ball;rock.CanCollide=false;rock.CanQuery=false;rock.CanTouch=false
   for leaf=1,5 do
    local angle=leaf*math.pi*2/5
    local fern=World.part(camp,"Helecho de sotobosque",Vector3.new(.24,2.1,.7),pos*.92+Vector3.new(math.cos(angle)*.4,.7,math.sin(angle)*.4),Color3.fromRGB(39,67,44),Enum.Material.Grass)
    fern.Shape=Enum.PartType.Ball;fern.CFrame=fern.CFrame*CFrame.Angles(.5,angle,.25)
    fern.CanCollide=false;fern.CanTouch=false;fern.CanQuery=false;fern.CastShadow=false
   end
  end
 end
 local sign=World.part(camp,"Zona segura",Vector3.new(18,4,.4),Vector3.new(0,6,-46),wood,Enum.Material.WoodPlanks)
 sign.CanCollide=false;sign.CanQuery=false
 World.label(sign,"CAMPAMENTO · LOBBY\nEl escenario de partida está separado")
 local npcPositions={Vector3.new(7,.7,30),Vector3.new(33,.7,-16),Vector3.new(-15,.7,-10),Vector3.new(-14,.7,10),Vector3.new(12,16.5,30),Vector3.new(29,.7,24)}
 local npcs={}
 local function installNPC(index)
  local entry=roster[index]
  local npc=Factory.create(entry);npc.Name=entry.name
  Factory.place(npc,npcPositions[index]);npc.HumanoidRootPart.Anchored=true
  for _,part in ipairs(npc:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide=false end end
  local prompt=Instance.new("ProximityPrompt");prompt.ActionText="Escuchar historia";prompt.ObjectText=entry.name
  prompt.MaxActivationDistance=9;prompt.Parent=npc.Head
  prompt.Triggered:Connect(function(player)
   remote:FireClient(player,"message",entry.name..(entry.confirmedLore and "\n" or " [historia provisional]\n")..entry.lore)
  end)
  npc.Parent=lobby
  if npcs[index] then npcs[index]:Destroy() end
  npcs[index]=npc
 end
 for i=1,#roster do installNPC(i) end

 require(script.Parent.Camp).extend(world,remote,World)
 -- Keep warm pools of light, but bound the expensive shadow casters.
 local shadowLights=0
 for _,object in ipairs(world:GetDescendants()) do
  if object:IsA("PointLight") and object.Shadows then
   shadowLights=shadowLights+1;object.Shadows=shadowLights&lt;=5
  end
 end
 local data={root=world,lobby=lobby,lobbyPosition=Vector3.new(0,.7,-25),spawn=lobby:FindFirstChild("Refugio"),refreshNPC=installNPC}
 local Maps=require(script.Parent.Maps)
 local mapCatalog=require(RS.Shared.MapCatalog)
 function data.loadMap(id)
  local definition=mapCatalog[1]
  for _,entry in ipairs(mapCatalog) do if entry.id==id then definition=entry end end
  if data.arena then data.arena:Destroy() end
  local built=Maps.build(world,definition,World)
  for key,value in pairs(built) do data[key]=value end
 end
 data.loadMap(mapCatalog[1].id)
 return data
end
return World
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder">
      <Properties>
        <string name="Name">CharacterModels</string>
      </Properties>
    </Item>
    <Item class="Folder">
      <Properties>
        <string name="Name">CatalogCharacters</string>
      </Properties>
    </Item>
    <Item class="Folder">
      <Properties>
        <string name="Name">ReferenceCharacters</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript">
        <Properties>
          <string name="Name">UI</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local RS=game:GetService("ReplicatedStorage")
local UIS=game:GetService("UserInputService")
local RunService=game:GetService("RunService")
local player=Players.LocalPlayer
local shared=RS:WaitForChild("Shared")
local remote=RS:WaitForChild("GameEvent")
local T=require(shared.ClientTheme)
local AbilityConfig=require(shared.AbilityConfig)
local ItemConfig=require(shared.ItemConfig)
local Portraits=require(shared.Portraits)
local roster=require(shared.Roster);local byId={};for _,entry in ipairs(roster) do byId[entry.id]=entry end
require(shared.BasicAnimation)()
require(shared.EditableAppearance).start()
require(shared.GeneratorVisuals).animate()
local updateEnvironment=require(shared.ClientEnvironment).start()
pcall(function()game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList,false)end)
local function follow(character)
 local h=character:WaitForChild("Humanoid",10)
 if h and player.Character==character and workspace.CurrentCamera then workspace.CurrentCamera.CameraType=Enum.CameraType.Custom;workspace.CurrentCamera.CameraSubject=h end
end
player.CharacterAdded:Connect(follow);if player.Character then task.spawn(follow,player.Character) end
local old=player:WaitForChild("PlayerGui"):FindFirstChild("ForgottenUI");if old then old:Destroy() end
local gui=Instance.new("ScreenGui");gui.Name="ForgottenUI";gui.ResetOnSpawn=false;gui.ZIndexBehavior=Enum.ZIndexBehavior.Sibling;gui.Parent=player.PlayerGui
local state={phase="Lobby",mode="Normal",remaining=15,generators=0,capsules=0,gateOpen=false,musicKey="",killerUserId=0}
local combat={character="pelotocino",cooldowns={},statuses={},items={},carried=0}
local selected="pelotocino";local sprinting=false;local scoreboardOpen=false
local top=T.frame(gui,"Cabecera",UDim2.fromScale(.02,.02),UDim2.fromScale(.96,.075),T.bg)
local phaseLabel=T.label(top,"Fase","FORGOTTEN",UDim2.fromScale(.01,.05),UDim2.fromScale(.3,.9),18,T.gold)
local clock=T.label(top,"Reloj","00:15",UDim2.fromScale(.39,.02),UDim2.fromScale(.22,.94),28)
local coins=T.label(top,"Monedas","CARGANDO PROGRESO…",UDim2.fromScale(.67,.04),UDim2.fromScale(.31,.9),14,T.gold)
local goals=T.label(gui,"Progreso","CAMPAMENTO SEGURO",UDim2.fromScale(.2,.1),UDim2.fromScale(.78,.045),14)
local objective=T.label(gui,"Objetivo","Elige tu historia",UDim2.fromScale(.2,.145),UDim2.fromScale(.78,.04),14,T.gold)
local menus=require(shared.ClientMenus)(gui,remote)
local challenge=require(shared.ClientChallenge)(gui,remote)
local results=require(shared.ClientResults)(gui)
local effects=require(shared.ClientEffects)(function()return menus.effectsEnabled()end)
local musicLabel=T.label(gui,"Musica","",UDim2.fromScale(.31,.975),UDim2.fromScale(.67,.025),10,T.muted)
local updateMusic=require(shared.ClientMusic)(musicLabel)
local toast=T.frame(gui,"Notificacion",UDim2.fromScale(.31,.22),UDim2.fromScale(.66,.12),T.bg);toast.Visible=false;toast.ZIndex=50
local toastText=T.label(toast,"Texto","",UDim2.fromScale(.03,.08),UDim2.fromScale(.94,.84),15)
local toastUntil=0
local escapeData,escapeUntil
local escapeButton=T.button(gui,"EscaparDelAtaque","",UDim2.fromScale(.32,.59),UDim2.fromScale(.36,.08),function()
 if escapeData then remote:FireServer("struggle",escapeData.token) end
end,T.red)
escapeButton.Visible=false
local function notify(message,duration)toastText.Text=message;toast.Visible=true;toastUntil=os.clock()+(duration or 5)end
T.button(gui,"Menu","MENÚ · M",UDim2.fromScale(.02,.11),UDim2.fromScale(.16,.06),function()menus.open()end)
local function showScoreboard()
 scoreboardOpen=true;results.show({rows=state.scoreboard or {},map=state.mapName,message="Estado de la partida"},true)
end
T.button(gui,"Marcador","MARCADOR · TAB",UDim2.fromScale(.02,.18),UDim2.fromScale(.16,.05),showScoreboard,T.bg)
local hud=T.frame(gui,"HUD",UDim2.fromScale(.02,.77),UDim2.fromScale(.96,.2),T.bg)
local identity=T.label(hud,"Identidad","",UDim2.fromScale(.015,.01),UDim2.fromScale(.27,.17),14,T.gold)
local function statusBar(name,y,color)
 local label=T.label(hud,name,name,UDim2.fromScale(.015,y),UDim2.fromScale(.27,.16),13)
 local track=T.frame(hud,name.."Track",UDim2.fromScale(.025,y+.17),UDim2.fromScale(.25,.055),T.edge)
 local fill=T.frame(track,name.."Fill",UDim2.new(),UDim2.fromScale(1,1),color)
 return label,fill
end
local health,healthFill=statusBar("VIDA",.23,T.green)
local energy,energyFill=statusBar("ENERGÍA",.57,T.gold)
local skills=T.frame(hud,"Habilidades",UDim2.fromScale(.3,.06),UDim2.fromScale(.68,.62),T.bg)
local grid=Instance.new("UIGridLayout");grid.CellPadding=UDim2.fromOffset(5,5);grid.SortOrder=Enum.SortOrder.LayoutOrder;grid.Parent=skills
local skillButtons={}
local function aim()
 local mouse=player:GetMouse();local camera=workspace.CurrentCamera
 if UIS.TouchEnabled and camera then return camera.CFrame.LookVector end
 return mouse.UnitRay.Direction
end
local function cast(slot)if player:GetAttribute("InRound") then remote:FireServer("skill",slot,aim()) end end
for i=1,6 do
 local b=T.button(skills,"Habilidad"..i,"",UDim2.new(),UDim2.new(),function()cast(i)end,T.panel)
 b.LayoutOrder=i;skillButtons[i]=b
end
local itemButtons={}
for i=1,2 do itemButtons[i]=T.button(hud,"Objeto"..i,"",UDim2.fromScale(.3+(i-1)*.19,.74),UDim2.fromScale(.18,.21),function()remote:FireServer("item",i)end,T.panel) end
local function sprint(value)sprinting=value;remote:FireServer("sprint",value)end
local sprintButton=T.button(hud,"Sprint","SHIFT · CORRER",UDim2.fromScale(.69,.74),UDim2.fromScale(.14,.21),function()sprint(not sprinting)end,T.edge)
local attackButton=T.button(hud,"Atacar","CLIC · ATACAR",UDim2.fromScale(.84,.74),UDim2.fromScale(.14,.21),function()remote:FireServer("attack",aim())end,T.red)
local statusLabel=T.label(gui,"Estados","",UDim2.fromScale(.3,.71),UDim2.fromScale(.68,.04),13,T.gold)
local function refreshHUD()
 local active=state.phase=="Ronda" and player:GetAttribute("InRound")==true
 updateEnvironment(state,active)
 hud.Visible=active;statusLabel.Visible=active
 local id=player:GetAttribute("CharacterId") or selected;local entry=byId[id]
 identity.Text=entry and entry.name or ""
 local list=AbilityConfig[id] or {}
 local small=workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize.X&lt;850
 hud.Position=UDim2.fromScale(.02,small and .71 or .77);hud.Size=UDim2.fromScale(.96,small and .26 or .2)
 local columns=small and 3 or math.max(1,#list)
 grid.CellSize=UDim2.new(1/columns,-5,0,small and 40 or 58)
 for i,b in ipairs(skillButtons) do
  local a=list[i];b.Visible=a~=nil
  if a then
   local cooldown=combat.character==id and (combat.cooldowns[i] or 0) or 0
   b.Text=a.icon.."  "..AbilityConfig.keys[i].."\n"..a.name..(cooldown&gt;0 and " · "..cooldown.."s" or "")
   b.TextSize=small and 11 or 12;b.BackgroundColor3=cooldown&gt;0 and T.bg or T.panel
  end
 end
 for i,b in ipairs(itemButtons) do
  local item=combat.items[i]
  b.Text=({"Z","X"})[i].." · "..(item and ItemConfig[item].name or "VACÍO")
 end
 attackButton.Visible=entry and entry.role=="Asesino" or false
 sprintButton.Text=sprinting and "PARAR" or "SHIFT · CORRER"
 statusLabel.Text=table.concat(combat.statuses or {},"  •  ")
 if not active then challenge.close();escapeData=nil;escapeButton.Visible=false;if sprinting then sprint(false) end end
end
local function refreshState()
 local remaining=math.max(0,math.ceil(state.remaining or 0))
 clock.Text=string.format("%02d:%02d",math.floor(remaining/60),remaining%60)
 phaseLabel.Text="FORGOTTEN · "..(state.phase=="Ronda" and state.mode or state.phase)
 if state.phase=="Lobby" then
  goals.Text="CAMPAMENTO · ZONA SEGURA";objective.Text="Selecciona personaje, visita la tienda y vota un mapa."
 elseif state.phase=="Fin" then goals.Text=state.mapName or "";objective.Text=state.result or "Regreso al campamento"
 elseif state.mode=="LMS" then
  goals.Text="ÚLTIMO SUPERVIVIENTE · SIN REQUISITOS"
  objective.Text=state.gateOpen and "¡ATRAVIESA LA SALIDA!" or "Resiste. La puerta abre a 0:00."
 else
  goals.Text="Generadores "..state.generators.."/4 (mín. 2) · Cápsulas depositadas "..state.capsules.."/3 · Llevas "..(combat.carried or 0)
  objective.Text=state.gateOpen and "¡ATRAVIESA LA SALIDA PARA ESCAPAR!" or (combat.carried or 0)&gt;0 and "Lleva tus cápsulas al depósito junto a la salida." or state.generators&lt;2 and "Repara generadores: cables, interruptores y cuerda." or state.capsules&lt;3 and "Resuelve puzles, recoge cápsulas y deposítalas." or "Requisitos completos. Resiste hasta 1:00."
 end
 if state.phase=="Ronda" and not player:GetAttribute("InRound") then objective.Text="Espera la próxima ronda en el campamento." end
 menus.setState(state);refreshHUD()
end
player:GetAttributeChangedSignal("InRound"):Connect(refreshHUD)
local keySlots={Q=1,R=2,F=3,G=4,T=5,Y=6}
UIS.InputBegan:Connect(function(input,processed)
 if escapeData and input.KeyCode==Enum.KeyCode.E and not UIS:GetFocusedTextBox() then remote:FireServer("struggle",escapeData.token);return end
 if processed then return end
 local key=input.KeyCode.Name
 if key=="M" then menus.open();return end
 if key=="Tab" then if results.visible() then results.hide();scoreboardOpen=false else showScoreboard() end;return end
 if not player:GetAttribute("InRound") or challenge.visible() then return end
 if keySlots[key] then cast(keySlots[key])
 elseif key=="Z" then remote:FireServer("item",1)
 elseif key=="X" then remote:FireServer("item",2)
 elseif key=="LeftShift" then sprint(true)
 elseif input.UserInputType==Enum.UserInputType.MouseButton1 and not results.visible() then remote:FireServer("attack",aim()) end
end)
UIS.InputEnded:Connect(function(input)if input.KeyCode==Enum.KeyCode.LeftShift then sprint(false) end end)
UIS.WindowFocusReleased:Connect(function()if sprinting then sprint(false) end end)
local scoreboardAt=0
remote.OnClientEvent:Connect(function(kind,data)
 if kind=="state" then
  state=data;refreshState()
  if scoreboardOpen and results.visible() and os.clock()&gt;scoreboardAt then showScoreboard();scoreboardAt=os.clock()+1 end
 elseif kind=="message" then notify(tostring(data),6)
 elseif kind=="selected" and byId[data] then selected=data;menus.setSelected(data);refreshHUD()
 elseif kind=="profile" then
  menus.setProfile(data)
  coins.Text=data.coins.." FORGOTTEN COINS\n"..(data.mode=="persistent" and "Guardado automático" or data.mode=="locked" and "Progreso bloqueado" or "Progreso de sesión")
 elseif kind=="reward" then
  local extra=#data.unlocked&gt;0 and "\n¡Nueva Milestone desbloqueada!" or ""
  notify("+"..data.coins.." Forgotten Coins"..extra,5);effects.sound("reward")
 elseif kind=="combat" then combat=data;refreshHUD();refreshState()
 elseif kind=="challenge" then challenge.open(data);effects.sound("ui")
 elseif kind=="challengeClose" then challenge.close()
 elseif kind=="openPanel" then menus.open(data)
 elseif kind=="effect" then effects.effect(data)
 elseif kind=="sfx" then effects.sound(data)
 elseif kind=="reveal" then effects.reveal(data)
 elseif kind=="escape" then
  escapeData=data;escapeUntil=os.clock()+data.duration;escapeButton.Text="¡ESCAPA!  E · "..data.taps.." / "..data.required;escapeButton.Visible=true
 elseif kind=="escapeClose" then escapeData=nil;escapeButton.Visible=false
 elseif kind=="results" then scoreboardOpen=false;results.show(data,false);challenge.close();effects.sound("results") end
end)
local elapsed=0;local audioElapsed=0;local footstepAt=0
RunService.Heartbeat:Connect(function(dt)
 elapsed=elapsed+dt;audioElapsed=audioElapsed+dt
 if elapsed&gt;=.1 then
  elapsed=0
  if toast.Visible and os.clock()&gt;toastUntil then toast.Visible=false end
  if escapeData and os.clock()&gt;escapeUntil then escapeData=nil;escapeButton.Visible=false end
  local c=player.Character;local h=c and c:FindFirstChildOfClass("Humanoid");local root=c and c:FindFirstChild("HumanoidRootPart")
  local hp=h and math.max(0,h.Health) or 0;local max=h and h.MaxHealth or 100;local stamina=player:GetAttribute("Energy") or 100
  health.Text="VIDA  "..math.ceil(hp).." / "..max;healthFill.Size=UDim2.fromScale(hp/math.max(1,max),1);healthFill.BackgroundColor3=hp&lt;30 and T.red or T.green
  energy.Text="ENERGÍA  "..stamina.." / 100";energyFill.Size=UDim2.fromScale(stamina/100,1)
  if root and h and h.Health&gt;0 and h.FloorMaterial~=Enum.Material.Air and root.AssemblyLinearVelocity.Magnitude&gt;3 and os.clock()&gt;footstepAt then effects.sound("footstep");footstepAt=os.clock()+.45 end
 end
 if audioElapsed&gt;=.25 then audioElapsed=0;updateMusic(state) end
end)
refreshState();remote:FireServer("ready")
</ProtectedString>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>