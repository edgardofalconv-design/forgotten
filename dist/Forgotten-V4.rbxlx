      <Item class="ModuleScript">
        <Properties>
          <string name="Name">AbilityConfig</string>
          <ProtectedString name="Source">-- V1-approved values are retained where available. Additional V2 values are experimental.
-- Q/R/F/G/T/Y map to slots. M1 uses the first killer ability.
local function a(id,name,icon,kind,cooldown,range,amount,duration,cost)
 return {id=id,name=name,icon=icon,kind=kind,cooldown=cooldown,range=range or 0,amount=amount or 0,duration=duration or 0,cost=cost or 0,provisional=true}
end
return {
 keys={"Q","R","F","G","T","Y"},
 pelotocino={
  a("detector","Killer Detector","◎","reveal",24,100,0,6,10),
  a("baconThrow","Bacon Throw","↗","bacon",18,32,15,2,10),
  a("pan","Golpe de sartén","◒","stun",16,9,6,2.5,10),
  a("luckyBacon","Lucky Bacon","✚","heal",25,0,25,0,10)},
 yellowguy={
  a("cane","Golpe de bastón","╱","stun",18,12,6,3,10),
  a("caneGuard","Guardia del bastón","◇","shield",24,0,.5,4,15),
  a("lastFighter","Last Fighter","★","lastFighter",40,0,15,5,20),
  a("caneThrow","Lanzar bastón","↗","caneThrow",18,28,6,3,10)},
 junkbot={
  a("overdrive","Overdrive Rush","»","speed",18,0,28,4,15),
  a("rocketSlam","Rocket Slam","↓","slam",24,12,12,2,20),
  a("selfRepair","Self Repair","⚙","repair",25,0,25,2,10)},
 deathspeaker={
  a("plasma","Plasma Ray","━","ray",18,50,12,2,15),
  a("shield","Super Shield","⬡","teamShield",25,18,.45,5,20),
  a("phantom","Phantom Step","↝","step",20,14,0,.35,15),
  a("connection","Haunted Connection","∞","teamHeal",25,24,20,3,15)},
 guest666={
  a("claw","Cursed Claw","≋","melee",1.2,8,25,0,0),
  a("behind","Behind You","↶","behind",24,28,0,0,20),
  a("sense","Sixth Sense","◎","reveal",22,90,0,6,10),
  a("sixthHour","The Sixth Hour","Ⅵ","speed",14,0,28,4,15),
  a("pounce","Demonic Pounce","↟","pounce",22,12,20,.5,20)},
 tubers93={
  a("scythe","Guadaña","☽","melee",1.2,8,25,0,0),
  a("admin","Admin Abuse","!","areaSlow",22,20,6,3,20),
  a("hellfire","Hellfire","♨","fire",26,9,5,4,20),
  a("whip","Death Whip","⌁","pull",20,26,12,1.5,15),
  a("spin","Reaper's Spin","↻","areaDamage",18,24,20,0,20),
  a("inferno","Inferno Blast","✹","blast",32,55,18,0,25)}
}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">AbilityTiming</string>
          <ProtectedString name="Source">-- Visual windups in seconds. Existing damage, energy costs and cooldowns stay in AbilityConfig.
return {claw=.22,scythe=.28,pan=.22,cane=.22,baconThrow=.45,caneThrow=.28,plasma=.42,whip=.25,spin=.2,inferno=.55}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">AnimationConfig</string>
          <ProtectedString name="Source">-- Optional author-supplied AnimationIds. Empty entries use the included procedural poses.
return {idle="",walk="",run="",sprint="",jump="",fall="",land="",hit="",stun="",death="",medkit="",drink="",skill="",
 guestVictory="",tubersVictory="",mvp="",results="",
 characters={pelotocino={},yellowguy={},junkbot={},deathspeaker={},guest666={},tubers93={}}}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Appearance</string>
          <ProtectedString name="Source">local A={}
function A.describe(id)
 local list={}
 local black=Color3.fromRGB(13,15,18)
 local white=Color3.fromRGB(221,222,215)
 local brown=Color3.fromRGB(98,48,20)
 local gold=Color3.fromRGB(153,132,40)
 local silver=Color3.fromRGB(138,146,165)
 local cyan=Color3.fromRGB(32,150,181)
 local purple=Color3.fromRGB(60,41,69)
 local killer=id=="guest666" or id=="tubers93"
 local robot=id=="junkbot"
 local ghost=id=="deathspeaker"
 local skin=id=="yellowguy" and Color3.fromRGB(245,205,48) or robot and gold or ghost and Color3.fromRGB(29,49,58) or id=="guest666" and black or id=="baller" and Color3.fromRGB(222,176,66) or white
 local coat=ghost and purple or black
 local function p(name,anchor,size,offset,color,angle,shape,neon,label)
  table.insert(list,{name=name,anchor=anchor,size=Vector3.new(size[1],size[2],size[3]),offset=Vector3.new(offset[1],offset[2],offset[3]),color=color,angle=angle or 0,shape=shape or "Block",neon=neon,label=label})
 end
 local function ball(name,anchor,size,offset,color,angle,neon)p(name,anchor,size,offset,color,angle,"Ball",neon)end
 -- Rounded replacement heads, with layered eyes instead of flat square dots.
 if robot or ghost then ball("Cabeza esculpida","Head",{1.05,1.1,1.04},{0,0,0},skin)
 else p("Cabeza esculpida","Head",{1.05,1.05,1.04},{0,0,0},skin,math.pi/2,"Cylinder") end
 for _,side in ipairs({-1,1}) do
  if robot or ghost then
   ball("Cuenca oscura","Head",{.33,.26,.14},{side*.21,.08,-.48},black,side*.25)
   ball("Ojo luminoso","Head",{.18,.12,.08},{side*.21,.09,-.56},robot and Color3.fromRGB(49,127,71) or cyan,side*.25,true)
  else
   ball("Ojo","Head",{.065,.11,.05},{side*.18,.1,-.52},id=="guest666" and Color3.fromRGB(180,12,25) or black,0,id=="guest666")
   if id=="baller" then
    ball("Esclerotica","Head",{.24,.1,.06},{side*.2,.1,-.51},white,side*.13)
    ball("Iris","Head",{.075,.09,.045},{side*.17,.09,-.55},black)
    p("Ceja expresiva","Head",{.27,.045,.05},{side*.21,.25,-.5},brown,side*-.2)
   end
  end
 end
 if not robot and not ghost and id~="guest666" then
  for i=0,7 do
   local t=i/7*math.pi
   ball("Sonrisa","Head",{.045,.04,.025},{math.cos(t)*.18,-.13-math.sin(t)*.13,-.52},black)
  end
 end
 if id=="pelotocino" or id=="tubers93" or id=="baller" then
  local hair=id=="baller" and Color3.fromRGB(164,107,30) or brown
  ball("Masa de cabello","Head",{1.15,.65,1.08},{0,.5,.08},hair)
  for i=-3,3 do
   local height=id=="baller" and (.55+(3-math.abs(i))*.09) or .45
   ball("Mechon curvado","Head",{.24,height,.75},{i*.15,.58,-.13},hair,i*.16)
   ball("Brillo del pelo","Head",{.045,height*.8,.64},{i*.15-.045,.6,-.2},hair:Lerp(gold,.28),i*.16)
   if id~="baller" and i~=0 then
    ball("Mechon frontal","Head",{.16,.52,.22},{i*.15,.31,-.47},hair,i*.11)
   end
  end
  for _,side in ipairs({-1,1}) do ball("Patilla","Head",{.14,.4,.6},{side*.49,.18,.03},hair) end
 end
 if id=="pelotocino" or id=="tubers93" then
  p("Camiseta azul","Torso",{.5,.95,.05},{0,0,-.53},Color3.fromRGB(16,90,138))
  for _,side in ipairs({-1,1}) do
   p("Chaqueta abierta","Torso",{.27,.97,.15},{side*.37,0,-.52},black)
   p("Solapa","Torso",{.1,.65,.13},{side*.25,.13,-.61},Color3.fromRGB(37,40,43),side*.15)
   p("Bolsillo","Torso",{.18,.15,.08},{side*.37,-.18,-.63},Color3.fromRGB(26,29,30))
   local arm=side&lt;0 and "LeftArm" or "RightArm"
   p("Manga corta",arm,{1.03,.5,1.04},{0,.24,0},black)
  end
 elseif id=="guest666" then
  ball("Copa de gorra","Head",{1.16,.48,1.1},{0,.52,.04},Color3.fromRGB(30,27,26))
  ball("Visera de gorra","Head",{1.2,.09,.8},{0,.4,-.58},Color3.fromRGB(104,30,31))
  p("Insignia gorra","Head",{.26,.23,.03},{0,.61,-.5},black,0,nil,false,"R")
  p("Logo camiseta","Torso",{.9,.34,.04},{0,.17,-.53},black,0,nil,false,"ROBLOX")
  for _,side in ipairs({-1,1}) do p("Banda roja manga",side&lt;0 and "LeftArm" or "RightArm",{1.04,.16,1.05},{0,.1,0},Color3.fromRGB(116,26,32),.12) end
 elseif id=="baller" then
  p("Camisa blanca","Torso",{.44,.96,.055},{0,0,-.53},white)
  for _,side in ipairs({-1,1}) do
   p("Solapa de smoking","Torso",{.19,.74,.09},{side*.28,.1,-.59},Color3.fromRGB(29,34,38),side*.28)
   ball("Pajarita","Torso",{.18,.12,.12},{side*.08,.35,-.64},black,side*.25)
  end
  for i=1,4 do ball("Boton de camisa","Torso",{.035,.035,.04},{0,.19-i*.15,-.6},black) end
  p("Numero 246","Torso",{.23,.17,.03},{-.36,.19,-.59},black,0,nil,false,"246")
 elseif robot then
  ball("Casco robot","Head",{1.12,.8,.92},{0,.2,.08},gold)
  for _,side in ipairs({-1,1}) do
   ball("Ojo del casco","Head",{.3,.25,.12},{side*.21,.09,-.49},black,side*.3)
   ball("Cristal verde","Head",{.18,.15,.08},{side*.21,.09,-.56},Color3.fromRGB(45,112,66),side*.3,true)
   p("Aleta lateral","Head",{.13,.66,.33},{side*.52,.52,.12},gold,side*.18)
   ball("Hombrera dorada",side&lt;0 and "LeftArm" or "RightArm",{1.4,.4,1.3},{0,.35,0},gold)
  end
  p("Cresta dorsal","Head",{.16,1.65,.48},{0,1.05,.38},gold)
  for i=0,10 do p("Ranura verde de cresta","Head",{.08,.04,.04},{0,.37+i*.13,.12},Color3.fromRGB(64,112,60)) end
  ball("Peto articulado","Torso",{.94,.72,.72},{0,.15,-.36},gold)
  p("Panel central","Torso",{.38,.16,.08},{0,.13,-.76},gold,0,nil,false,"◈")
  for i=1,5 do ball("Anillo abdominal","Torso",{.55,.09,.8},{0,-.24-i*.1,0},Color3.fromRGB(67,71,64)) end
 elseif ghost then
  ball("Capucha exterior","Head",{1.23,1.22,1.12},{0,.09,.15},purple)
  ball("Hueco de capucha","Head",{.96,.92,.3},{0,.03,-.46},black)
  for _,side in ipairs({-1,1}) do
   ball("Pomulo espectral","Head",{.22,.35,.18},{side*.25,-.18,-.59},Color3.fromRGB(45,66,77),side*.2)
   ball("Ojo espectral","Head",{.21,.14,.08},{side*.2,.1,-.64},cyan,side*.2,true)
   for j=0,6 do
    local size=.23-j*.025
    ball("Cuerno curvo","Head",{size,.24,size},{side*(.48+j*.045+math.sin(j*.5)*.17),.4+j*.16,.05},j&gt;4 and cyan or black,side*.4)
   end
   local arm=side&lt;0 and "LeftArm" or "RightArm"
   ball("Hombrera labrada",arm,{1.6,.48,1.45},{0,.38,0},silver)
   for j=0,3 do ball("Espina azul",arm,{.25-j*.045,.32,.25-j*.045},{side*(.35+j*.06),.6+j*.13,0},j&gt;1 and cyan or purple,side*.35) end
  end
  ball("Coraza curvada","Torso",{1.04,.82,.38},{0,.08,-.49},silver)
  ball("Engaste de gema","Torso",{.32,.25,.12},{0,.26,-.71},purple)
  ball("Gema azul","Torso",{.22,.17,.1},{0,.26,-.78},cyan,0,true)
  for _,side in ipairs({-1,1}) do
   for j=0,5 do ball("Filigrana","Torso",{.07,.07,.04},{side*(.13+j*.06),.12-math.sin(j*.55)*.15,-.7},purple) end
  end
  for i=-3,3 do
   p("Faldon desgarrado","Torso",{.15,.9-math.abs(i)*.12,.12},{i*.13,-.66,-.51},purple,i*.09)
  end
 end
 -- Boots, gauntlets and fingers are attached to limbs, not to the torso.
 for _,side in ipairs({-1,1}) do
  local leg=side&lt;0 and "LeftLeg" or "RightLeg"
  local arm=side&lt;0 and "LeftArm" or "RightArm"
  ball("Bota",leg,{1.13,.32,1.5},{0,-.42,-.2},(id=="pelotocino" or id=="tubers93") and white or black)
  if robot or ghost then
   ball("Rodillera",leg,{1.1,.34,1.15},{0,.1,-.16},robot and gold or silver)
   p("Greba",leg,{.66,.65,.16},{0,-.12,-.57},robot and gold or purple)
   ball("Guantelete",arm,{1.15,.52,1.18},{0,-.27,0},robot and Color3.fromRGB(64,68,64) or silver)
   for j=-1,1 do
    ball("Garra",arm,{.18,.32,.22},{j*.26,-.65,-.05},robot and black or cyan,j*.15)
   end
  end
 end
 if id=="tubers93" then
  p("Pechera triste","Torso",{.86,.46,.08},{0,.24,-.67},Color3.fromRGB(195,142,30),0,nil,false,"︵ ︵\n︵")
  p("Asta guadana","Torso",{.045,2.4,.09},{1,.1,0},silver)
  for i=0,11 do
   local a=i/11*1.8
   p("Hoja curva","Torso",{.18,.15,.1},{1-math.sin(a)*.9,1.29+(math.cos(a)-1)*.43,0},silver,a-.4)
  end
  for i=0,11 do ball("Eslabon de cadena","Torso",{.05,.07,.04},{.94+math.sin(i)*.02,.3-i*.08,-.1},silver) end
 end
 if id=="pelotocino" then
  p("Mochila","Torso",{.78,.85,.42},{0,0,.65},Color3.fromRGB(88,64,38))
  p("Bolsillo de mochila","Torso",{.55,.38,.12},{0,-.18,.91},Color3.fromRGB(64,49,34))
  for _,side in ipairs({-1,1}) do p("Correa de mochila","Torso",{.09,.9,.07},{side*.34,0,-.57},Color3.fromRGB(88,64,38)) end
 elseif id=="yellowguy" then
  p("Baston","RightArm",{.12,1.7,.12},{0,-.55,-.65},brown)
  p("Empunadura del baston","RightArm",{.4,.12,.14},{-.12,.27,-.65},gold)
 end
 if not killer then
  p("CombatMark_Cicatriz","Head",{.018,.19,.02},{-.32,-.07,-.52},Color3.fromRGB(113,74,57),-.35)
  p("CombatMark_Venda","Head",{.17,.08,.02},{.27,-.2,-.52},white,.2)
  p("CombatMark_Raspon","Torso",{.18,.015,.03},{-.2,-.2,-.74},Color3.fromRGB(103,91,72),.3)
  p("CombatMark_Desgaste","Torso",{.12,.015,.03},{-.15,-.26,-.74},Color3.fromRGB(103,91,72),.3)
 end
 if id=="tubers93" then
  for _,piece in ipairs(list) do
   if piece.name=="Asta guadana" or piece.name=="Hoja curva" or piece.name=="Eslabon de cadena" then
    piece.anchor="RightArm"
    piece.offset=Vector3.new(piece.offset.X*2-1.5,piece.offset.Y,piece.offset.Z)
    piece.size=Vector3.new(piece.size.X*2,piece.size.Y,piece.size.Z)
   end
  end
 end
 return list,skin,coat
end
function A.apply(model,id,anchored)
 local old=model:FindFirstChild("ForgottenAppearance")
 if old then old:Destroy() end
 local folder=Instance.new("Folder");folder.Name="ForgottenAppearance";folder.Parent=model
 local pieces,skin,coat=A.describe(id)
 for _,body in ipairs(model:GetChildren()) do
  if body:IsA("BasePart") and body.Name~="HumanoidRootPart" then
   body.Color=(id=="junkbot" and Color3.fromRGB(70,76,70)) or (id=="deathspeaker" and Color3.fromRGB(35,61,70)) or Color3.fromRGB(23,25,27)
   if id=="yellowguy" then
    body.Color=body.Name:find("Leg") and Color3.fromRGB(66,112,65) or body.Name:find("Torso") and Color3.fromRGB(43,95,178) or skin
   end
   if (id=="pelotocino" or id=="tubers93") and (body.Name=="Brazo" or body.Name:find("Arm") or body.Name:find("Hand")) then body.Color=skin end
  end
 end
 local head=model:FindFirstChild("Head")
 local torso=model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
 if head then
  head.Color=skin;head.Transparency=1
  for _,d in ipairs(head:GetChildren()) do if d:IsA("Decal") then d.Transparency=1 end end
 end
 if torso then torso.Color=id=="yellowguy" and Color3.fromRGB(43,95,178) or coat end
 for _,spec in ipairs(pieces) do
  local anchor
  if spec.anchor=="Head" then anchor=head
  elseif spec.anchor=="Torso" then anchor=torso
  else
   local spaced=spec.anchor:gsub("Left","Left "):gsub("Right","Right ")
   local lower=spec.anchor:gsub("Arm","LowerArm"):gsub("Leg","LowerLeg")
   local upper=spec.anchor:gsub("Arm","UpperArm")
   local shoulder=spec.name:find("Hombrera") or spec.name=="Manga corta" or spec.name=="Banda roja manga"
   anchor=model:FindFirstChild(spec.anchor) or model:FindFirstChild(spaced) or (shoulder and model:FindFirstChild(upper)) or model:FindFirstChild(lower)
  end
  if anchor then
   local function scale(v)return Vector3.new(v.X*anchor.Size.X,v.Y*anchor.Size.Y,v.Z*anchor.Size.Z)end
   local p=Instance.new("Part");p.Name=spec.name;p.Size=scale(spec.size)
   p.CFrame=anchor.CFrame*CFrame.new(scale(spec.offset))*CFrame.Angles(0,0,spec.angle)
   p.Color=spec.color;p.Material=spec.neon and Enum.Material.Neon or Enum.Material.SmoothPlastic
   p.Anchored=anchored;p.CanCollide=false;p.CanTouch=false;p.Massless=true
   if spec.shape=="Ball" then p.Shape=Enum.PartType.Ball elseif spec.shape=="Cylinder" then p.Shape=Enum.PartType.Cylinder end
   p.Parent=folder
   if spec.label then
    local gui=Instance.new("SurfaceGui");gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(512,256);gui.Parent=p
    local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=1;label.Text=spec.label;label.TextColor3=Color3.fromRGB(240,230,218);label.TextScaled=true;label.Parent=gui
   end
   if not anchored then local weld=Instance.new("WeldConstraint");weld.Part0=anchor;weld.Part1=p;weld.Parent=p end
  end
 end
end
return A
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">AvatarCatalog</string>
          <ProtectedString name="Source">-- Resolve official catalog resources by exact name and verified creator at runtime.
-- No guessed asset or bundle IDs. Junkbot keeps its existing, author-supplied loader.
local Players=game:GetService("Players")
local Editor=game:GetService("AvatarEditorService")
local Assets=game:GetService("AssetService")
local Catalog={}
local templates={}
local loading=false
local nextAttempt=0
local function official(entry,name)
 return type(entry)=="table" and type(entry.Id)=="number" and entry.Id&gt;0
  and type(entry.Name)=="string" and entry.Name:lower()==name:lower()
  and type(entry.CreatorName)=="string" and entry.CreatorName:lower()=="roblox"
end
local function search(name,bundle)
 local params=CatalogSearchParams.new()
 params.SearchKeyword=name;params.CreatorName="Roblox";params.IncludeOffSale=true;params.Limit=30
 if bundle then params.BundleTypes={Enum.BundleType.BodyParts}
 else params.AssetTypes={Enum.AvatarAssetType.HairAccessory} end
 local pages=Editor:SearchCatalogAsync(params)
 for _,entry in ipairs(pages:GetCurrentPage()) do if official(entry,name) then return entry.Id end end
 return nil
end
local function native(name,description,rigType)
 local model=Players:CreateHumanoidModelFromDescriptionAsync(description,rigType)
 assert(model and model:FindFirstChildOfClass("Humanoid") and model:FindFirstChild("HumanoidRootPart"),"Avatar incompleto")
 model.Name=name;model.Archivable=true;model.Parent=nil;templates[name]=model
end
function Catalog.load()
 if loading or os.clock()&lt;nextAttempt then return false end
 if templates.classic and templates.bacon and templates.deathspeaker then return false end
 loading=true;nextAttempt=os.clock()+90
 local changed=false
 local function attempt(key,fn)
  if templates[key] then return end
  local ok,problem=pcall(fn)
  if ok and templates[key] then changed=true else warn("FORGOTTEN V3 · "..key..": "..tostring(problem or "recurso no disponible")..". Se conserva la alternativa propia.") end
 end
 attempt("classic",function()
  native("classic",Instance.new("HumanoidDescription"),Enum.HumanoidRigType.R6)
 end)
 attempt("bacon",function()
  local id=search("Pal Hair",false);assert(id,"No se encontró Pal Hair del creador Roblox")
  local description=Instance.new("HumanoidDescription");description.HairAccessory=tostring(id)
  native("bacon",description,Enum.HumanoidRigType.R6)
  templates.bacon:SetAttribute("OfficialBaconHair",true)
  templates.bacon:SetAttribute("ResolvedHairAssetId",id)
 end)
 attempt("deathspeaker",function()
  local id=search("Korblox Deathspeaker",true);assert(id,"No se encontró el paquete oficial Korblox Deathspeaker")
  local bundle=Assets:GetBundleDetailsAsync(id)
  assert(type(bundle.Name)=="string" and bundle.Name:lower()=="korblox deathspeaker","Identidad de paquete incorrecta")
  local outfit
  for _,item in ipairs(bundle.Items or {}) do if item.Type=="UserOutfit" then outfit=item.Id;break end end
  assert(outfit,"El paquete no incluye un atuendo")
  local description=Players:GetHumanoidDescriptionFromOutfitIdAsync(outfit)
  for _,key in ipairs({"Head","Torso","LeftArm","RightArm","LeftLeg","RightLeg"}) do assert(description[key]&gt;0,"Cuerpo oficial incompleto: "..key) end
  native("deathspeaker",description,Enum.HumanoidRigType.R15)
  templates.deathspeaker:SetAttribute("ResolvedBundleId",id)
  templates.deathspeaker:SetAttribute("SourceOutfitId",outfit)
  templates.deathspeaker:SetAttribute("OfficialCatalogBody",true)
 end)
 loading=false
 return changed
end
function Catalog.clone(id)
 local key=id=="deathspeaker" and "deathspeaker" or (id=="pelotocino" or id=="tubers93") and (templates.bacon and "bacon" or "classic") or id~="junkbot" and "classic"
 local template=key and templates[key]
 if not template then return nil end
 local model=template:Clone();model:SetAttribute("CharacterIdentity",id)
 model:SetAttribute("NativeAvatarRig",true)
 return model
end
return Catalog
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">BasicAnimation</string>
          <ProtectedString name="Source">-- V3 character-specific animation state machine. Every observer samples server time.
local Config=require(script.Parent.AnimationConfig)
local Motion=require(script.Parent.CharacterMotion)
return function()
 local Collection=game:GetService("CollectionService")
 local RunService=game:GetService("RunService")
 local rigs={}
 local function add(model)
  local joints,visuals={},{}
  for _,object in ipairs(model:GetDescendants()) do
   if object:IsA("Motor6D") then joints[Motion.jointKey(object.Name)]=object
   elseif object:IsA("BasePart") then
    local group=object.Parent
    local weapon=object:GetAttribute("WeaponKind") or group and group:GetAttribute("WeaponKind")
    local action=object:GetAttribute("VisibilityAction")
    if weapon or action then table.insert(visuals,{part=object,weapon=weapon,action=action}) end
   end
  end
  local data={joints=joints,visuals=visuals,phase=0,tracks={},state="idle",stateAt=0,wasAir=false}
  data.connection=model.DescendantAdded:Connect(function(object)
   if object:IsA("Motor6D") then joints[Motion.jointKey(object.Name)]=object
   elseif object:IsA("BasePart") then
    local weapon=object:GetAttribute("WeaponKind") or object.Parent and object.Parent:GetAttribute("WeaponKind")
    local action=object:GetAttribute("VisibilityAction")
    if weapon or action then table.insert(visuals,{part=object,weapon=weapon,action=action}) end
   end
  end)
  rigs[model]=data
 end
 local function external(data,h,id,key)
  local overrides=Config.characters and Config.characters[id]
  local asset=overrides and overrides[key] or Config[key]
  if type(asset)~="string" or not asset:match("^rbxassetid://%d+$") then return nil end
  if data.tracks[asset]==nil then
   local animator=h:FindFirstChildOfClass("Animator")
   if not animator then return nil end
   local clip=Instance.new("Animation");clip.AnimationId=asset
   local ok,result=pcall(function()return animator:LoadAnimation(clip)end)
   clip:Destroy();data.tracks[asset]=ok and result or false
  end
  return data.tracks[asset] or nil
 end
 Collection:GetInstanceAddedSignal("ForgottenAnimated"):Connect(add)
 Collection:GetInstanceRemovedSignal("ForgottenAnimated"):Connect(function(model)
  if rigs[model] and rigs[model].connection then rigs[model].connection:Disconnect() end
  rigs[model]=nil
 end)
 for _,model in ipairs(Collection:GetTagged("ForgottenAnimated")) do add(model) end
 RunService.PreSimulation:Connect(function(dt)
  local now=workspace:GetServerTimeNow()
  for model,data in pairs(rigs) do
   local root=model:FindFirstChild("HumanoidRootPart");local h=model:FindFirstChildOfClass("Humanoid")
   local camera=workspace.CurrentCamera
   local nearby=root and (not root.Anchored or not camera or (camera.CFrame.Position-root.Position).Magnitude&lt;180)
   if model:IsDescendantOf(workspace) and root and h and nearby then
    local velocity=root.AssemblyLinearVelocity
    local speed=Vector3.new(velocity.X,0,velocity.Z).Magnitude
    data.phase=data.phase+dt*(speed&gt;1 and math.min(16,5+speed*.32) or 2)
    local id=model:GetAttribute("CharacterIdentity") or "pelotocino"
    local air=h.FloorMaterial==Enum.Material.Air and not root.Anchored
    if data.wasAir and not air then data.landedAt=now end
    data.wasAir=air
    local action=model:GetAttribute("Action") or ""
    local actionTime=now-(model:GetAttribute("ActionAt") or -100)
    local use=(model:GetAttribute("ItemActionUntil") or 0)&gt;now and model:GetAttribute("ItemAction")
    local state=h.Health&lt;=0 and "death"
     or (model:GetAttribute("StunnedUntil") or 0)&gt;now and "stun"
     or now-(model:GetAttribute("DamageAt") or -100)&lt;.22 and "hit"
     or use or (model:GetAttribute("RepairStage") or 0)&gt;0 and "repairGenerator" or air and (velocity.Y&gt;1 and "jump" or "fall")
     or now-(data.landedAt or -100)&lt;.28 and "land"
     or speed&gt;23 and "sprint" or speed&gt;18 and "run" or speed&gt;.7 and "walk" or "idle"
    if state~=data.state then data.state=state;data.stateAt=now end
    local key=Motion.durations[action] and actionTime&lt;Motion.durations[action] and actionTime&gt;=0 and action or state
    local track=external(data,h,id,key) or (key~=state and external(data,h,id,"skill"))
    if track then
     if data.current~=track then
      if data.current then data.current:Stop(.12) end
      track.Looped=key=="idle" or key=="walk" or key=="run" or key=="sprint"
      track:Play(.12);data.current=track
     end
    else
     if data.current then data.current:Stop(.12);data.current=nil end
     local pose=Motion.sample(id,state,data.phase,speed,action,actionTime,{stateTime=now-data.stateAt,repairStage=model:GetAttribute("RepairStage"),pullElapsed=now-(model:GetAttribute("RepairPullAt") or -100)})
     local alpha=1-math.exp(-dt*19)
     for name,joint in pairs(data.joints) do
      local values=pose[name]
      if values then
       local target=Motion.toTransform(joint,values)
       joint.Transform=joint.Transform:Lerp(target,alpha)
      end
     end
    end
    local away=(model:GetAttribute("CaneAwayUntil") or 0)&gt;now
    for _,visual in ipairs(data.visuals) do
     if visual.part.Parent then
      if visual.action then visual.part.Transparency=action==visual.action and actionTime&gt;=0 and actionTime&lt;1 and 0 or 1 end
      if visual.weapon=="cane" then visual.part.LocalTransparencyModifier=(away or visual.part:GetAttribute("MeshReplaced")) and 1 or 0 end
     end
    end
   end
  end
 end)
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">CatalogCharacter</string>
          <ProtectedString name="Source">-- Official bundle supplied by the author. Body asset IDs come from Roblox.
local Players = game:GetService("Players")
local AssetService = game:GetService("AssetService")
local Storage = game:GetService("ServerStorage")
local Catalog = {}
local cached
local loading = false
local lastAttempt = -math.huge
local BODY = {"Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg"}

local function validate(model)
 local h = model:FindFirstChildOfClass("Humanoid")
 assert(h and h.RigType == Enum.HumanoidRigType.R15, "Junkbot necesita su cuerpo R15 original.")
 assert(model:FindFirstChild("HumanoidRootPart") and model:FindFirstChild("Head"), "Junkbot llegó incompleto.")
 local description = h:GetAppliedDescription()
 for _, key in ipairs(BODY) do
  assert(description[key] &gt; 0, "Falta la pieza original de Junkbot: " .. key)
 end
end

function Catalog.load()
 -- This method yields; call during lobby loading, never halfway through equipping.
 if cached then return true end
 if loading or os.clock() - lastAttempt &lt; 20 then return false end
 loading = true
 lastAttempt = os.clock()
 local model
 local ok, problem = pcall(function()
  local folder = Storage:FindFirstChild("CatalogCharacters")
  local installed = folder and folder:FindFirstChild("junkbot")
  -- Read the previous misnamed installation only when its catalog ID proves it is Junkbot.
  if not installed and folder then
   local legacy=folder:FindFirstChild("yellowguy")
   if legacy and legacy:GetAttribute("SourceBundleId")==589 then installed=legacy end
  end
  if installed and installed:GetAttribute("SourceBundleId") == 589 then
   local candidate = installed:Clone()
   if pcall(validate,candidate) then model=candidate
   else candidate:Destroy();warn("Plantilla local de Junkbot incompleta; se intentará el catálogo.") end
  end
  if not model then
   local bundle = AssetService:GetBundleDetailsAsync(589)
   assert(bundle.Name and bundle.Name:lower() == "junkbot", "El paquete 589 no se identifica como Junkbot.")
   local outfitId
   for _, item in ipairs(bundle.Items) do
    if item.Type == "UserOutfit" then outfitId = item.Id; break end
   end
   assert(outfitId, "Roblox no devolvió el atuendo del paquete Junkbot.")
   local description = Players:GetHumanoidDescriptionFromOutfitIdAsync(outfitId)
   model = Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R15)
   model:SetAttribute("SourceOutfitId", outfitId)
  end
  validate(model)
  model.Name = "junkbot"
  model:SetAttribute("SourceBundleId", 589)
  model:SetAttribute("ExpectedCharacterId", "junkbot")
  -- Do not recolor, rescale, overlay procedural meshes or add avatar accessories.
  model.Archivable = true
  model.Parent = nil
 end)
 loading = false
 if not ok then
  if model then model:Destroy() end
  warn("No se pudo cargar el Junkbot original: " .. tostring(problem))
  return false
 end
 cached = model
 return true
end

function Catalog.ready()
 return cached ~= nil
end

function Catalog.clone()
 if not cached then return nil end
 return cached:Clone()
end

return Catalog
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ChallengeRules</string>
          <ProtectedString name="Source">-- Pure server-side challenge state. Caller supplies a trusted clock and RNG.
local Challenge={}
local mazes={
 {"1111111","1000001","1110101","1000101","1011101","1000001","1111111"},
 {"1111111","1000101","1010101","1010001","1011101","1000001","1111111"}}
function Challenge.new(kind,now,random)
 local s={kind=kind,step=1,deadline=now+60,last=-100,sequence={},started=now}
 if kind=="memory" or kind=="piano" or kind=="wires" then
  for i=1,kind=="wires" and 3 or 4 do s.sequence[i]=random(1,4) end
  s.readyAt=now+(kind=="memory" and 2.5 or 0)
 elseif kind=="switches" then
  s.current={false,false,false,false};s.target={true,false,true,true}
 elseif kind=="reflex" then s.readyAt=now+random(15,30)/10
 elseif kind=="rope" then s.readyAt=now+.5;s.pulls=0
 elseif kind=="maze" then s.grid=mazes[random(1,#mazes)];s.x=2;s.y=2;s.moves=0
 else return nil end
 return s
end
function Challenge.input(s,value,now)
 if now&gt;s.deadline then return "expired" end
 if now-s.last&lt;.12 then return "ignored" end
 s.last=now
 if s.kind=="memory" or s.kind=="piano" or s.kind=="wires" then
  if now&lt;s.readyAt then return "ignored" end
  if type(value)~="number" or value~=s.sequence[s.step] then return "wrong" end
  s.step=s.step+1
  return s.step&gt;#s.sequence and "complete" or "progress"
 elseif s.kind=="switches" then
  if type(value)~="number" or value%1~=0 or value&lt;1 or value&gt;4 then return "ignored" end
  s.current[value]=not s.current[value]
  for i=1,4 do if s.current[i]~=s.target[i] then return "progress" end end
  return "complete"
 elseif s.kind=="reflex" then
  if value~="hit" then return "ignored" end
  if now&lt;s.readyAt or now&gt;s.readyAt+1.2 then return "wrong" end
  return "complete"
 elseif s.kind=="rope" then
  if value~="pull" then return "ignored" end
  if now&lt;s.readyAt then return "ignored" end
  local position=((now-s.readyAt)%1.8)/1.8
  if position&lt;.3 or position&gt;.7 then return "wrong" end
  s.pulls=s.pulls+1;s.readyAt=now+.4
  return s.pulls&gt;=3 and "complete" or "progress"
 elseif s.kind=="maze" then
  local directions={up={0,-1},down={0,1},left={-1,0},right={1,0}}
  local d=type(value)=="string" and directions[value]
  if not d then return "ignored" end
  local x,y=s.x+d[1],s.y+d[2]
  if y&lt;1 or y&gt;7 or x&lt;1 or x&gt;7 or s.grid[y]:sub(x,x)=="1" then return "progress" end
  s.x=x;s.y=y;s.moves=s.moves+1
  if s.moves&gt;100 then return "expired" end
  return x==6 and y==6 and "complete" or "progress"
 end
 return "ignored"
end
return Challenge
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">CharacterFactory</string>
          <ProtectedString name="Source">local Storage=game:GetService("ServerStorage")
local Collection=game:GetService("CollectionService")
local Appearance=require(script.Parent.Appearance)
local Imported=require(script.Parent.ImportedAppearance)
local Catalog=require(script.Parent.CatalogCharacter)
local AvatarCatalog=require(script.Parent.AvatarCatalog)
local Visuals=require(script.Parent.CharacterVisuals)
local Factory={}

function Factory.validate(model,id)
 if not model or not model:IsA("Model") then return false,"Falta Model" end
 local h=model:FindFirstChildOfClass("Humanoid")
 local root=model:FindFirstChild("HumanoidRootPart")
 if not h or not root or not root:IsA("BasePart") then return false,"Falta Humanoid/HumanoidRootPart" end
 if h.RigType~=Enum.HumanoidRigType.R6 and h.RigType~=Enum.HumanoidRigType.R15 then return false,"Rig incompatible" end
 if not model:FindFirstChild("Head") or not (model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")) then return false,"Cuerpo incompleto" end
 if model:GetAttribute("SourceBundleId")==589 and id~="junkbot" then return false,"El paquete 589 pertenece a Junkbot" end
 if model:GetAttribute("CharacterIdentity")~=id then return false,"Identidad del modelo sin verificar" end
 local joints=0
 local connected={}
 for _,child in ipairs(model:GetDescendants()) do
  if child:IsA("Motor6D") and child.Part0 and child.Part1 then
   joints=joints+1
   connected[child.Part0]=connected[child.Part0] or {};table.insert(connected[child.Part0],child.Part1)
   connected[child.Part1]=connected[child.Part1] or {};table.insert(connected[child.Part1],child.Part0)
  end
 end
 if joints&lt;(h.RigType==Enum.HumanoidRigType.R15 and 15 or 6) then return false,"Faltan articulaciones Motor6D" end
 local reached={[root]=true};local queue={root};local index=1
 while index&lt;=#queue do
  for _,part in ipairs(connected[queue[index]] or {}) do
   if not reached[part] then reached[part]=true;table.insert(queue,part) end
  end
  index=index+1
 end
 local required=h.RigType==Enum.HumanoidRigType.R6 and {"Head","Torso","Left Arm","Right Arm","Left Leg","Right Leg"}
  or {"Head","UpperTorso","LowerTorso","LeftUpperArm","LeftLowerArm","LeftHand","RightUpperArm","RightLowerArm","RightHand","LeftUpperLeg","LeftLowerLeg","LeftFoot","RightUpperLeg","RightLowerLeg","RightFoot"}
 for _,name in ipairs(required) do
  local part=model:FindFirstChild(name)
  if not part or not part:IsA("BasePart") or not reached[part] then return false,"Parte desconectada: "..name end
 end
 return true
end

local function placeholder(entry)
 local model=Instance.new("Model")
 model.Name=entry.id
 local function part(name,size,pos)
  local p=Instance.new("Part")
  p.Name=name;p.Size=size;p.CFrame=CFrame.new(pos);p.Color=entry.color
  p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth
  p.CanCollide=name=="Torso";p.Parent=model
  return p
 end
 local root=part("HumanoidRootPart",Vector3.new(2,2,1),Vector3.new())
 root.Transparency=1;root.CanCollide=false
 local torso=part("Torso",Vector3.new(2,2,1),Vector3.new())
 local head=part("Head",Vector3.new(2,1,1),Vector3.new(0,1.5,0))
 local function joint(name,p0,p1,c0,c1)
  local motor=Instance.new("Motor6D");motor.Name=name;motor.Part0=p0;motor.Part1=p1
  motor.C0=c0;motor.C1=c1;motor.Parent=p0
 end
 joint("RootJoint",root,torso,CFrame.new(),CFrame.new())
 joint("Neck",torso,head,CFrame.new(0,1,0),CFrame.new(0,-.5,0))
 for _,side in ipairs({-1,1}) do
  local prefix=side&lt;0 and "Left" or "Right"
  local arm=part(prefix.." Arm",Vector3.new(1,2,1),Vector3.new(side*1.5,0,0))
  local leg=part(prefix.." Leg",Vector3.new(1,2,1),Vector3.new(side*.5,-2,0))
  joint(prefix.." Shoulder",torso,arm,CFrame.new(side,.5,0),CFrame.new(-side*.5,.5,0))
  joint(prefix.." Hip",torso,leg,CFrame.new(side*.5,-1,0),CFrame.new(0,1,0))
 end
 local humanoid=Instance.new("Humanoid");humanoid.RigType=Enum.HumanoidRigType.R6
 humanoid.DisplayName=entry.name;humanoid.Parent=model
 model.PrimaryPart=root
 model:SetAttribute("CharacterIdentity",entry.id)
 model:SetAttribute("Placeholder",true)
 model:SetAttribute("ModelStatus","Provisional")
 if Imported.apply(model,entry.id,false) then model:SetAttribute("ModelStatus","Malla importada · pendiente de validar")
 else Visuals.apply(model,entry.id);model:SetAttribute("ModelStatus","Modelo propio V4 · provisional") end
 return model
end

local function wear(model)
 if model:FindFirstChild("JunkbotWear") then return end
 local torso=model:FindFirstChild("UpperTorso")
 if not torso then return end
 local folder=Instance.new("Folder");folder.Name="JunkbotWear";folder.Parent=model
 for i=1,3 do
  local scratch=Instance.new("Part");scratch.Name="Raspon discreto"
  scratch.Size=Vector3.new(torso.Size.X*.16,.018,.012)
  scratch.CFrame=torso.CFrame*CFrame.new(-torso.Size.X*.2,-.05-i*.06,-torso.Size.Z/2-.012)*CFrame.Angles(0,0,.22)
  scratch.Color=Color3.fromRGB(118,115,90);scratch.Transparency=.3
  scratch.CanCollide=false;scratch.CanTouch=false;scratch.CanQuery=false;scratch.Massless=true;scratch.Parent=folder
  local weld=Instance.new("WeldConstraint");weld.Part0=torso;weld.Part1=scratch;weld.Parent=scratch
 end
end

function Factory.create(entry)
 local model
 local folder=Storage:FindFirstChild("CharacterModels")
 local installed=folder and folder:FindFirstChild(entry.id)
 if installed then
  local valid,reason=Factory.validate(installed,entry.id)
  if valid then model=installed:Clone();model:SetAttribute("ModelStatus","Modelo instalado")
  else warn(entry.name..": "..reason..". Se conserva la plantilla y se usa un provisional.") end
 end
 if not model and entry.id=="junkbot" then
  model=Catalog.clone()
  if model then
   model:SetAttribute("CharacterIdentity","junkbot")
   local valid,reason=Factory.validate(model,"junkbot")
   if not valid then warn(reason);model:Destroy();model=nil
   else model:SetAttribute("Placeholder",false);model:SetAttribute("ModelStatus","Modelo original de Roblox") end
  end
 end
 if not model and entry.id~="junkbot" then
  local native=AvatarCatalog.clone(entry.id)
  if native then
   local valid=Factory.validate(native,entry.id)
   if valid then
    model=native
    if model:GetAttribute("OfficialCatalogBody") then
     model:SetAttribute("Placeholder",false);model:SetAttribute("ModelStatus","Cuerpo original de Roblox · catálogo verificado")
    else
     Visuals.apply(model,entry.id)
     model:SetAttribute("Placeholder",true);model:SetAttribute("ModelStatus",model:GetAttribute("OfficialBaconHair") and "Rig y cabello Roblox · vestuario propio V4" or "Rig Roblox · apariencia propia V4")
    end
   else native:Destroy() end
  end
 end
 if not model then model=placeholder(entry) end
 if entry.id=="junkbot" and not model:GetAttribute("Placeholder") then wear(model) end
 -- Known local character scripts are provided by this project, not the source rig.
 for _,child in ipairs(model:GetDescendants()) do
  if child:IsA("Script") or child:IsA("LocalScript") then child:Destroy()
  elseif child:IsA("BasePart") then child.Anchored=false end
 end
 local root=model:FindFirstChild("HumanoidRootPart")
 model.PrimaryPart=root
 root.CanCollide=false;root.Transparency=1
 model:SetAttribute("CharacterIdentity",entry.id)
 local h=model:FindFirstChildOfClass("Humanoid")
 if not h:FindFirstChildOfClass("Animator") then local animator=Instance.new("Animator");animator.Parent=h end
 h.Health=100;h.MaxHealth=100;h.WalkSpeed=entry.role=="Asesino" and 18 or 16
 h.DisplayName=entry.name..(model:GetAttribute("Placeholder") and " [provisional]" or "")
 h.BreakJointsOnDeath=false
 Collection:AddTag(model,"ForgottenAnimated")
 return model
end

function Factory.place(model,groundPosition)
 local root=model:FindFirstChild("HumanoidRootPart")
 local h=model:FindFirstChildOfClass("Humanoid")
 local offset=h.RigType==Enum.HumanoidRigType.R6 and 3.4 or (h.HipHeight+root.Size.Y/2+.4)
 model:PivotTo(CFrame.new(groundPosition+Vector3.new(0,offset,0)))
 root.AssemblyLinearVelocity=Vector3.new();root.AssemblyAngularVelocity=Vector3.new()
end

return Factory
</ProtectedString>
