 {id="tubers93",name="Tubers93",role="Asesino",color=Color3.fromRGB(70,180,90),skill="Interferencia: daña supervivientes cercanos",cooldown=18,confirmedLore=true,lore="Soy la contraparte oscura de Bacon: guadaña, fuego sobrenatural y caos. Shadow Reaper anuncia mi persecución."},
 {id="pelotocino",name="Pelotocino",role="Superviviente",color=Color3.fromRGB(195,130,75),skill="Segundo aire: recupera 25 de salud",cooldown=25,lore="Llegó siguiendo unas huellas que terminaban frente a la cabaña. Se niega a abandonar a sus amigos."},
 {id="yellowguy",name="Yellow Guy",role="Superviviente",color=Color3.fromRGB(245,205,48),skill="Bastón: frena al asesino cercano",cooldown=18,lore="Un caminante amarillo que se apoya en su bastón. Busca el sendero que conectaba el campamento con el mundo exterior."},
 {id="junkbot",name="Junkbot",role="Superviviente",color=Color3.fromRGB(153,132,40),skill="Sobrecarga: velocidad durante 4 s",cooldown=18,bundleId=589,lore="Un robot con la carcasa arañada. Sus sensores siguen detectando señales entre las ruinas."},
 {id="deathspeaker",name="Korblox Deathspeaker",role="Superviviente",color=Color3.fromRGB(130,95,180),skill="Susurro: cura aliados próximos",cooldown=25,confirmedLore=true,lore="Guest 666 era mi mejor amigo. Tras el accidente con ácido nuestra amistad se rompió. Quiero reparar lo ocurrido, aunque él solo quiera venganza."},
