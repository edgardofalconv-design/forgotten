      <Item class="ModuleScript">
        <Properties>
          <string name="Name">CharacterVisuals</string>
          <ProtectedString name="Source">local Data=require(script.Parent.CharacterVisualData)
local Geometry=require(script.Parent.VisualGeometry)
local Proportions=require(script.Parent.RigProportions)
local Faces=require(script.Parent.FaceData)
local Visuals={}
local palettes={
 pelotocino={skin={237,235,226},torso={18,21,25},legs={25,30,32}},
 yellowguy={skin={245,205,48},torso={17,20,24},legs={23,26,31}},
 guest666={skin={12,13,17},torso={13,15,19},legs={14,16,20}},
 tubers93={skin={221,219,208},torso={16,18,22},legs={24,28,31}},
 junkbot={skin={157,134,51},torso={66,72,64},legs={63,69,63}},
 deathspeaker={skin={33,65,75},torso={33,65,75},legs={33,65,75}}}
local function rgb(t)return Color3.fromRGB(t[1],t[2],t[3])end
function Visuals.anchor(model,name,specName)
 if name=="Torso" then return model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso") end
 if name=="Head" then return model:FindFirstChild("Head") end
 local spaced=name:gsub("Left","Left "):gsub("Right","Right ")
 local direct=model:FindFirstChild(spaced) or model:FindFirstChild(name)
 if direct then return direct end
 local lower=name:gsub("Arm","LowerArm"):gsub("Leg","LowerLeg")
 local upper=name:gsub("Arm","UpperArm"):gsub("Leg","UpperLeg")
 return model:FindFirstChild(specName and specName:find("Hombrera") and upper or lower)
end
local function surface(part,name)
 local old=part:FindFirstChild(name.."Mount");if old then old:Destroy() end
 -- Keep the artwork outside the native Head mesh and the shaped body surface.
 local host=Instance.new("Part");host.Name=name.."Mount";host.Size=Vector3.new(part.Size.X,part.Size.Y,.01)
 host.Transparency=1;host.CanCollide=false;host.CanTouch=false;host.CanQuery=false;host.Massless=true;host.CastShadow=false
 host.CFrame=part.CFrame*CFrame.new(0,0,-part.Size.Z/2-(part.Name=="Head" and .14 or .018));host.Parent=part
 local weld=Instance.new("WeldConstraint");weld.Part0=part;weld.Part1=host;weld.Parent=host
 local gui=Instance.new("SurfaceGui");gui.Name=name;gui.Face=Enum.NormalId.Front;gui.CanvasSize=Vector2.new(512,512);gui.Parent=host
 return gui
end
local function panel(gui,pos,size,color)
 local f=Instance.new("Frame");f.BorderSizePixel=0;f.Position=UDim2.fromScale(pos[1],pos[2]);f.Size=UDim2.fromScale(size[1],size[2]);f.BackgroundColor3=rgb(color);f.Parent=gui;return f
end
function Visuals.apply(model,id)
 Proportions.apply(model,id)
 local old=model:FindFirstChild("ForgottenAppearance");if old then old:Destroy() end
 local folder=Instance.new("Folder");folder.Name="ForgottenAppearance";folder.Parent=model
 local palette=palettes[id];local head=model:FindFirstChild("Head");local torso=Visuals.anchor(model,"Torso")
 for _,part in ipairs(model:GetChildren()) do
  if part:IsA("BasePart") and part.Name~="HumanoidRootPart" then
   part.Transparency=0;part.Material=Enum.Material.SmoothPlastic
   part.Color=rgb(palette.skin)
   if part.Name:find("Torso") then part.Color=rgb(palette.torso)
   elseif part.Name:find("Leg") or part.Name:find("Foot") then part.Color=rgb(palette.legs) end
  end
 end
 -- Native Roblox head geometry and built-in smile, rather than a hidden head + cube stack.
 if head then
  for _,child in ipairs(head:GetChildren()) do if child:IsA("Decal") or child:IsA("SpecialMesh") then child:Destroy() end end
  if head:IsA("Part") then
   head.Size=Vector3.new(2,1,1)
   local mesh=Instance.new("SpecialMesh");mesh.MeshType=Enum.MeshType.Head;mesh.Scale=Vector3.new(1.25,1.25,1.25);mesh.Parent=head
  end
  if id=="pelotocino" or id=="tubers93" then
   local face=Instance.new("Decal");face.Name="ClassicSmile";face.Face=Enum.NormalId.Front;face.Texture="rbxasset://textures/face.png";face.Parent=head
  elseif id=="yellowguy" then
   local gui=surface(head,"RostroYellowGuy")
   for _,feature in ipairs(Faces.yellowguy) do
    local shape=panel(gui,feature.position,feature.size,feature.color);shape.Name=feature.name;shape.Rotation=feature.rotation
   end
  elseif id=="guest666" then
   local gui=surface(head,"OjosGuest")
   for _,x in ipairs({.35,.59}) do local eye=panel(gui,{x,.37},{.06,.14},{217,20,34});local round=Instance.new("UICorner");round.CornerRadius=UDim.new(1,0);round.Parent=eye end
  else head.Transparency=1 end
 end
 if id=="pelotocino" or id=="tubers93" or id=="yellowguy" then
  local shirt=surface(torso,"CamisetaYChaqueta")
  panel(shirt,{.3,.02},{.4,.96},id=="yellowguy" and {24,141,202} or {14,102,157})
  for _,x in ipairs({.24,.72}) do local lapel=panel(shirt,{x,.03},{.07,.58},{43,47,49});lapel.Rotation=x&lt;.5 and -10 or 10 end
  if id=="yellowguy" then
   panel(shirt,{.43,.3},{.045,.2},{25,61,74});panel(shirt,{.43,.3},{.14,.04},{25,61,74});panel(shirt,{.43,.38},{.1,.035},{25,61,74})
  end
 elseif id=="guest666" then
  local gui=surface(torso,"CamisetaGuest")
  local text=Instance.new("TextLabel");text.Size=UDim2.fromScale(.94,.27);text.Position=UDim2.fromScale(.03,.25);text.BackgroundTransparency=1
  text.Text="ROBLOX";text.TextScaled=true;text.Font=Enum.Font.GothamBlack;text.TextColor3=Color3.fromRGB(230,228,217);text.TextStrokeColor3=Color3.fromRGB(149,26,36);text.TextStrokeTransparency=0;text.Parent=gui
 elseif id=="deathspeaker" or id=="junkbot" then
  for _,part in ipairs(model:GetChildren()) do if part:IsA("BasePart") then part.Transparency=1 end end
 end
 local officialHair=model:GetAttribute("OfficialBaconHair")
 for index,spec in ipairs(Data[id] or {}) do
  local hair=spec.name:find("Bacon") or spec.name=="Cabellera" or spec.name=="Veta de cabello" or spec.name=="Patilla curva"
  if not (officialHair and hair) then
   local anchor=Visuals.anchor(model,spec.anchor,spec.name)
   if anchor then
    if spec.body then anchor.Transparency=1 end
    local group=Geometry.build(folder,anchor,spec);group:SetAttribute("VisualSpecIndex",index)
    if spec.weapon=="cane" then group:SetAttribute("WeaponKind","cane") end
   end
  end
 end
 model:SetAttribute("VisualVersion",4);model:SetAttribute("GeometryBackend","Native shapes + authored surfaces")
end
return Visuals
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientChallenge</string>
          <ProtectedString name="Source">local T=require(script.Parent.ClientTheme)
return function(gui,remote)
 local box=T.frame(gui,"Desafio",UDim2.fromScale(.15,.2),UDim2.fromScale(.7,.55),T.bg);box.Visible=false;box.ZIndex=40
 local title=T.label(box,"Titulo","",UDim2.fromScale(.04,.03),UDim2.fromScale(.8,.1),21,T.gold)
 local hint=T.label(box,"Indicacion","",UDim2.fromScale(.04,.15),UDim2.fromScale(.92,.18),15)
 local body=T.frame(box,"Controles",UDim2.fromScale(.04,.36),UDim2.fromScale(.92,.59),T.panel)
 local stages=T.frame(box,"Etapas",UDim2.fromScale(.04,.31),UDim2.fromScale(.92,.012),T.bg)
 local data;local lastClick=0;local clockLabel;local timerBar
 local function close(send) data=nil;box.Visible=false;if send then remote:FireServer("challengeCancel") end end
 T.button(box,"Cerrar","×",UDim2.fromScale(.87,.02),UDim2.fromScale(.1,.1),function()close(true)end)
 local function input(value)
  if data and os.clock()-lastClick&gt;=.16 then lastClick=os.clock();remote:FireServer("challenge",data.token,value) end
 end
 local names={"ROJO","AZUL","AMARILLO","VERDE"}
 local colors={Color3.fromRGB(168,64,60),Color3.fromRGB(58,107,177),Color3.fromRGB(163,139,57),Color3.fromRGB(57,132,94)}
 local function open(payload)
  data=payload;box.Visible=true;T.clear(body);T.clear(stages);stages.Visible=payload.family=="generator";clockLabel=nil;timerBar=nil
  local c=data.challenge
  local stageNames={wires="CABLEADO",switches="INTERRUPTORES",rope="ARRANQUE",memory="MEMORIA",piano="PIANO",reflex="REFLEJOS",maze="LABERINTO"}
  title.Text=(data.family=="generator" and "GENERADOR " or "ESTACIÓN ")..data.id.." · "..(stageNames[c.kind] or c.kind)
  if data.family=="generator" then
   title.Text=title.Text.." · "..data.stage.."/3"
   for stage=1,3 do T.frame(stages,"Etapa",UDim2.fromScale((stage-1)*.34,0),UDim2.fromScale(.32,1),stage&lt;data.stage and T.green or stage==data.stage and T.gold or T.edge) end
  end
  if c.kind=="memory" or c.kind=="piano" or c.kind=="wires" then
   local sequence={};for _,value in ipairs(c.sequence) do table.insert(sequence,c.kind=="piano" and ({"DO","RE","MI","SOL"})[value] or names[value]) end
   hint.Text=c.kind=="wires" and "Conecta los cables en este orden:" or c.kind=="piano" and "Repite la melodía con las teclas:" or "Memoriza la secuencia antes de que desaparezca."
   clockLabel=T.label(body,"Secuencia",c.kind=="memory" and workspace:GetServerTimeNow()&gt;=c.readyAt and ("RECUERDA · PASO "..c.step) or table.concat(sequence," → "),UDim2.fromScale(.02,.04),UDim2.fromScale(.96,.3),19,T.gold)
   for i=1,4 do
    local pad=T.button(body,"Pad"..i,c.kind=="piano" and ({"DO","RE","MI","SOL"})[i] or names[i],UDim2.fromScale(.02+(i-1)*.245,.45),UDim2.fromScale(.225,.45),function()input(i)end,colors[i])
    if c.kind=="wires" then
     T.frame(pad,"Terminal",UDim2.fromScale(.4,0),UDim2.fromScale(.2,.12),T.gold)
     T.label(pad,"Numero",tostring(i),UDim2.fromScale(.03,.02),UDim2.fromScale(.2,.25),12)
    end
   end
   if c.kind~="memory" then hint.Text=hint.Text.." Paso "..c.step.."/"..#c.sequence end
  elseif c.kind=="switches" then
   hint.Text="Deja los interruptores en la posición indicada arriba."
   for i=1,4 do
    T.label(body,"Meta"..i,c.target[i] and "ENCENDIDO" or "APAGADO",UDim2.fromScale(.02+(i-1)*.245,.08),UDim2.fromScale(.225,.2),13,T.gold)
    T.button(body,"Interruptor"..i,c.current[i] and "ON" or "OFF",UDim2.fromScale(.02+(i-1)*.245,.4),UDim2.fromScale(.225,.45),function()input(i)end,c.current[i] and T.green or T.edge)
   end
  elseif c.kind=="reflex" then
   hint.Text="Espera la señal verde. Pulsar antes cancela el intento."
   clockLabel=T.label(body,"Semaforo","ESPERA…",UDim2.fromScale(.1,.05),UDim2.fromScale(.8,.35),26,T.red)
   T.button(body,"Reaccionar","PULSAR",UDim2.fromScale(.2,.5),UDim2.fromScale(.6,.38),function()input("hit")end)
  elseif c.kind=="rope" then
   hint.Text="Tira cuando el marcador esté dentro de la franja verde. Tres tirones correctos."
   local track=T.frame(body,"Pista",UDim2.fromScale(.05,.15),UDim2.fromScale(.9,.15),T.bg)
   T.frame(track,"Zona",UDim2.fromScale(.3,0),UDim2.fromScale(.4,1),T.green)
   timerBar=T.frame(track,"Marcador",UDim2.fromScale(0,0),UDim2.fromScale(.025,1),T.gold)
   T.button(body,"Tirar","TIRAR · "..c.pulls.."/3",UDim2.fromScale(.2,.5),UDim2.fromScale(.6,.38),function()input("pull")end)
  elseif c.kind=="maze" then
   hint.Text="Guía la energía hasta la casilla dorada."
   for y,row in ipairs(c.grid) do for x=1,7 do
    local tint=row:sub(x,x)=="1" and T.edge or T.bg
    if x==6 and y==6 then tint=T.gold end
    if x==c.x and y==c.y then tint=T.green end
    T.frame(body,"Celda",UDim2.fromScale(.03+(x-1)*.065,.03+(y-1)*.128),UDim2.fromScale(.06,.12),tint)
   end end
   for _,control in ipairs({{"up","↑",.72,.12},{"left","←",.58,.45},{"down","↓",.72,.7},{"right","→",.86,.45}}) do
    T.button(body,control[1],control[2],UDim2.fromScale(control[3],control[4]),UDim2.fromScale(.12,.22),function()input(control[1])end)
   end
  end
 end
 game:GetService("RunService").RenderStepped:Connect(function()
  if not data or not box.Visible then return end
  local c=data.challenge;local now=workspace:GetServerTimeNow()
  if c.kind=="memory" and clockLabel and now&gt;=c.readyAt then clockLabel.Text="RECUERDA · PASO "..c.step.."/"..#c.sequence end
  if c.kind=="reflex" and clockLabel then
   local ready=now&gt;=c.readyAt and now&lt;=c.readyAt+1.2
   clockLabel.Text=ready and "¡AHORA!" or now&gt;c.readyAt+1.2 and "TIEMPO AGOTADO" or "ESPERA…"
   clockLabel.TextColor3=ready and T.green or T.red
  end
  if c.kind=="rope" and timerBar then timerBar.Position=UDim2.fromScale(now&lt;c.readyAt and 0 or ((now-c.readyAt)%1.8)/1.8,0) end
 end)
 return {open=open,close=function()close(false)end,visible=function()return box.Visible end}
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientEffects</string>
          <ProtectedString name="Source">local Debris=game:GetService("Debris")
local TweenService=game:GetService("TweenService")
local SoundService=game:GetService("SoundService")
local Music=require(script.Parent.Music)
local RunService=game:GetService("RunService")
local Geometry=require(script.Parent.VisualGeometry)
local VisualData=require(script.Parent.CharacterVisualData)
return function(enabled)
 local folder=Instance.new("Folder");folder.Name="EfectosLocalesForgotten";folder.Parent=workspace
 local function sound(key)
  local id=Music.sfx and Music.sfx[key]
  if type(id)~="string" or not id:match("^rbxassetid://%d+$") then return end
  local s=Instance.new("Sound");s.SoundId=id;s.Volume=.3;s.Parent=SoundService;s:Play();Debris:AddItem(s,8)
 end
 local function effect(data)
  if not enabled() or #folder:GetChildren()&gt;24 then return end
  local weapon=data.ability
  if data.model and (weapon=="plasma" or weapon=="overdrive" or weapon=="selfRepair") and data.kind~="beam" then
   local torso=data.model:FindFirstChild("UpperTorso") or data.model:FindFirstChild("Torso")
   local hand=data.model:FindFirstChild("RightHand") or data.model:FindFirstChild("Right Arm")
   local anchor=weapon=="plasma" and hand or torso
   if anchor then
    local attachment=Instance.new("Attachment");attachment.Name="V4EnergyFX"
    attachment.Position=weapon=="overdrive" and Vector3.new(0,0,.6) or weapon=="selfRepair" and Vector3.new(0,-.25,-.6) or Vector3.new(0,-.55,0)
    attachment.Parent=anchor
    local particles=Instance.new("ParticleEmitter");particles.Texture="rbxasset://textures/particles/sparkles_main.dds"
    particles.Color=ColorSequence.new(weapon=="selfRepair" and Color3.fromRGB(218,166,71) or Color3.fromRGB(72,186,224))
    particles.LightEmission=.8;particles.Lifetime=NumberRange.new(.12,.3);particles.Speed=NumberRange.new(weapon=="overdrive" and 6 or 1,weapon=="overdrive" and 12 or 3)
    particles.SpreadAngle=Vector2.new(18,18);particles.EmissionDirection=Enum.NormalId.Back;particles.Rate=0
    particles.Size=NumberSequence.new({NumberSequenceKeypoint.new(0,.12),NumberSequenceKeypoint.new(1,0)})
    particles.Parent=attachment;particles:Emit(14);Debris:AddItem(attachment,.6)
   end
  end
  if data.model and (weapon=="scythe" or weapon=="spin" or weapon=="cane" or weapon=="pan" or weapon=="claw") then
   local arm=data.model:FindFirstChild("RightHand") or data.model:FindFirstChild("Right Arm")
   if arm then
    local a=Instance.new("Attachment");local b=Instance.new("Attachment")
    a.Position=Vector3.new(0,-.2,-.6)
    if weapon=="scythe" or weapon=="spin" then a.Position=Vector3.new(0,2.4,-.65);b.Position=Vector3.new(2,1.5,-.65)
    elseif weapon=="cane" then b.Position=Vector3.new(0,-2.45,-.58)
    else b.Position=Vector3.new(.4,-1,-.85) end
    a.Parent=arm;b.Parent=arm
    local trail=Instance.new("Trail");trail.Attachment0=a;trail.Attachment1=b;trail.Lifetime=.15;trail.MinLength=.05;trail.FaceCamera=true
    trail.Color=ColorSequence.new(data.color=="red" and Color3.fromRGB(202,67,51) or Color3.fromRGB(207,180,112))
    trail.Transparency=NumberSequence.new({NumberSequenceKeypoint.new(0,.35),NumberSequenceKeypoint.new(1,1)});trail.Parent=folder
    task.delay(.65,function()if trail.Parent then trail.Enabled=false end end)
    Debris:AddItem(trail,.9);Debris:AddItem(a,.9);Debris:AddItem(b,.9)
   end
  end
  if data.kind=="projectile" and data.finish then
   local start=data.position
   if data.model and not data.returning then
    local hand=data.model:FindFirstChild("RightHand") or data.model:FindFirstChild("Right Arm")
    if hand then start=hand.Position+hand.CFrame.UpVector*-.65 end
   end
   local projectile=Instance.new("Model");projectile.Name="Proyectil_"..tostring(data.projectile)
   local root=Instance.new("Part");root.Name="Centro";root.Size=Vector3.new(.1,.1,.1);root.CFrame=CFrame.new();root.Transparency=1
   root.Anchored=true;root.CanCollide=false;root.CanTouch=false;root.CanQuery=false;root.Parent=projectile;projectile.PrimaryPart=root
   if data.projectile=="cane" then
    for _,spec in ipairs(VisualData.yellowguy) do if spec.weapon=="cane" then Geometry.build(projectile,root,spec) end end
   else
    for _,spec in ipairs(VisualData.pelotocino) do if spec.name=="Mechón Bacon 0" then Geometry.build(projectile,root,spec);break end end
   end
   projectile.Parent=folder
   local began=os.clock();local duration=math.max(.1,data.duration or .4);local connection
   connection=RunService.RenderStepped:Connect(function()
    if not projectile.Parent then connection:Disconnect();return end
    local t=math.clamp((os.clock()-began)/duration,0,1)
    local finish=data.finish
    if data.returning and data.model and data.model.Parent then
     local hand=data.model:FindFirstChild("RightHand") or data.model:FindFirstChild("Right Arm")
     if hand then finish=hand.Position end
    end
    local position=start:Lerp(finish,t)+Vector3.new(0,math.sin(t*math.pi)*(data.returning and .4 or 1.2),0)
    projectile:PivotTo(CFrame.new(position)*CFrame.Angles(0,0,t*math.pi*3))
    if t&gt;=1 then connection:Disconnect();projectile:Destroy() end
   end)
   Debris:AddItem(projectile,duration+1);sound("skill");return
  end
  if data.model and (data.kind=="transformation" or data.kind=="step") then
   local highlight=Instance.new("Highlight");highlight.Adornee=data.model;highlight.FillTransparency=.75;highlight.OutlineTransparency=.35
   highlight.FillColor=data.kind=="transformation" and Color3.fromRGB(161,22,39) or Color3.fromRGB(49,165,198);highlight.OutlineColor=highlight.FillColor;highlight.Parent=folder
   Debris:AddItem(highlight,data.kind=="transformation" and 1.5 or .6)
   if data.kind=="step" then
    local previous={}
    for _,part in ipairs(data.model:GetDescendants()) do if part:IsA("BasePart") then previous[part]=part.LocalTransparencyModifier;part.LocalTransparencyModifier=math.max(.75,part.LocalTransparencyModifier) end end
    task.delay(.3,function()for part,value in pairs(previous) do if part.Parent then part.LocalTransparencyModifier=value end end end)
   end
  end
  local p=Instance.new("Part");p.Name="FX_"..data.kind;p.Anchored=true;p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.CastShadow=false;p.Material=Enum.Material.Neon
  p.Color=data.color=="red" and Color3.fromRGB(192,69,51) or Color3.fromRGB(68,162,188)
  p.Transparency=.65
  local duration=math.max(.15,math.min(data.duration or .4,6))
  if data.kind=="beam" and data.finish then
   local start=data.position
   if data.ability=="plasma" and data.model then
    local hand=data.model:FindFirstChild("RightHand") or data.model:FindFirstChild("Right Arm")
    if hand then start=hand.Position end
   end
   local distance=(data.finish-start).Magnitude
   if distance&lt;.1 then p:Destroy();return end
   p.Size=Vector3.new(.18,.18,distance);p.CFrame=CFrame.lookAt((start+data.finish)/2,data.finish)
  else
   local radius=math.min(data.radius or 2,24)
   p.Shape=Enum.PartType.Ball;p.Size=Vector3.new(radius*2,.22,radius*2);p.Position=data.position-Vector3.new(0,2.4,0)
   if data.kind=="fire" then local fire=Instance.new("Fire");fire.Size=4;fire.Heat=0;fire.Parent=p end
  end
  p.Parent=folder;TweenService:Create(p,TweenInfo.new(duration),{Transparency=1}):Play();Debris:AddItem(p,duration+.1)
  sound(data.kind=="hit" and "hit" or "skill")
 end
 local function reveal(data)
  for _,model in ipairs(data.models or {}) do
   if typeof(model)=="Instance" and model:IsA("Model") then
    local h=Instance.new("Highlight");h.Adornee=model;h.FillColor=Color3.fromRGB(214,88,74);h.FillTransparency=.8;h.OutlineTransparency=.15
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop;h.Parent=folder;Debris:AddItem(h,math.min(data.duration or 5,10))
   end
  end
 end
 return {effect=effect,reveal=reveal,sound=sound}
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientEnvironment</string>
          <ProtectedString name="Source">-- Local lighting profiles: players in the lobby retain its warm refuge lighting.
local Environment={}
local styles={
 disaster_island={hour=5.1,exposure=.2,fog=.26,tint={214,230,237}},
 pizza_place={hour=.7,exposure=.25,fog=.17,tint={255,223,191}},
 forgotten_heights={hour=4.7,exposure=.2,fog=.24,tint={201,222,244}},
 research_facility={hour=1,exposure=.28,fog=.16,tint={210,243,232}},
 cursed_manor={hour=.2,exposure=.19,fog=.25,tint={233,217,236}},
 forgotten_robloxia={hour=5,exposure=.2,fog=.23,tint={224,232,213}},
 junkbot_factory={hour=1,exposure=.26,fog=.2,tint={240,224,191}},
 corrupted_arcade={hour=0,exposure=.22,fog=.16,tint={221,210,249}},
 ballers_arena={hour=4.9,exposure=.26,fog=.18,tint={239,226,208}}}
local lobby={hour=.5,exposure=.2,fog=.22,tint={255,237,211}}
function Environment.start()
 local Lighting=game:GetService("Lighting");local Tween=game:GetService("TweenService");local current
 local function update(state,inRound)
  local key=inRound and state.phase=="Ronda" and state.mapId or "lobby"
  if key==current then return end;current=key
  local profile=styles[key] or lobby
  Tween:Create(Lighting,TweenInfo.new(1.2),{ClockTime=profile.hour,ExposureCompensation=profile.exposure}):Play()
  local atmosphere=Lighting:FindFirstChild("ForgottenAtmosphere")
  if atmosphere then Tween:Create(atmosphere,TweenInfo.new(1.2),{Density=profile.fog}):Play() end
  local grade=Lighting:FindFirstChild("ForgottenGrade")
  if grade then Tween:Create(grade,TweenInfo.new(1.2),{TintColor=Color3.fromRGB(profile.tint[1],profile.tint[2],profile.tint[3]),Contrast=.13,Saturation=-.07}):Play() end
 end
 return update
end
return Environment
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientMenus</string>
          <ProtectedString name="Source">local T=require(script.Parent.ClientTheme)
local Preview=require(script.Parent.ClientPreview)
local Shop=require(script.Parent.ShopCatalog)
local Economy=require(script.Parent.EconomyConfig)
local Maps=require(script.Parent.MapCatalog)
local Abilities=require(script.Parent.AbilityConfig)
local Roster=require(script.Parent.Roster)
return function(gui,remote)
 local self={selected="pelotocino",profile=nil,page="play",section="featured",state={phase="Lobby"},currentItem="cosmetic:scarf",quality=true}
 local root=T.frame(gui,"MenuPrincipal",UDim2.fromScale(.03,.2),UDim2.fromScale(.94,.54),T.bg);root.ZIndex=10
 local nav=T.frame(root,"Navegacion",UDim2.fromScale(.015,.025),UDim2.fromScale(.18,.95),T.panel)
 T.label(nav,"Marca","FORGOTTEN",UDim2.fromScale(.03,.02),UDim2.fromScale(.94,.1),21,T.gold)
 T.label(nav,"Edicion","V2 · EL ÚLTIMO REFUGIO",UDim2.fromScale(.03,.13),UDim2.fromScale(.94,.09),10,T.muted)
 local content=T.frame(root,"Contenido",UDim2.fromScale(.21,.025),UDim2.fromScale(.775,.95),T.panel)
 local redraw
 local function equipped(id)
  return self.profile and self.profile.equipped[id] or {skin=id..":base",cosmetic=""}
 end
 local function title(words)T.label(content,"Titulo",words,UDim2.fromScale(.03,.02),UDim2.fromScale(.9,.1),23,T.gold)end
 local function previewCard(id,equipment,pos,size,pose)
  local card=T.frame(content,"Vista",pos,size,T.bg);Preview.show(card,id,equipment,pose);return card
 end
 local function characterList()
  title("PERSONAJES · ELIGE TU HISTORIA")
  local list=T.scroll(content,"Personajes",UDim2.fromScale(.03,.15),UDim2.fromScale(.43,.81))
  for _,entry in ipairs(Roster) do
   local row=T.frame(list,entry.id,UDim2.new(),UDim2.new(1,-6,0,66),entry.id==self.selected and T.edge or T.bg)
   Preview.icon(row,entry.id,UDim2.fromScale(.02,.08),UDim2.fromScale(.17,.84))
   T.button(row,"Elegir",entry.name.."\n"..entry.role,UDim2.fromScale(.22,.08),UDim2.fromScale(.75,.84),function()remote:FireServer("select",entry.id)end,T.panel)
  end
  previewCard(self.selected,equipped(self.selected),UDim2.fromScale(.49,.13),UDim2.fromScale(.48,.53))
  local names={};for _,a in ipairs(Abilities[self.selected]) do table.insert(names,a.name) end
  T.label(content,"Habilidades",table.concat(names," · ").."\nLa apariencia se equipa al comenzar la ronda.",UDim2.fromScale(.49,.68),UDim2.fromScale(.48,.27),14)
 end
 local function shopView(inventory)
  title(inventory and "TU INVENTARIO PERMANENTE" or "TIENDA DEL REFUGIO")
  local sectionNames=inventory and {{"character","Personajes"},{"skin","Skins"},{"cosmetic","Cosméticos"}} or {{"featured","Destacados"},{"character","Personajes"},{"skin","Skins"},{"cosmetic","Cosméticos"}}
  if inventory and self.section=="featured" then self.section="skin" end
  for i,pair in ipairs(sectionNames) do
   T.button(content,pair[1],pair[2],UDim2.fromScale(.03+(i-1)*.235,.14),UDim2.fromScale(.22,.09),function()self.section=pair[1];redraw()end,self.section==pair[1] and T.edge or T.bg)
  end
  local list=T.scroll(content,"Articulos",UDim2.fromScale(.03,.27),UDim2.fromScale(.44,.66))
  local shown={};local item
  for _,candidate in ipairs(Shop) do
   local category=self.section=="featured" and candidate.featured or candidate.kind==self.section
   local own=self.profile and self.profile.owned[candidate.id]
   if category and (candidate.kind~="skin" or candidate.character==self.selected) and (not inventory or own) then
    table.insert(shown,candidate);if candidate.id==self.currentItem then item=candidate end
    local row=T.frame(list,candidate.id,UDim2.new(),UDim2.new(1,-6,0,82),candidate.id==self.currentItem and T.edge or T.bg)
    Preview.icon(row,candidate.character or self.selected,UDim2.fromScale(.02,.1),UDim2.fromScale(.16,.8))
    local price=candidate.mastery and ("Maestría "..Economy.milestoneXP[candidate.tier]) or candidate.included and "Incluido" or (candidate.price.." Coins")
    T.label(row,"Nombre",candidate.name.."\n"..price.." · "..(own and "En inventario" or "Sin desbloquear"),UDim2.fromScale(.2,.03),UDim2.fromScale(.58,.92),13)
    T.button(row,"Ver","VER",UDim2.fromScale(.8,.14),UDim2.fromScale(.18,.7),function()self.currentItem=candidate.id;redraw()end)
   end
  end
  item=item or shown[1]
  if not item then T.label(content,"Vacio","Aún no hay artículos en esta sección.",UDim2.fromScale(.5,.3),UDim2.fromScale(.45,.3),16);return end
  self.currentItem=item.id
  local id=item.character or self.selected;local worn=equipped(id)
  local equipment={skin=item.kind=="skin" and item.id or worn.skin,cosmetic=item.kind=="cosmetic" and item.id or worn.cosmetic}
  previewCard(id,equipment,UDim2.fromScale(.5,.26),UDim2.fromScale(.47,.43))
  local owned=self.profile and self.profile.owned[item.id]
  local requirement=item.mastery and ("Maestría "..(self.profile and self.profile.xp[id] or 0).." / "..Economy.milestoneXP[item.tier]) or "Cosmético · sin ventajas de combate"
  T.label(content,"Requisito",item.name.."\n"..requirement,UDim2.fromScale(.5,.69),UDim2.fromScale(.47,.12),13)
  local action=owned and (item.kind=="character" and "ELEGIR" or "EQUIPAR") or item.mastery and "BLOQUEADO" or "COMPRAR · "..tostring(item.price)
  local buy=T.button(content,"Accion",action,UDim2.fromScale(.5,.83),UDim2.fromScale(.3,.11),function()
   if owned then
    if item.kind=="character" then remote:FireServer("select",item.character)
    else remote:FireServer("equip",id,item.id) end
   elseif not item.mastery then remote:FireServer("buy",item.id) end
  end,owned and T.green or T.edge)
  buy.Active=self.profile~=nil and self.profile.mode~="locked" and (owned or not item.mastery)
  if not self.profile then buy.Text="CARGANDO…" elseif self.profile.mode=="locked" then buy.Text="SOLO LECTURA" end
  T.button(content,"Quitar","QUITAR\nCOSMÉTICO",UDim2.fromScale(.82,.83),UDim2.fromScale(.15,.11),function()remote:FireServer("equip",id,"none")end,T.bg)
 end
 redraw=function()
  T.clear(content)
  if self.page=="characters" then characterList()
  elseif self.page=="shop" or self.page=="inventory" then shopView(self.page=="inventory")
  elseif self.page=="maps" then
   title("ESCENARIOS · VOTA EL PRÓXIMO MAPA")
   local list=T.scroll(content,"Mapas",UDim2.fromScale(.03,.16),UDim2.fromScale(.94,.8))
   for i,map in ipairs(Maps) do
    local row=T.frame(list,map.id,UDim2.new(),UDim2.new(1,-6,0,72),T.bg)
    T.label(row,"Nombre",string.format("%02d",i).."  "..map.name.."\n"..map.description,UDim2.fromScale(.03,.08),UDim2.fromScale(.74,.84),15)
    T.button(row,"Votar","VOTAR",UDim2.fromScale(.8,.16),UDim2.fromScale(.17,.68),function()remote:FireServer("map",map.id)end)
   end
  elseif self.page=="settings" then
   title("ATMÓSFERA Y ACCESIBILIDAD")
   T.button(content,"Efectos",self.quality and "EFECTOS: COMPLETOS" or "EFECTOS: REDUCIDOS",UDim2.fromScale(.08,.25),UDim2.fromScale(.84,.2),function()self.quality=not self.quality;redraw()end)
   T.label(content,"Nota","La opción reducida limita destellos y partículas. Los retratos y canciones definitivos se incorporarán cuando estén disponibles.",UDim2.fromScale(.08,.55),UDim2.fromScale(.84,.3),16,T.muted)
  else
   title("EL CAMPAMENTO ES TU REFUGIO")
   previewCard(self.selected,equipped(self.selected),UDim2.fromScale(.54,.15),UDim2.fromScale(.43,.77))
   T.label(content,"Bienvenida","Explora la cabaña, visita el club house y elige tu personaje.\n\n4 minutos. Repara generadores, resuelve puzles y deposita cápsulas. La salida debe cruzarse físicamente.",UDim2.fromScale(.04,.17),UDim2.fromScale(.46,.46),18)
   T.button(content,"Personajes","ELEGIR PERSONAJE",UDim2.fromScale(.05,.66),UDim2.fromScale(.43,.12),function()self.page="characters";redraw()end,T.green)
   local play=T.button(content,"Practica",self.state.canPractice and "PROBAR SOLO" or "ESPERANDO A LOS JUGADORES",UDim2.fromScale(.05,.81),UDim2.fromScale(.43,.12),function()if self.state.canPractice then remote:FireServer("practice")end end)
   play.Active=self.state.canPractice==true
  end
 end
 for i,page in ipairs({{"play","JUGAR"},{"characters","PERSONAJES"},{"maps","MAPAS"},{"shop","TIENDA"},{"inventory","INVENTARIO"},{"settings","AJUSTES"}}) do
  T.button(nav,page[1],page[2],UDim2.fromScale(.06,.27+(i-1)*.105),UDim2.fromScale(.88,.09),function()self.page=page[1];redraw()end,T.bg)
 end
 T.button(root,"Ocultar","×",UDim2.fromScale(.955,.015),UDim2.fromScale(.035,.07),function()root.Visible=false end)
 function self.open(page) if self.state.phase~="Lobby" then return end;self.page=page or self.page;root.Visible=true;redraw() end
 function self.setProfile(data)self.profile=data;if root.Visible then redraw() end end
 function self.setSelected(id)self.selected=id;if root.Visible then redraw() end end
 function self.setState(state)
  local changed=self.state.phase~=state.phase or self.state.canPractice~=state.canPractice
  self.state=state
  if state.phase~="Lobby" then root.Visible=false elseif changed then root.Visible=true;redraw() end
 end
 function self.effectsEnabled()return self.quality end
 function self.visible()return root.Visible end
 redraw();return self
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientMusic</string>
          <ProtectedString name="Source">local Players=game:GetService("Players")
local SoundService=game:GetService("SoundService")
local TweenService=game:GetService("TweenService")
local Music=require(script.Parent.Music)
return function(label)
 local currentKey,currentSound="",nil
 local started=os.clock()
 local function switch(key,track,looped)
  if key==currentKey then return end
  currentKey=key
  if currentSound then local old=currentSound;TweenService:Create(old,TweenInfo.new(.6),{Volume=0}):Play();task.delay(.65,function()old:Destroy()end);currentSound=nil end
  if not track then label.Text="AMBIENTE EN SILENCIO";return end
  local available=type(track.soundId)=="string" and track.soundId:match("^rbxassetid://%d+$")
  label.Text=track.title..(available and "" or " · audio pendiente")
  if not available then return end
  local s=Instance.new("Sound");s.Name="ForgottenMusic";s.SoundId=track.soundId;s.Looped=looped;s.Volume=0;s.Parent=SoundService;currentSound=s
  s.Loaded:Connect(function()if looped and s.TimeLength&gt;0 then s.TimePosition=(os.clock()-started)%s.TimeLength end end)
  s:Play();TweenService:Create(s,TweenInfo.new(.6),{Volume=.4}):Play()
  task.delay(8,function()if currentSound==s and not s.IsLoaded then label.Text=track.title.." · audio no disponible" end end)
 end
 return function(state)
  local player=Players.LocalPlayer;local c=player.Character;local root=c and c:FindFirstChild("HumanoidRootPart");local h=c and c:FindFirstChildOfClass("Humanoid")
  if state.phase=="Lobby" or (state.phase=="Ronda" and not player:GetAttribute("InRound") and h and h.Health&gt;0) then switch("lobby",Music.lobby,true)
  elseif state.phase~="Ronda" or not root or not h or h.Health&lt;=0 then switch("silent",nil,false)
  elseif state.mode=="LMS" then local key=state.musicKey~="" and state.musicKey or "lastHope";switch(key,Music[key] or Music.lastHope,false)
  elseif state.gateOpen then switch("exit",Music.exit,true)
  else
   local killer=Players:GetPlayerByUserId(state.killerUserId or 0)
   local killerId=killer and killer:GetAttribute("CharacterId")
   local track=killerId=="tubers93" and Music.shadowReaper or killerId=="guest666" and Music.guestChase
   local distance=math.huge
   if track then
    for _,other in ipairs(Players:GetPlayers()) do
     if (player==killer and other~=killer) or (player~=killer and other==killer) then
      local otherChar=other.Character;local otherRoot=otherChar and otherChar:FindFirstChild("HumanoidRootPart")
      if other:GetAttribute("InRound") and otherRoot then distance=math.min(distance,(root.Position-otherRoot.Position).Magnitude) end
     end
    end
   end
   local layer
   if track then for i,item in ipairs(track.layers) do if distance&lt;=item.distance then layer=i end end end
   if layer then local item=track.layers[layer];switch(killerId..":"..layer,{title=track.title.." · "..item.title,soundId=item.soundId},true)
   else switch("silent",nil,false) end
  end
 end
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientPreview</string>
          <ProtectedString name="Source">local RS=game:GetService("ReplicatedStorage")
local RunService=game:GetService("RunService")
local Portraits=require(script.Parent.Portraits)
local Cosmetics=require(script.Parent.Cosmetics)
local T=require(script.Parent.ClientTheme)
local AnimationConfig=require(script.Parent.AnimationConfig)
local Motion=require(script.Parent.CharacterMotion)
local Preview={}
local function image(id)return type(Portraits[id])=="string" and Portraits[id]:match("^rbxassetid://%d+$") and Portraits[id] or nil end
function Preview.icon(parent,id,pos,size)
 local portrait=image(id)
 if portrait then
  local img=Instance.new("ImageLabel");img.Size=size;img.Position=pos;img.Image=portrait;img.BackgroundTransparency=1;img.ScaleType=Enum.ScaleType.Fit;img.Parent=parent;return img
 end
 local box=T.frame(parent,"RetratoPendiente",pos,size,T.bg)
 T.label(box,"Inicial",id:sub(1,1):upper(),UDim2.fromScale(0,0),UDim2.fromScale(1,.65),22,T.gold)
 T.label(box,"Estado","PEND.",UDim2.fromScale(0,.65),UDim2.fromScale(1,.35),9,T.muted)
 return box
end
function Preview.show(parent,id,equipment,pose)
 T.clear(parent)
 local viewport=Instance.new("ViewportFrame");viewport.Name="Vista3D";viewport.Size=UDim2.fromScale(1,.87);viewport.BackgroundTransparency=1
 viewport.Ambient=Color3.fromRGB(177,183,189);viewport.LightColor=Color3.fromRGB(255,229,190);viewport.LightDirection=Vector3.new(-1,-1,-1);viewport.Parent=parent
 local caption=T.label(parent,"EstadoModelo","Cargando vista…",UDim2.fromScale(0,.88),UDim2.fromScale(1,.1),12,T.muted)
 local folder=RS:FindFirstChild("CharacterPreviews");local source=folder and folder:FindFirstChild(id)
 if not source then caption.Text="VISTA PENDIENTE";return end
 local world=Instance.new("WorldModel");world.Parent=viewport
 local model=source:Clone();model.Parent=world
 task.defer(function()if model.Parent then require(script.Parent.EditableAppearance).apply(model) end end)
 Cosmetics.apply(model,id,equipment)
 local root=model:FindFirstChild("HumanoidRootPart");if root then root.Anchored=true end
 local center,size=model:GetBoundingBox()
 local camera=Instance.new("Camera");camera.FieldOfView=38;camera.Parent=viewport;viewport.CurrentCamera=camera
 local distance=math.max(size.Y*1.6,size.X*1.5,8)
 local focus=center.Position
 camera.CFrame=CFrame.lookAt(focus+Vector3.new(distance*.25,distance*.08,-distance),focus)
 caption.Text=(model:GetAttribute("Placeholder") and "MODELO PROVISIONAL" or "VISTA 3D · RETRATO PENDIENTE")..((model:GetAttribute("Milestone") or 0)&gt;0 and " · SKIN PROVISIONAL" or "")
 local joints={}
 for _,node in ipairs(model:GetDescendants()) do if node:IsA("Motor6D") then joints[Motion.jointKey(node.Name)]=node end end
 local external
 local animKey=pose=="mvp" and "mvp" or pose=="victory" and (id=="guest666" and "guestVictory" or id=="tubers93" and "tubersVictory" or "results")
 local animationId=animKey and AnimationConfig[animKey]
 if type(animationId)=="string" and animationId:match("^rbxassetid://%d+$") then
  local humanoid=model:FindFirstChildOfClass("Humanoid");local animator=humanoid and humanoid:FindFirstChildOfClass("Animator")
  if animator then
   local animation=Instance.new("Animation");animation.AnimationId=animationId
   local ok,result=pcall(function()return animator:LoadAnimation(animation)end);animation:Destroy()
   if ok then external=result;external:Play() end
  end
 end
 local elapsed=0
 local connection
 connection=RunService.RenderStepped:Connect(function(dt)
  if not viewport.Parent then connection:Disconnect();return end
  elapsed=elapsed+dt
  local aspect=viewport.AbsoluteSize.X/math.max(1,viewport.AbsoluteSize.Y)
  distance=math.max(size.Y*1.6,size.X/math.max(.3,aspect)*1.6,8)
  camera.CFrame=CFrame.lookAt(focus+Vector3.new(math.sin(elapsed*.18)*distance*.18,distance*.08,-distance),focus)
  if not external or not external.IsPlaying then
  local transforms=pose and Motion.presentation(id,pose,elapsed) or Motion.sample(id,"idle",elapsed*2,0,"",100)
  for name,joint in pairs(joints) do
   local v=transforms[name]
   if v then joint.Transform=Motion.toTransform(joint,v) end
  end
  end
 end)
 viewport.Destroying:Connect(function()connection:Disconnect()end)
end
return Preview
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientResults</string>
          <ProtectedString name="Source">local T=require(script.Parent.ClientTheme)
local Preview=require(script.Parent.ClientPreview)
return function(gui)
 local frame=T.frame(gui,"Resultados",UDim2.fromScale(.08,.16),UDim2.fromScale(.84,.62),T.bg);frame.Visible=false;frame.ZIndex=30
 local function show(data,scoreboard)
  T.clear(frame);frame.Visible=true
  T.button(frame,"Cerrar","×",UDim2.fromScale(.92,.02),UDim2.fromScale(.06,.09),function()frame.Visible=false end)
  local me=game:GetService("Players").LocalPlayer.UserId
  local heading=scoreboard and "MARCADOR" or data.practice and "PRÁCTICA FINALIZADA" or "RESULTADOS"
  local featured
  for _,row in ipairs(data.rows or {}) do
   if row.userId==me and not scoreboard and not data.practice then
    heading=row.victory and "VICTORIA DEL ASESINO" or row.status=="Escapó" and "ESCAPASTE" or row.role=="Superviviente" and "NO LOGRASTE ESCAPAR" or "FIN DE RONDA"
   end
   if row.userId==data.mvp then featured=row end
  end
  T.label(frame,"Titulo",heading,UDim2.fromScale(.03,.03),UDim2.fromScale(.86,.09),24,T.gold)
  T.label(frame,"Mapa",data.map or "",UDim2.fromScale(.03,.13),UDim2.fromScale(.9,.07),15,T.muted)
  local list=T.scroll(frame,"Jugadores",UDim2.fromScale(.03,.24),UDim2.fromScale(.54,.64))
  if scoreboard then list.Size=UDim2.fromScale(.94,.64) end
  for i,row in ipairs(data.rows or {}) do
   local line=T.frame(list,tostring(row.userId),UDim2.new(),UDim2.new(1,-6,0,64),row.userId==data.mvp and T.edge or T.panel)
   Preview.icon(line,row.character,UDim2.fromScale(.02,.07),UDim2.fromScale(.13,.86))
   T.label(line,"Jugador",i..". "..row.name.."\n"..row.status,UDim2.fromScale(.18,.04),UDim2.fromScale(.57,.92),14)
   T.label(line,"Puntos",tostring(row.score or 0),UDim2.fromScale(.77,.1),UDim2.fromScale(.2,.8),20,T.gold)
  end
  featured=featured or (data.rows or {})[1]
  if featured and not scoreboard then
   local preview=T.frame(frame,"MVP",UDim2.fromScale(.6,.24),UDim2.fromScale(.37,.54),T.panel)
   Preview.show(preview,featured.character,featured.equipment,featured.victory and "victory" or not scoreboard and "mvp" or nil)
   T.label(frame,"Destacado",(scoreboard and "" or "MVP · ")..featured.name,UDim2.fromScale(.6,.81),UDim2.fromScale(.37,.09),17,T.gold)
  end
  T.label(frame,"Mensaje",data.message or "",UDim2.fromScale(.03,.91),UDim2.fromScale(.94,.07),13,T.muted)
 end
 return {show=show,hide=function()frame.Visible=false end,visible=function()return frame.Visible end}
end
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">ClientTheme</string>
          <ProtectedString name="Source">local T={bg=Color3.fromRGB(14,20,24),panel=Color3.fromRGB(25,34,39),edge=Color3.fromRGB(73,88,88),gold=Color3.fromRGB(222,188,121),text=Color3.fromRGB(235,234,219),muted=Color3.fromRGB(156,174,172),green=Color3.fromRGB(92,169,133),red=Color3.fromRGB(180,78,76)}
function T.frame(parent,name,pos,size,color)
 local f=Instance.new("Frame");f.Name=name;f.Position=pos;f.Size=size;f.BackgroundColor3=color or T.panel;f.BorderSizePixel=0;f.Parent=parent
 local corner=Instance.new("UICorner");corner.CornerRadius=UDim.new(0,8);corner.Parent=f
 return f
end
function T.label(parent,name,words,pos,size,fontSize,color)
 local t=Instance.new("TextLabel");t.Name=name;t.Text=words;t.Position=pos;t.Size=size;t.BackgroundTransparency=1
 t.TextColor3=color or T.text;t.Font=Enum.Font.Gotham;t.TextSize=fontSize or 16;t.TextWrapped=true;t.Parent=parent
 return t
end
function T.button(parent,name,words,pos,size,callback,color)
 local b=Instance.new("TextButton");b.Name=name;b.Text=words;b.Position=pos;b.Size=size;b.BackgroundColor3=color or T.edge
 b.TextColor3=T.text;b.Font=Enum.Font.GothamMedium;b.TextSize=14;b.TextWrapped=true;b.BorderSizePixel=0;b.Parent=parent
 local c=Instance.new("UICorner");c.CornerRadius=UDim.new(0,6);c.Parent=b
 b.Activated:Connect(callback)
 return b
end
function T.scroll(parent,name,pos,size)
 local f=Instance.new("ScrollingFrame");f.Name=name;f.Position=pos;f.Size=size;f.BackgroundTransparency=1;f.BorderSizePixel=0
 f.ScrollBarThickness=5;f.ScrollBarImageColor3=T.gold;f.AutomaticCanvasSize=Enum.AutomaticSize.Y;f.CanvasSize=UDim2.new();f.Parent=parent
 local l=Instance.new("UIListLayout");l.Padding=UDim.new(0,8);l.SortOrder=Enum.SortOrder.LayoutOrder;l.Parent=f
 return f
end
function T.clear(parent)
 for _,child in ipairs(parent:GetChildren()) do if not child:IsA("UIListLayout") and not child:IsA("UICorner") then child:Destroy() end end
end
return T
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">Cosmetics</string>
          <ProtectedString name="Source">-- Provisional milestone geometry, replaceable without touching ownership or gameplay.
local Cosmetics={}
function Cosmetics.apply(model,character,equipment)
 local old=model:FindFirstChild("ForgottenCosmetics");if old then old:Destroy() end
 local folder=Instance.new("Folder");folder.Name="ForgottenCosmetics";folder.Parent=model
 equipment=equipment or {}
 local tier=tonumber(type(equipment.skin)=="string" and equipment.skin:match(":m([1-4])$") or nil) or 0
 local torso=model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
 local head=model:FindFirstChild("Head")
 if not torso or not head then return end
 local colors={Color3.fromRGB(156,109,56),Color3.fromRGB(154,173,188),Color3.fromRGB(195,60,65),Color3.fromRGB(222,190,97)}
 local color=colors[math.max(1,tier)]
 local function piece(name,anchor,size,offset,tint,neon)
  local p=Instance.new("Part");p.Name=name;p.Size=size;p.CFrame=anchor.CFrame*CFrame.new(offset)
  p.Color=tint;p.Material=neon and Enum.Material.Neon or Enum.Material.Metal
  p.CanCollide=false;p.CanTouch=false;p.CanQuery=false;p.Massless=true;p.Parent=folder
  local w=Instance.new("WeldConstraint");w.Part0=anchor;w.Part1=p;w.Parent=p
  return p
 end
 if tier&gt;0 then
  piece("Insignia Milestone "..tier,torso,Vector3.new(.24,.32,.06),Vector3.new(-.55,.3,-torso.Size.Z/2-.06),color)
  for _,side in ipairs({-1,1}) do
   local arm=model:FindFirstChild(side&lt;0 and "LeftUpperArm" or "RightUpperArm") or model:FindFirstChild(side&lt;0 and "Left Arm" or "Right Arm")
   if arm then piece("Brazalete de maestría",arm,Vector3.new(arm.Size.X*1.05,.13,arm.Size.Z*1.06),Vector3.new(0,-.12,0),color,tier==4) end
  end
 end
 if tier&gt;=2 then
  piece("Placa de veterano",torso,Vector3.new(.48,.18,.07),Vector3.new(.5,-.35,-torso.Size.Z/2-.07),color)
 end
 if tier&gt;=3 and character=="guest666" then
  -- No cape. Monstrous details begin at M3 only.
  for _,side in ipairs({-1,1}) do
   local arm=model:FindFirstChild(side&lt;0 and "LeftLowerArm" or "RightLowerArm") or model:FindFirstChild(side&lt;0 and "Left Arm" or "Right Arm")
   if arm then for n=-1,1 do piece("Garra maldita",arm,Vector3.new(.11,.45,.12),Vector3.new(n*.22,-arm.Size.Y/2-.18,-.2),Color3.fromRGB(122,26,36),tier==4) end end
  end
  for i=-2,2 do piece("Diente espectral",head,Vector3.new(.07,.15,.05),Vector3.new(i*.12,-.3,-head.Size.Z/2-.04),Color3.fromRGB(192,171,153)) end
 elseif tier&gt;=3 then
  piece("Emblema de supervivencia",torso,Vector3.new(.34,.42,.07),Vector3.new(0,.23,-torso.Size.Z/2-.08),color,tier==4)
 end
 if tier==4 then
  local light=Instance.new("PointLight");light.Color=color;light.Brightness=.45;light.Range=5;light.Parent=torso
  light.Name="MilestoneGlow";light.Parent=folder:FindFirstChild("Insignia Milestone 4") or torso
 end
 local accessory=equipment.cosmetic
 if accessory=="cosmetic:scarf" then
  piece("Bufanda",torso,Vector3.new(torso.Size.X*1.04,.22,torso.Size.Z*1.06),Vector3.new(0,torso.Size.Y/2-.12,0),Color3.fromRGB(120,58,50))
 elseif accessory=="cosmetic:lantern" then
  local lamp=piece("Linterna",torso,Vector3.new(.3,.55,.3),Vector3.new(torso.Size.X/2+.22,-.7,0),Color3.fromRGB(224,183,89),true)
  local l=Instance.new("PointLight");l.Range=7;l.Brightness=.4;l.Color=lamp.Color;l.Parent=lamp
 elseif accessory=="cosmetic:badge" then
  piece("Insignia del refugio",torso,Vector3.new(.35,.35,.06),Vector3.new(.55,.35,-torso.Size.Z/2-.06),Color3.fromRGB(181,151,73))
 elseif accessory=="cosmetic:radio" then
  piece("Radio",torso,Vector3.new(.4,.6,.2),Vector3.new(.55,.05,-torso.Size.Z/2-.18),Color3.fromRGB(40,53,48))
 end
 model:SetAttribute("Milestone",tier)
end
return Cosmetics
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">EconomyConfig</string>
          <ProtectedString name="Source">-- Experimental V2 tuning. No Robux, no combat bonuses from purchases.
return {currency="Forgotten Coins",starterCoins=100,participationSeconds=45,
 rewards={participation=15,generator=12,puzzle=8,escape=40,killerWin=50,mvp=10},
 mastery={participation=10,generator=8,puzzle=6,escape=25,killerWin=30,mvp=10},
 milestoneXP={100,300,600,1000},receiptLimit=256,maxCoins=1000000000,provisional=true}
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">EditableAppearance</string>
          <ProtectedString name="Source">-- Optional client-side consolidation of the same authored surfaces into MeshParts.
-- EditableMesh permissions vary by experience. The portable geometry remains on failure.
local Assets=game:GetService("AssetService")
local Data=require(script.Parent.CharacterVisualData)
local Visuals=require(script.Parent.CharacterVisuals)
local Renderer={}
local cache={};local waiting={};local disabled=false
local function vector(v)return Vector3.new(v[1],v[2],v[3])end
local function template(id,index,spec)
 local key=id..":"..index
 if cache[key] then return cache[key] end
 if disabled or waiting[key] then return nil end
 waiting[key]=true
 local editable
 local ok,result=pcall(function()
  editable=Assets:CreateEditableMesh();assert(editable,"Presupuesto de malla no disponible")
  local lo=Vector3.new(math.huge,math.huge,math.huge);local hi=-lo
  for _,v in ipairs(spec.vertices) do
   local p=vector(v);lo=Vector3.new(math.min(lo.X,p.X),math.min(lo.Y,p.Y),math.min(lo.Z,p.Z));hi=Vector3.new(math.max(hi.X,p.X),math.max(hi.Y,p.Y),math.max(hi.Z,p.Z))
  end
  local center=(lo+hi)/2;local ids={}
  for i,v in ipairs(spec.vertices) do ids[i]=editable:AddVertex(vector(v)-center) end
  for _,face in ipairs(spec.faces) do editable:AddTriangle(ids[face[1]+1],ids[face[2]+1],ids[face[3]+1]) end
  local part=Assets:CreateMeshPartAsync(Content.fromObject(editable),{CollisionFidelity=Enum.CollisionFidelity.Box})
  part.Size=Vector3.new(math.max(.012,hi.X-lo.X),math.max(.012,hi.Y-lo.Y),math.max(.012,hi.Z-lo.Z))
  part.Name=spec.name.."_Mesh";part.Color=Color3.fromRGB(spec.color[1],spec.color[2],spec.color[3]);part.Material=Enum.Material[spec.material]
  part.CanCollide=false;part.CanTouch=false;part.CanQuery=false;part.Massless=true;part.DoubleSided=true
  return {part=part,center=center,editable=editable}
 end)
 waiting[key]=nil
 if not ok then
  if editable then editable:Destroy() end
  disabled=true;warn("FORGOTTEN V3: se conserva la geometría portátil; EditableMesh no está disponible en esta experiencia.")
  return nil
 end
 cache[key]=result;return result
end
function Renderer.apply(model)
 if disabled or (model:GetAttribute("VisualVersion") or 0)&lt;3 or model:FindFirstChild("ClientVisualMeshes") then return end
 local id=model:GetAttribute("CharacterIdentity");local source=Data[id]
 local original=model:FindFirstChild("ForgottenAppearance")
 if not source or not original then return end
 local folder=Instance.new("Folder");folder.Name="ClientVisualMeshes";folder.Parent=model
 for index,spec in ipairs(source) do
  if spec.kind=="Mesh" then
   local group
   for _,candidate in ipairs(original:GetChildren()) do if candidate:GetAttribute("VisualSpecIndex")==index then group=candidate;break end end
   local anchor=Visuals.anchor(model,spec.anchor,spec.name)
   if group and anchor then
    local built=template(id,index,spec)
    if built and model.Parent and folder.Parent and group.Parent then
     local part=built.part:Clone();part.CFrame=anchor.CFrame*CFrame.new(built.center)
     part:SetAttribute("WeaponKind",group:GetAttribute("WeaponKind"));part.Parent=folder
     local weld=Instance.new("WeldConstraint");weld.Part0=anchor;weld.Part1=part;weld.Parent=part
     for _,piece in ipairs(group:GetChildren()) do if piece:IsA("BasePart") then piece:SetAttribute("MeshReplaced",true);piece.LocalTransparencyModifier=1 end end
    end
   end
  end
 end
end
function Renderer.start()
 local Collection=game:GetService("CollectionService")
 local function apply(model)task.defer(function()if model.Parent then Renderer.apply(model) end end)end
 Collection:GetInstanceAddedSignal("ForgottenAnimated"):Connect(apply)
 for _,model in ipairs(Collection:GetTagged("ForgottenAnimated")) do apply(model) end
end
return Renderer
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">FaceData</string>
          <ProtectedString name="Source">-- V4 original facial artwork shared with the renderer.
return {["yellowguy"]={{["name"]="Ojo",["position"]={0.35,0.43},["size"]={0.13,0.095},["color"]={234,229,206},["rotation"]=0},{["name"]="Pupila",["position"]={0.40499999999999997,0.43},["size"]={0.035,0.085},["color"]={51,40,26},["rotation"]=0},{["name"]="Ceja",["position"]={0.32999999999999996,0.36},["size"]={0.15,0.032},["color"]={83,55,21},["rotation"]=-12},{["name"]="Párpado",["position"]={0.35,0.425},["size"]={0.13,0.015},["color"]={83,55,21},["rotation"]=-4},{["name"]="Ojo",["position"]={0.55,0.43},["size"]={0.13,0.095},["color"]={234,229,206},["rotation"]=0},{["name"]="Pupila",["position"]={0.6050000000000001,0.43},["size"]={0.035,0.085},["color"]={51,40,26},["rotation"]=0},{["name"]="Ceja",["position"]={0.53,0.36},["size"]={0.15,0.032},["color"]={83,55,21},["rotation"]=8},{["name"]="Párpado",["position"]={0.55,0.425},["size"]={0.13,0.015},["color"]={83,55,21},["rotation"]=3},{["name"]="Boca",["position"]={0.43,0.71},["size"]={0.18,0.018},["color"]={83,55,21},["rotation"]=-5}}}
</ProtectedString>
