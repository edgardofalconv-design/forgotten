      <Item class="ModuleScript">
        <Properties>
          <string name="Name">RigProportions</string>
          <ProtectedString name="Source">-- Applies only to the project's own generated R6 avatars, never installed rigs.
local Profiles=require(script.Parent.RigProfileData)
local Proportions={}
function Proportions.apply(model,id)
 local profile=Profiles[id];local h=model:FindFirstChildOfClass("Humanoid")
 local torso=model:FindFirstChild("Torso")
 if not profile or not h or h.RigType~=Enum.HumanoidRigType.R6 or not torso then return end
 local function vec(a)return Vector3.new(a[1],a[2],a[3])end
 torso.Size=vec(profile.torso)
 for _,side in ipairs({-1,1}) do
  local prefix=side&lt;0 and "Left" or "Right"
  local arm=model:FindFirstChild(prefix.." Arm");local leg=model:FindFirstChild(prefix.." Leg")
  if arm then arm.Size=vec(profile.arm);arm.CFrame=torso.CFrame*CFrame.new(side*profile.armX,0,0) end
  if leg then leg.Size=vec(profile.leg);leg.CFrame=torso.CFrame*CFrame.new(side*profile.legX,-2,0) end
  local shoulder=torso:FindFirstChild(prefix.." Shoulder")
  if shoulder then
   shoulder.C0=CFrame.new(side*profile.torso[1]/2,.5,0)*shoulder.C0.Rotation
   shoulder.C1=CFrame.new(-side*profile.arm[1]/2,.5,0)*shoulder.C1.Rotation
  end
  local hip=torso:FindFirstChild(prefix.." Hip")
  if hip then hip.C0=CFrame.new(side*profile.legX,-1,0)*hip.C0.Rotation end
 end
 model:SetAttribute("RigProportionsVersion",4)
end
return Proportions
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
        <Properties>
          <string name="Name">RoleAssignment</string>
          <ProtectedString name="Source">-- Inputs are plain records; server supplies the real connected players.
local Assignment = {}
function Assignment.assign(candidates,roster)
 if #candidates&lt;2 then return nil end
 local byId={}
 for _,entry in ipairs(roster) do byId[entry.id]=entry end
 local pool={}
 for _,candidate in ipairs(candidates) do
  local choice=byId[candidate.choice]
  if choice and choice.role=="Asesino" then table.insert(pool,candidate) end
 end
 if #pool==0 then for _,candidate in ipairs(candidates) do table.insert(pool,candidate) end end
 table.sort(pool,function(a,b)
  if (a.lastKiller or 0)==(b.lastKiller or 0) then return a.key&lt;b.key end
  return (a.lastKiller or 0)&lt;(b.lastKiller or 0)
 end)
 local killer=pool[1]
 local result={}
 for _,candidate in ipairs(candidates) do
  local chosen=byId[candidate.choice]
  local id
  if candidate==killer then id=chosen and chosen.role=="Asesino" and chosen.id or "guest666"
  else id=chosen and chosen.role=="Superviviente" and chosen.id or "pelotocino" end
  table.insert(result,{key=candidate.key,id=id})
 end
 return result,killer.key
end
return Assignment
</ProtectedString>
        </Properties>
      </Item>
      <Item class="ModuleScript">
